    const container = systemsGridRef.current;
    const elA = cardElementRefs.current[flowPairIds[0]];
    const elB = cardElementRefs.current[flowPairIds[1]];
    if (!container || !elA || !elB) {
      setFlowSvgCoords(null);
      return;
