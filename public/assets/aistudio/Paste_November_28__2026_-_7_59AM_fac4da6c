// Component hiển thị Icon tương ứng theo tên
const SystemIcon = ({ iconName, className = 'w-4 h-4', style }) => {
  const props = { className, style };
  switch (iconName) {
    case 'globe':
      return <Globe {...props} />;
    case 'chart':
      return <DollarSign {...props} />;
    case 'users':
      return <Users {...props} />;
    case 'briefcase':
      return <Briefcase {...props} />;
    case 'file-text':
      return <FileText {...props} />;
    case 'target':
      return <Target {...props} />;
    case 'gift':
      return <Gift {...props} />;
    case 'graduation':
      return <GraduationCap {...props} />;
    case 'headphones':
      return <Headphones {...props} />;
    case 'trending':
      return <TrendingUp {...props} />;
    case 'robot':
      return <Cpu {...props} />;
    case 'shopping-cart':
      return <ShoppingCart {...props} />;
    default:
      return <Globe {...props} />;
  }
};

