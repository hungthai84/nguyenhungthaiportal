            <p
              className="font-handwriting font-italianno not-italic text-yellow-300 text-2xl sm:text-3xl font-bold drop-shadow-[0_2px_8px_rgba(0,0,0,0.95)] mt-1.5 select-none"
              style={{ color: '#facc15', fontFamily: "'Italianno', cursive, sans-serif" }}
