  }
  .library:when(--sel == 8) .case:nth-child(9) .out::before {
    animation: glint 4.8s cubic-bezier(0.45, 0.05, 0.35, 1) -1.4s infinite;
  }
  .library:when(--sel == 9) .case:nth-child(10) .out::before {
    animation: glint 4.8s cubic-bezier(0.45, 0.05, 0.35, 1) -1.4s infinite;
  }
  .library:when(--sel == 10) .case:nth-child(11) .out::before {
    animation: glint 4.8s cubic-bezier(0.45, 0.05, 0.35, 1) -1.4s infinite;
  }
  .library:when(--sel == 11) .case:nth-child(12) .out::before {
    animation: glint 4.8s cubic-bezier(0.45, 0.05, 0.35, 1) -1.4s infinite;
  }
}
@media (prefers-reduced-motion: reduce) {
  .v2 .out::before {
    animation: none !important;
  }
}

