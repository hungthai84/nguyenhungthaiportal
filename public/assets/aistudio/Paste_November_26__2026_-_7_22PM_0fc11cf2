/**
 * Ứng dụng chính: Cổ Thư Tử Vi Đẩu Số đọc MP3 & đồng bộ nội dung từng trang chữ Play rõ nét
 */
export default function App() {
  const [themeMode, setThemeMode] = useState('dark');
  const [spread, setSpread] = useState(0);
  const [isPeekingOrTurning, setIsPeekingOrTurning] = useState(false);
  const [activeModal, setActiveModal] = useState(null);
  const [scale, setScale] = useState(1);

  // Trạng thái đọc & phân tích file MP3
  const [mp3Duration, setMp3Duration] = useState(MP3_TOTAL_SECONDS);
  const [mp3CurrentTime, setMp3CurrentTime] = useState(0);
  const [isMp3Playing, setIsMp3Playing] = useState(false);
  const [mp3WaveformBars, setMp3WaveformBars] = useState([
    35, 62, 48, 80, 70, 42, 88, 65, 52, 92, 76, 58, 84, 68, 45, 74, 60, 40,
  ]);
  const [autoSyncPages, setAutoSyncPages] = useState(true);

  const audioCtxRef = useRef(null);
  const bookAudioRef = useRef(null);
  const pageFlipRef = useRef(null);
  const openDelayTimerRef = useRef(null);
  const isSeekingFromFlipRef = useRef(false);
  const prevSpreadRef = useRef(0);

  const isBookOpen = spread > 0;

  // Định dạng thời gian mm:ss
  const formatTime = (sec) => {
    if (!Number.isFinite(sec) || sec < 0) return '00:00';
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60);
    return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  };

  // Đọc & giải mã biên độ sóng âm thực tế từ tệp MP3 bằng Web Audio API
  useEffect(() => {
    let cancelled = false;
    async function analyzeMp3File() {
      try {
        const response = await fetch(BOOK_OPEN_SOUND_URL);
        if (!response.ok) return;
        const arrayBuffer = await response.arrayBuffer();
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (!AudioContextClass) return;
        const tempCtx = new AudioContextClass();
        const audioBuffer = await tempCtx.decodeAudioData(arrayBuffer);
        if (cancelled) {
          tempCtx.close();
          return;
        }
        setMp3Duration(audioBuffer.duration);

        // Trích xuất 18 cột năng lượng âm thanh tương ứng với tiến trình 3 hồi của sách
        const channelData = audioBuffer.getChannelData(0);
        const barCount = 18;
        const blockSize = Math.floor(channelData.length / barCount);
        const bars = [];
        for (let i = 0; i < barCount; i++) {
          let sum = 0;
          const start = i * blockSize;
          for (let j = 0; j < blockSize; j += 16) {
            sum += Math.abs(channelData[start + j] || 0);
          }
          const avg = sum / Math.max(1, blockSize / 16);
          bars.push(Math.min(100, Math.max(22, Math.round(avg * 360))));
        }
        setMp3WaveformBars(bars);
        tempCtx.close();
      } catch {
        // Fallback tự động qua sự kiện loadedmetadata của thẻ <audio>
      }
    }
    analyzeMp3File();
    return () => {
      cancelled = true;
    };
  }, []);
  // Tự động co giãn sân khấu 1140x780 cho mọi kích thước màn hình (cả ngang lẫn dọc)
  useEffect(() => {
    const updateScale = () => {
      const baseWidth = 1140;
      const baseHeight = 780;
      const availableWidth = window.innerWidth - 24;
      const availableHeight = window.innerHeight - 135;
      const scaleW = availableWidth / baseWidth;
      const scaleH = availableHeight / baseHeight;
      const nextScale = Math.min(1, scaleW, scaleH);
      setScale(Math.max(0.32, nextScale));
    };
    updateScale();
    window.addEventListener('resize', updateScale);
    return () => window.removeEventListener('resize', updateScale);
  }, []);

  // Âm thanh chuông ngũ cung dự phòng nếu trình duyệt chưa tải xong MP3
  const playZenChime = useCallback(() => {
    try {
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) return;
      if (!audioCtxRef.current) {
        audioCtxRef.current = new AudioContextClass();
      }
      const ctx = audioCtxRef.current;
      if (ctx.state === 'suspended') ctx.resume();

      const now = ctx.currentTime;
      const pentatonic = [261.63, 293.66, 329.63, 392.0, 440.0, 523.25];
      const freq = pentatonic[Math.floor(Math.random() * pentatonic.length)];
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, now);
      gain.gain.setValueAtTime(0.001, now);
      gain.gain.exponentialRampToValueAtTime(0.1, now + 0.04);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 1.8);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 1.9);
    } catch {
      // Bỏ qua nếu bị chặn audio context
    }
  }, []);

  // Phát âm thanh MP3 từ đầu hoặc từ một mốc giây chỉ định
  const playBookOpenSound = useCallback(
    (seekSeconds) => {
      const audio = bookAudioRef.current;
      if (!audio) return;
      try {
        const effectiveDuration =
          Number.isFinite(audio.duration) && audio.duration > 0
            ? audio.duration
            : MP3_TOTAL_SECONDS;

        if (typeof seekSeconds === 'number' && seekSeconds >= 0) {
          isSeekingFromFlipRef.current = true;
          const clampedTime = Math.max(
            0,
            Math.min(effectiveDuration - 0.05, seekSeconds)
          );
          audio.currentTime = clampedTime;
          setMp3CurrentTime(clampedTime);
          setTimeout(() => {
            isSeekingFromFlipRef.current = false;
          }, 350);
        } else if (audio.currentTime >= effectiveDuration - 0.15) {
          audio.currentTime = 0;
          setMp3CurrentTime(0);
        }

        const playPromise = audio.play();
        if (playPromise && typeof playPromise.then === 'function') {
          playPromise
            .then(() => setIsMp3Playing(true))
            .catch(() => {
              playZenChime();
            });
        } else {
          setIsMp3Playing(true);
        }
      } catch {
        playZenChime();
      }
    },
    [playZenChime]
  );

  // Dừng âm thanh MP3 và hủy hẹn giờ trễ 3s khi gập sách lại
  const stopBookSound = useCallback(() => {
    if (openDelayTimerRef.current) {
      clearTimeout(openDelayTimerRef.current);
      openDelayTimerRef.current = null;
    }
    const audio = bookAudioRef.current;
    if (!audio) return;
    audio.pause();
    audio.currentTime = 0;
    setMp3CurrentTime(0);
    setIsMp3Playing(false);
  }, []);

  // Xóa hẹn giờ nếu component bị unmount
  useEffect(() => {
    return () => {
      if (openDelayTimerRef.current) {
        clearTimeout(openDelayTimerRef.current);
      }
    };
