<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f4f6fb" />
  <title>Chân dung phong cách làm việc | Nguyễn Hùng Thái</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Play:wght@400;700&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    :root {
      --ink: #161c33;
      --muted: #5e6884;
      --paper: #f0f3fa;
      --white: #ffffff;
      --line: rgba(226, 233, 246, 0.85);
      --yellow: #ffc917;
      --orange: #f2722b;
      --pink: #eb4472;
      --rose: #dc3e97;
      --purple: #6a4ff5;
      --blue: #1283e0;
      --sky: #26b9f2;
      --mint: #35c4a7;
      --green: #29b27a;
      --navy: #192044;
      --glass-border: rgba(255, 255, 255, 0.85);
      --glass-shadow: 0 16px 40px rgba(27, 36, 75, 0.07), 0 2px 6px rgba(27, 36, 75, 0.03);
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      min-height: 100%;
      font-family: 'Play', Arial, sans-serif;
      background: var(--paper);
      color: var(--ink);
    }
    body {
      overflow: hidden;
      background: 
        radial-gradient(circle at 12% 16%, rgba(106, 79, 245, 0.16) 0%, transparent 45%),
        radial-gradient(circle at 86% 18%, rgba(38, 185, 242, 0.16) 0%, transparent 42%),
        radial-gradient(circle at 50% 50%, rgba(235, 68, 114, 0.1) 0%, transparent 55%),
        radial-gradient(circle at 82% 86%, rgba(53, 196, 167, 0.15) 0%, transparent 45%),
        radial-gradient(circle at 14% 88%, rgba(255, 201, 23, 0.14) 0%, transparent 45%),
        #f2f5fc;
      background-attachment: fixed;
    }
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background: 
        radial-gradient(650px circle at 75% 25%, rgba(106, 79, 245, 0.05), transparent 70%),
        radial-gradient(600px circle at 20% 75%, rgba(18, 131, 224, 0.05), transparent 70%);
      z-index: 0;
    }
    button { font: inherit; }
    .app {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 14px 22px 12px;
      gap: 12px;
      position: relative;
      z-index: 1;
    }
    .topbar {
      width: min(1250px, 100%);
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      min-height: 42px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 700;
      letter-spacing: .2px;
    }
    .brand-mark {
      width: 36px;
      height: 36px;
      border-radius: 12px;
      background: linear-gradient(135deg, #1888e6 0%, #684bf2 50%, #dc3e97 100%);
      display: grid;
      place-items: center;
      color: #fff;
      font-size: 15px;
      box-shadow: 0 8px 18px rgba(104, 75, 242, 0.3), inset 0 1px 1px rgba(255, 255, 255, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.4);
    }
    .brand small {
      display: block;
      color: var(--muted);
      font-size: 9.5px;
      font-weight: 400;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      margin-top: 2px;
    }
    .top-meta {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--muted);
      font-size: 12px;
    }
    .meta-pill {
      padding: 6px 13px;
      background: rgba(255, 255, 255, 0.65);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid var(--glass-border);
      border-radius: 999px;
      box-shadow: 0 4px 12px rgba(27, 36, 75, 0.04), inset 0 1px 1px #fff;
      font-weight: 700;
      letter-spacing: .4px;
      font-size: 11px;
    }
    .deck {
      width: min(1250px, 100%);
      margin: 0 auto;
      flex: 1;
      min-height: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .stage {
      width: 100%;
      max-width: 1250px;
      height: min(min(calc(100vh - 138px), 800px), calc((100vw - 44px) * .57));
      min-height: 520px;
      max-height: 800px;
      background: rgba(255, 255, 255, 0.62);
      backdrop-filter: blur(28px) saturate(180%);
      -webkit-backdrop-filter: blur(28px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.88);
      border-radius: 26px;
      box-shadow: var(--glass-shadow), inset 0 1px 2px rgba(255, 255, 255, 0.9);
      position: relative;
      overflow: hidden;
    }
    .slide {
      position: absolute;
      inset: 0;
      padding: clamp(18px, 2.6vw, 32px);
      display: flex;
      flex-direction: column;
      gap: 12px;
      opacity: 0;
      visibility: hidden;
      transform: translateX(36px) scale(.99);
      transition: opacity .38s ease, transform .38s ease, visibility .38s;
      overflow-y: auto;
      background: transparent;
    }
    .slide.active {
      opacity: 1;
      visibility: visible;
      transform: translateX(0) scale(1);
      z-index: 2;
    }
    .slide.prev {
      transform: translateX(-36px) scale(.99);
    }
    .slide:before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      height: 5px;
      background: linear-gradient(90deg, #ffc917, #f2722b, #eb4472, #6a4ff5, #1283e0, #26b9f2, #35c4a7);
      box-shadow: 0 2px 10px rgba(106, 79, 245, 0.3);
    }
    .slide-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 18px;
      position: relative;
      z-index: 1;
    }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 10.5px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #1283e0;
      font-weight: 700;
      margin-bottom: 5px;
      padding: 3px 9px;
      border-radius: 6px;
      background: rgba(18, 131, 224, 0.08);
      border: 1px solid rgba(18, 131, 224, 0.16);
    }
    h1, h2, h3, p { margin: 0; }
    h1 {
      font-size: clamp(30px, 3.8vw, 48px);
      line-height: 1.05;
      letter-spacing: -1.4px;
    }
    h2 {
      font-size: clamp(21px, 2.3vw, 29px);
      line-height: 1.15;
      letter-spacing: -.5px;
    }
    h3 {
      font-size: 15px;
      line-height: 1.25;
    }
    .subtitle {
      color: var(--muted);
      font-size: clamp(11.5px, 1.15vw, 14px);
      line-height: 1.45;
      max-width: 820px;
      margin-top: 3px;
    }
    .slide-no {
      font-size: 11px;
      font-weight: 700;
      color: #8c95ae;
      letter-spacing: 1px;
      white-space: nowrap;
      padding: 5px 12px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.7);
      border: 1px solid var(--glass-border);
      backdrop-filter: blur(10px);
    }
    .section-label {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: var(--muted);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.1px;
      text-transform: uppercase;
    }
    .section-label:before {
      content: "";
      width: 15px;
      height: 3px;
      border-radius: 4px;
      background: linear-gradient(90deg, #eb4472, #6a4ff5);
    }

    /* Lucide icon helper styles */
    .lucide-icon, [data-lucide] {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      vertical-align: middle;
      flex-shrink: 0;
    }
    .card-title-wrap {
      display: inline-flex;
      align-items: center;
      gap: 7px;
    }

    /* Bento Responsive Grid */
    .bento-grid {
      display: grid;
      gap: 11px;
      flex: 1;
      min-height: 0;
      width: 100%;
    }
    .bento-hero {
      grid-template-columns: 1.35fr .65fr;
      align-items: stretch;
    }
    .bento-col-5 {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .bento-slide1-layout {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 12px;
      flex: 1;
      min-height: 0;
    }
    .bento-traits-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 10px;
    }

    /* Bento Card Base & Tones */
    .bento-card {
      border-radius: 14px;
      padding: 14px 16px;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.85);
      box-shadow: 0 8px 24px rgba(27, 36, 75, 0.04), inset 0 1px 1px rgba(255, 255, 255, 0.95);
      transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
    }
    .bento-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(27, 36, 75, 0.08), inset 0 1px 1px #fff;
    }

    .tone-blue {
      background: linear-gradient(145deg, rgba(220, 240, 255, 0.95) 0%, rgba(235, 246, 255, 0.8) 100%);
      border-color: rgba(160, 210, 255, 0.9);
    }
    .tone-purple {
      background: linear-gradient(145deg, rgba(238, 232, 255, 0.95) 0%, rgba(246, 242, 255, 0.8) 100%);
      border-color: rgba(205, 190, 255, 0.9);
    }
    .tone-pink {
      background: linear-gradient(145deg, rgba(255, 232, 240, 0.95) 0%, rgba(255, 245, 248, 0.8) 100%);
      border-color: rgba(252, 190, 210, 0.9);
    }
    .tone-yellow {
      background: linear-gradient(145deg, rgba(255, 245, 215, 0.95) 0%, rgba(255, 250, 230, 0.8) 100%);
      border-color: rgba(248, 220, 130, 0.9);
    }
    .tone-mint {
      background: linear-gradient(145deg, rgba(220, 250, 240, 0.95) 0%, rgba(238, 253, 247, 0.8) 100%);
      border-color: rgba(160, 232, 210, 0.9);
    }
    .tone-orange {
      background: linear-gradient(145deg, rgba(255, 235, 220, 0.95) 0%, rgba(255, 245, 238, 0.8) 100%);
      border-color: rgba(250, 200, 160, 0.9);
    }
    .tone-dark {
      background: linear-gradient(145deg, #192044 0%, #2f386c 100%);
      color: #fff;
      border-color: rgba(255, 255, 255, 0.16);
      box-shadow: 0 14px 34px rgba(25, 32, 68, 0.22);
    }

    .card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 7px;
    }
    .card-icon {
      width: 32px;
      height: 32px;
      display: grid;
      place-items: center;
      border-radius: 9px;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(6px);
      font-size: 13px;
      font-weight: 700;
      border: 1px solid rgba(255, 255, 255, 0.95);
      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.04);
      flex: none;
    }
    .tag {
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: .5px;
      text-transform: uppercase;
      padding: 4px 8px;
      border-radius: 7px;
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid rgba(255, 255, 255, 0.9);
      white-space: nowrap;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    }
    .bento-card p, .bento-card li {
      font-size: 11.5px;
      line-height: 1.48;
      color: #555d75;
    }
    .tone-dark p, .tone-dark li {
      color: #d8e0fa;
    }
    .bento-card p strong, .bento-card li strong {
      color: var(--ink);
    }
    .tone-dark p strong {
      color: #fff;
    }
    .bento-card h3 {
      margin: 2px 0 5px;
    }

    .profile-initial {
      width: 60px;
      height: 60px;
      border-radius: 18px;
      background: linear-gradient(145deg, #1283e0 0%, #6a4ff5 60%, #dc3e97 100%);
      color: #fff;
      display: grid;
      place-items: center;
      font-size: 24px;
      font-weight: 700;
      box-shadow: 0 10px 20px rgba(106, 79, 245, 0.35);
      border: 1px solid rgba(255, 255, 255, 0.4);
      position: relative;
      z-index: 1;
    }
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 7px;
      margin-top: 10px;
    }
    .hero-stat {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.95);
      border-radius: 11px;
      padding: 7px 6px;
      text-align: center;
    }
    .hero-stat b {
      display: block;
      font-size: 17px;
      color: var(--navy);
    }
    .hero-stat span {
      font-size: 8.5px;
      color: var(--muted);
      display: block;
      margin-top: 2px;
    }
    .pill-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 10px;
    }
    .pill {
      padding: 5px 9px;
      border-radius: 7px;
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(8px);
      border: 1px solid var(--glass-border);
      color: #495475;
      font-size: 9.5px;
      font-weight: 700;
    }

    .profile-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 7px;
      margin: 8px 0;
    }
    .profile-item {
      background: rgba(255, 255, 255, 0.85);
      border: 1px solid rgba(226, 234, 246, 0.9);
      border-radius: 10px;
      padding: 7px 9px;
    }
    .profile-item span {
      display: block;
      font-size: 8.5px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: .7px;
    }
    .profile-item b {
      display: block;
      font-size: 11.5px;
      margin-top: 2px;
    }

    .quote-box {
      font-size: clamp(14px, 1.5vw, 18px);
      line-height: 1.4;
      font-weight: 400;
      position: relative;
      z-index: 1;
    }
    .quote-box::before {
      content: "“";
      font-size: 50px;
      line-height: 0;
      display: block;
      margin-bottom: 12px;
      color: rgba(255, 255, 255, 0.25);
    }

    .micro-tag {
      font-size: 8.5px;
      padding: 4px 7px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.9);
      color: #555e78;
      border: 1px solid rgba(231, 234, 242, 0.85);
      font-weight: 700;
      display: inline-block;
    }

    .element-symbol {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .element-bar {
      height: 4px;
      border-radius: 8px;
      margin-top: auto;
      background: rgba(229, 233, 241, 0.7);
      overflow: hidden;
    }
    .element-bar span {
      display: block;
      height: 100%;
      border-radius: 6px;
      width: 100%;
    }

    .footnote {
      font-size: 9.5px;
      color: #848c9f;
      line-height: 1.35;
    }

    /* Controls Bar */
    .controls {
      width: min(1250px, 100%);
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      min-height: 40px;
    }
    .progress-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
      flex: 1;
      max-width: 510px;
    }
    .progress-track {
      height: 6px;
      border-radius: 10px;
      background: rgba(227, 231, 240, 0.7);
      backdrop-filter: blur(8px);
      overflow: hidden;
      flex: 1;
      border: 1px solid rgba(255, 255, 255, 0.6);
    }
    .progress-fill {
      height: 100%;
      width: 25%;
      background: linear-gradient(90deg, #6a4ff5, #1283e0, #35c4a7);
      border-radius: 8px;
      transition: width .3s ease;
    }
    .progress-text {
      font-size: 11px;
      color: var(--muted);
      white-space: nowrap;
      font-weight: 700;
    }
    .dots {
      display: flex;
      gap: 6px;
      align-items: center;
    }
    .dot {
      width: 7px;
      height: 7px;
      border: 0;
      border-radius: 99px;
      background: rgba(195, 203, 222, 0.7);
      padding: 0;
      cursor: pointer;
      transition: all .25s ease;
    }
    .dot.active {
      width: 22px;
      background: linear-gradient(90deg, #6a4ff5, #1283e0);
    }
    .nav-actions {
      display: flex;
      gap: 8px;
    }
    .nav-btn {
      border: 1px solid var(--glass-border);
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(10px);
      color: var(--navy);
      border-radius: 11px;
      padding: 8px 14px;
      cursor: pointer;
      font-size: 11px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 7px;
      box-shadow: 0 4px 12px rgba(27, 36, 75, 0.04);
      transition: all .2s ease;
    }
    .nav-btn:hover {
      transform: translateY(-1px);
      background: #fff;
      box-shadow: 0 6px 16px rgba(27, 36, 75, 0.08);
    }
    .nav-btn.primary {
      background: linear-gradient(135deg, #192044 0%, #323d77 100%);
      color: #fff;
      border-color: rgba(255, 255, 255, 0.25);
    }
    .nav-btn:disabled {
      opacity: .35;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }
    .keyboard-hint {
      font-size: 9.5px;
      color: #929bb0;
    }

    /* Zodiac Tool Layout */
    .zodiac-layout {
      display: grid;
      grid-template-columns: 1.05fr .95fr;
      gap: 12px;
      flex: 1;
      min-height: 0;
    }
    .zodiac-picker {
      display: flex;
      flex-direction: column;
      gap: 9px;
      overflow-y: auto;
    }
    .year-form {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 8px;
      align-items: end;
    }
    .year-field label {
      display: block;
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: .7px;
      text-transform: uppercase;
      color: #5d6783;
      margin-bottom: 5px;
    }
    .year-field input {
      width: 100%;
      height: 38px;
      border: 1px solid rgba(223, 229, 239, 0.85);
      border-radius: 10px;
      padding: 0 12px;
      background: rgba(255, 255, 255, 0.88);
      color: var(--ink);
      font: 700 14px 'Play', Arial, sans-serif;
      outline: none;
    }
    .year-field input:focus {
      border-color: #6a4ff5;
      background: #fff;
      box-shadow: 0 0 0 3px rgba(106, 79, 245, 0.15);
    }
    .search-btn {
      height: 38px;
      border: 0;
      border-radius: 10px;
      padding: 0 15px;
      background: linear-gradient(135deg, #1283e0 0%, #6a4ff5 100%);
      color: #fff;
      font: 700 11.5px 'Play', Arial, sans-serif;
      cursor: pointer;
      box-shadow: 0 5px 14px rgba(106, 79, 245, 0.28);
    }
    .quick-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }
    .quick-chip {
      padding: 4px 8px;
      font-size: 9.5px;
      font-weight: 700;
      border-radius: 7px;
      border: 1px solid var(--glass-border);
      background: rgba(255, 255, 255, 0.8);
      color: var(--navy);
      cursor: pointer;
    }
    .quick-chip:hover {
      background: #fff;
      border-color: #1283e0;
      color: #1283e0;
    }
    .zodiac-grid {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 6px;
    }
    .zodiac-option {
      min-width: 0;
      min-height: 58px;
      border: 1px solid rgba(229, 233, 242, 0.85);
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.75);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      cursor: pointer;
      color: #565e77;
      padding: 4px 2px;
      transition: all .18s;
    }
    .zodiac-option:hover {
      transform: translateY(-2px);
      border-color: #6a4ff5;
      background: #fff;
    }
    .zodiac-option[aria-pressed="true"] {
      background: linear-gradient(145deg, #f1edff 0%, #faf8ff 100%);
      border: 2px solid #6a4ff5;
      color: #4936b8;
    }
    .zodiac-emoji { font-size: 18px; line-height: 1.1; }
    .zodiac-name { font-size: 9.5px; font-weight: 700; }
    .zodiac-result {
      display: flex;
      flex-direction: column;
      min-height: 0;
      background: linear-gradient(145deg, rgba(238, 247, 255, 0.85) 0%, rgba(246, 241, 255, 0.85) 55%, rgba(255, 243, 247, 0.9) 100%);
      border: 1px solid rgba(255, 255, 255, 0.95);
      border-radius: 14px;
      padding: 16px;
      position: relative;
      overflow-y: auto;
    }
    .result-animal {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: #fff;
      font-size: 26px;
      flex: none;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
    }
    .result-main {
      display: flex;
