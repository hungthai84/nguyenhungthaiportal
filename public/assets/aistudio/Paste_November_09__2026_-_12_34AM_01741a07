    function openDetail(card) {      if (isAnimating || activeDetail) return;      isAnimating = true;      activeCard = card;      const data = services[card.dataset.id];      const start = rectWithinGrid(card);      const detail = document.createElement('article');      detail.className = 'service-detail is-morphing';      detail.style.setProperty('--detail-accent', data.accent);      detail.style.setProperty('--detail-soft', data.soft);      setOverlayGeometry(detail, start);      detail.innerHTML = detailMarkup(data);      bindImageFallback(detail);      grid.appendChild(detail);      activeDetail = detail;      grid.classList.add('is-expanded');      grid.querySelectorAll('.service-card').forEach(item => {        item.style.opacity = '0';        item.style.pointerEvents = 'none';      });      requestAnimationFrame(() => requestAnimationFrame(() => {        detail.style.left = '0px';        detail.style.top = '0px';        detail.style.width = `${grid.clientWidth}px`;        detail.style.height = `${grid.clientHeight}px`;        detail.style.borderRadius = '18px';      }));      const onExpanded = (event) => {        if (event.target !== detail || event.propertyName !== 'width') return;        detail.removeEventListener('transitionend', onExpanded);        detail.classList.remove('is-morphing');        detail.classList.add('content-visible');        isAnimating = false;      };      detail.addEventListener('transitionend', onExpanded);      // Fallback for reduced-motion / browsers that do not emit transitionend.      window.setTimeout(() => {        if (isAnimating && activeDetail === detail) { detail.classList.add('content-visible'); isAnimating = false; }      }, 900);      detail.querySelector('.close-button').addEventListener('click', closeDetail);      document.addEventListener('keydown', onEscape);    }
    function closeDetail() {      if (!activeDetail || isAnimating || !activeCard) return;      isAnimating = true;      const detail = activeDetail;      const end = rectWithinGrid(activeCard);      detail.classList.remove('content-visible');      detail.classList.add('is-morphing');      detail.style.left = `${end.left}px`;      detail.style.top = `${end.top}px`;      detail.style.width = `${end.width}px`;      detail.style.height = `${end.height}px`;      detail.style.borderRadius = '15px';      const finish = (event) => {        if (event.target !== detail || event.propertyName !== 'width') return;        detail.removeEventListener('transitionend', finish);        detail.remove();        activeDetail = null;        activeCard = null;        grid.classList.remove('is-expanded');        grid.querySelectorAll('.service-card').forEach(item => {          item.style.opacity = '';          item.style.pointerEvents = '';        });        isAnimating = false;        document.removeEventListener('keydown', onEscape);      };      detail.addEventListener('transitionend', finish);      window.setTimeout(() => {        if (activeDetail === detail) {          detail.remove(); activeDetail = null; activeCard = null;          grid.classList.remove('is-expanded');          grid.querySelectorAll('.service-card').forEach(item => { item.style.opacity = ''; item.style.pointerEvents = ''; });          isAnimating = false; document.removeEventListener('keydown', onEscape);        }      }, 900);    }    function onEscape(event) { if (event.key === 'Escape') closeDetail(); }    grid.querySelectorAll('.service-card').forEach(card => card.addEventListener('click', () => openDetail(card)));
    window.addEventListener('resize', () => {      if (activeDetail && !isAnimating) {        activeDetail.style.left = '0px'; activeDetail.style.top = '0px';        activeDetail.style.width = `${grid.clientWidth}px`; activeDetail.style.height = `${grid.clientHeight}px`;      }    });  </script></body></html>