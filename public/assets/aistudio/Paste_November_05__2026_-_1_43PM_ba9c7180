                const neonData = PAGE_NEON_COLORS[page.id] || { neon: page.color, glow: `${page.color}80` };
                const cardThemeColor = page.color;

                let itemBg = 'rgba(255, 255, 255, 0.88)';
                let itemBorder = 'rgba(255, 255, 255, 0.95)';
