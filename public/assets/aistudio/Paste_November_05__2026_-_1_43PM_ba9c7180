                                        <div class="p-2.5 rounded-xl bg-emerald-50 border border-emerald-200"><span class="text-[10px] text-emerald-700 font-bold block">Hướng Sinh Khí Bậc 1</span><strong class="text-xs text-slate-800">Tây Bắc (Thu hút cơ hội & danh tiếng)</strong></div>
                                        <div class="p-2.5 rounded-xl bg-amber-50 border border-amber-200"><span class="text-[10px] text-amber-700 font-bold block">Hướng Diên Niên Bậc 2</span><strong class="text-xs text-slate-800">Tây Nam (Hòa hợp & gắn kết bền lâu)</strong></div>
                                    </div>
                                </div>
                            ` : currentHoroscopeSlide === 4 ? `
                                <div>
                                    <h3 class="text-base font-black text-teal-800 mb-2 flex items-center gap-2"><i class="fa-solid fa-users"></i> Công Cụ Hợp Việc (12 Con Giáp)</h3>
                                    <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-2 my-2">
                                        ${ZODIAC_12_LIST.map((z, zIdx) => `
                                            <button onclick="selectedZodiacIdx=${zIdx}; updateView();" class="p-2 rounded-xl border text-left cursor-pointer transition ${selectedZodiacIdx === zIdx ? 'bg-teal-600 text-white border-teal-600 shadow-md scale-105' : 'bg-slate-50 hover:bg-teal-50 text-slate-800 border-slate-200'}">
                                                <span class="text-xs font-bold block">${z.name}</span>
                                                <span class="text-[9px] opacity-80 block truncate">${z.score.split(' ')[0]}</span>
                                            </button>
                                        `).join('')}
                                    </div>
                                    <div class="p-3 rounded-xl bg-teal-50 border border-teal-200 mt-2">
                                        <h4 class="text-xs font-bold text-teal-900">${ZODIAC_12_LIST[selectedZodiacIdx].name} · ${ZODIAC_12_LIST[selectedZodiacIdx].relation}</h4>
                                        <p class="text-xs text-slate-700 mt-1">${ZODIAC_12_LIST[selectedZodiacIdx].advice}</p>
                                    </div>
                                </div>
                            ` : `
                                <div>
                                    <h3 class="text-base font-black text-indigo-800 mb-2">Ưu Thế Vận Hành & Triết Lý Lãnh Đạo</h3>
                                    <p class="text-xs text-slate-700 leading-relaxed">Bản lĩnh kiên định mệnh Kim, trầm tĩnh trước áp lực, lấy sự hài lòng của khách hàng và tính minh bạch làm kim chỉ nam điều hành.</p>
                                </div>
                            `}
                        </div>
                    </div>
                `;
            } else if (currentTabIndex === 11) {
                // =========================================================================
                // TRANG KỶ NIỆM (currentTabIndex === 11 - MEMORIES VIEW)
                // =========================================================================
                contentContainer.innerHTML = `
                    <div class="w-full h-full flex flex-col justify-between p-3 sm:p-4 overflow-y-auto no-scrollbar font-play text-left animate-fadeIn gap-3">
                        <div class="w-full h-28 rounded-2xl bg-gradient-to-r from-emerald-800 via-teal-700 to-green-800 p-4 text-white flex flex-col justify-between shadow-md shrink-0">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-camera text-xl text-yellow-300"></i>
                                <h1 class="text-lg font-black font-play text-white">Khoảnh khắc kỷ niệm</h1>
                            </div>
                            <p class="font-quote text-2xl text-yellow-300">"Mỗi khoảnh khắc là một mảnh ghép tự hào của hành trình ♡"</p>
                        </div>

                        <!-- Lưới Ảnh Kỷ Niệm -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 flex-1 min-h-0">
                            ${MEMORIES_PHOTOS_LIST.map(item => `
                                <div class="rounded-2xl overflow-hidden bg-white border border-slate-200 shadow-sm flex flex-col justify-between group hover:shadow-lg transition">
                                    <div class="aspect-[4/3] w-full overflow-hidden bg-slate-900 relative">
                                        <img src="${item.img}" alt="${item.title}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                                        <span class="absolute top-2 left-2 px-2 py-0.5 rounded bg-black/70 text-white text-[10px] font-mono">${item.year}</span>
                                        <span class="absolute bottom-2 right-2 px-2 py-0.5 rounded bg-emerald-600 text-white text-[10px] font-bold">${item.tag}</span>
                                    </div>
                                    <div class="p-3">
                                        <h4 class="text-xs sm:text-sm font-bold text-slate-900 truncate">${item.title}</h4>
                                        <span class="text-[10px] text-slate-500 font-bold block mt-0.5">${item.company} • ${item.location}</span>
                                        <p class="text-[11px] text-slate-600 mt-1 line-clamp-2">${item.desc}</p>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
            } else if (currentTabIndex === 12) {
                // =========================================================================
                // TRANG LIÊN HỆ (currentTabIndex === 12 - CONTACT VIEW)
                // =========================================================================
                contentContainer.innerHTML = `
                    <div class="w-full h-full flex flex-col md:flex-row gap-3 p-3 sm:p-4 overflow-hidden font-play text-left animate-fadeIn">
                        <!-- Cột Trái: Banner Dọc Profile -->
                        <div class="w-full md:w-72 rounded-2xl bg-gradient-to-b from-indigo-950 via-slate-900 to-black text-white p-4 flex flex-col justify-between shrink-0 shadow-lg border border-indigo-500/30">
                            <div>
                                <div class="flex items-center gap-3 mb-3">
                                    <img src="https://res.cloudinary.com/q5tpzaxk/image/upload/v1793550449/Avata_H%C3%B9ng_Th%C3%A1i.gif" alt="Hùng Thái" class="w-14 h-14 rounded-full object-cover ring-2 ring-indigo-400">
                                    <div>
                                        <h3 class="text-base font-black text-white">Nguyễn Hùng Thái</h3>
                                        <p class="text-xs text-indigo-300">Cố Vấn & Giám Đốc CSKH</p>
                                    </div>
                                </div>
                                <div class="space-y-1.5 text-xs text-slate-300">
                                    <p><i class="fa-solid fa-envelope mr-1.5 text-sky-400"></i> hungthai84@gmail.com</p>
                                    <p><i class="fa-solid fa-phone mr-1.5 text-emerald-400"></i> 0903.011.699</p>
                                    <p><i class="fa-solid fa-location-dot mr-1.5 text-rose-400"></i> TP. Hồ Chí Minh (Hybrid)</p>
                                </div>
                            </div>
                            <div class="pt-3 border-t border-white/10 flex justify-between text-xs">
                                <span class="text-emerald-400 font-bold">Online 24/7</span>
                                <button onclick="showNotification('Đã sao chép Email: hungthai84@gmail.com')" class="text-cyan-300 underline">Sao chép Email</button>
                            </div>
                        </div>

                        <!-- Cột Phải: Form Liên Hệ & Đặt Lịch -->
                        <div class="flex-1 rounded-2xl bg-white/95 border border-slate-200 p-4 shadow-md flex flex-col justify-between gap-3 overflow-y-auto no-scrollbar">
                            <div class="flex items-center justify-between pb-2 border-b">
                                <h3 class="text-sm font-black text-indigo-900 flex items-center gap-2"><i class="fa-solid fa-envelope"></i> Gửi Tin Nhắn Trao Đổi Trực Tiếp</h3>
                                <span class="text-xs font-mono font-bold bg-indigo-100 text-indigo-800 px-2.5 py-0.5 rounded-full">Phản hồi &lt; 24h</span>
                            </div>
                            <form onsubmit="event.preventDefault(); showNotification('Cảm ơn bạn! Thông điệp đã được ghi nhận.');" class="space-y-2 flex-1 flex flex-col justify-between">
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                    <input type="text" placeholder="Họ và tên *" required class="px-3 py-1.5 text-xs rounded-xl border border-slate-300 focus:outline-none focus:border-indigo-500">
                                    <input type="email" placeholder="Email liên hệ *" required class="px-3 py-1.5 text-xs rounded-xl border border-slate-300 focus:outline-none focus:border-indigo-500">
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                    <input type="tel" placeholder="Số điện thoại / Zalo" class="px-3 py-1.5 text-xs rounded-xl border border-slate-300 focus:outline-none focus:border-indigo-500">
                                    <input type="text" placeholder="Tên công ty / Doanh nghiệp" class="px-3 py-1.5 text-xs rounded-xl border border-slate-300 focus:outline-none focus:border-indigo-500">
                                </div>
                                <textarea rows="3" placeholder="Nội dung cần trao đổi hoặc tư vấn chiến lược..." required class="w-full px-3 py-1.5 text-xs rounded-xl border border-slate-300 focus:outline-none focus:border-indigo-500 resize-none flex-1"></textarea>
                                <button type="submit" class="w-full py-2 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-black text-xs hover:brightness-110 transition shadow-md">Gửi Thông Điệp Ngay</button>
                            </form>
                        </div>
                    </div>
                `;
            } else if (currentTabIndex === 13) {
                // =========================================================================
                // TRANG HÌNH NỀN (currentTabIndex === 13 - WALLPAPER VIEW)
                // =========================================================================
                contentContainer.innerHTML = `
                    <div class="w-full h-full flex flex-col justify-between p-3 sm:p-4 overflow-y-auto no-scrollbar font-play text-left animate-fadeIn gap-3">
                        <div class="w-full h-28 rounded-2xl bg-gradient-to-r from-fuchsia-800 via-pink-700 to-indigo-900 p-4 text-white flex flex-col justify-between shadow-md shrink-0">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-image text-xl text-yellow-300"></i>
                                <h1 class="text-lg font-black font-play text-white">Không gian hình nền</h1>
                            </div>
                            <p class="font-quote text-2xl text-yellow-300">“Ánh sáng và sắc màu phản chiếu chiều sâu tâm hồn người kiến tạo.”</p>
                        </div>

                        <!-- Lưới Mẫu Hình Nền Sẵn Có -->
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 flex-1 min-h-0">
                            ${WALLPAPER_PRESETS_LIST.map(wp => `
                                <div onclick="applyWallpaperPreset('${wp.bg}', '${wp.name}')" class="p-2 rounded-2xl bg-white/90 border border-slate-200 shadow-sm flex flex-col justify-between cursor-pointer hover:scale-105 transition">
                                    <div class="w-full h-24 rounded-xl shadow-inner border border-black/10" style="background: ${wp.bg};"></div>
                                    <div class="pt-2 text-center">
                                        <span class="text-xs font-bold text-slate-800 block truncate">${wp.name}</span>
                                        <span class="text-[9px] text-slate-400 font-mono">Nhấp để áp dụng</span>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
            } else {
                // CÁC TRANG CÒN LẠI: Hiển thị trạng thái data: null
                const item = tabsData[currentTabIndex];
                contentContainer.innerHTML = `
                    <div class="p-6 h-full flex flex-col justify-center items-center text-center animate-fadeIn">
                        <div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-3 border text-2xl shadow-sm transition-all duration-300"
                             style="background: ${item.color}25; border-color: ${item.color}; color: ${item.color === '#FFDF25' ? '#ca8a04' : item.color};">
                            <i class="fa-solid ${item.icon}"></i>
                        </div>
                        <h1 class="text-h1 mb-2 tracking-tight text-slate-800">${item.id}. ${item.name}</h1>
                        <p class="font-quote text-indigo-600 mb-2 font-normal">"${item.quote}"</p>
                        <div class="card-body text-slate-500 max-w-md my-2 p-3 rounded-xl border border-slate-200/80 bg-white/60 backdrop-blur-xs flex items-center justify-center gap-2">
                            <i class="fa-solid fa-database text-slate-400"></i>
                            <span>Trạng thái dữ liệu trang: <strong class="font-mono text-indigo-600">${item.data === null ? 'null (Chưa có dữ liệu)' : 'Đã có dữ liệu'}</strong></span>
                        </div>
                        <p class="card-body text-slate-600 max-w-lg leading-relaxed mt-1">
                            Trang đang được khởi tạo cấu trúc sẵn sàng. Dữ liệu chi tiết cho mục <strong>${item.name}</strong> sẽ được nạp khi có yêu cầu.
                        </p>
                    </div>
                `;
            }

            // Cập nhật số trang chính xác 01/14 -> 14/14
            const counterEl = document.getElementById('footer-page-counter');
            if (counterEl) {
                counterEl.textContent = `${String(currentTabIndex + 1).padStart(2, '0')}/${String(tabsData.length).padStart(2, '0')}`;
            }
        }

        function toggleContactMenu(e) {
            e.stopPropagation();
            const menu = document.getElementById('circle-contact-menu');
            if (menu) menu.classList.toggle('is-open');
        }

        document.addEventListener('click', () => {
            const menu = document.getElementById('circle-contact-menu');
            if (menu) menu.classList.remove('is-open');
        });

        function showNotification(message) {
            const toast = document.getElementById('toast');
            if (!toast) return;
            toast.textContent = message;
            toast.style.opacity = '1';
            setTimeout(() => {
                toast.style.opacity = '0';
            }, 2500);
        }

        // Khởi tạo menu và view khi tải trang
        window.onload = function() {
            renderHeaderMenu();
            updateView();
        };
    </script>
</body>
</html>