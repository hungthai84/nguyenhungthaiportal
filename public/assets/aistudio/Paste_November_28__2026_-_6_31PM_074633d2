                setAiPromptInput('');
              }}
              className="flex flex-col sm:flex-row gap-2.5 mt-2"
            >
              <input
                type="text"
                value={aiPromptInput}
                onChange={(e) => setAiPromptInput(e.target.value)}
                placeholder="Nhập yêu cầu viết bài, tối ưu mã hoặc lên ý tưởng..."
                className="flex-1 bg-black/30 border border-white/15 rounded-xl px-4 py-2.5 text-sm text-white placeholder-purple-200/60 focus:outline-none focus:border-white/40"
              />
              <button
                type="submit"
                className="px-5 py-2.5 rounded-xl bg-white text-purple-950 hover:bg-purple-50 font-bold text-xs inline-flex items-center justify-center gap-2 shrink-0 cursor-pointer transition-colors"
              >
                <Send className="w-4 h-4" /> Gửi Yêu Cầu
              </button>
            </form>
          </BentoCard>

          {/* Thẻ 82 (2x1): Bảng Quản Lý Thành Viên Nhóm */}
          <BentoCard
            fxMode={currentFx.id}
            className="md:col-span-2 bg-gray-800/90 backdrop-blur-md bento-border flex flex-col justify-between"
          >
            <div className="flex items-center justify-between mb-3">
              <div className="flex items-center gap-2.5">
                <Users className="w-5 h-5 text-emerald-400 shrink-0" />
                <h3 className="text-xl font-bold">Thành Viên Đang Trực Tuyến</h3>
              </div>
              <span className="text-xs font-bold text-emerald-400">3/4 Hoạt động</span>
            </div>
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 my-auto">
              {[
                { name: 'Ngọc Hân', role: 'Lead Designer', status: 'bg-emerald-400', label: 'Trực tuyến' },
                { name: 'Tuấn Kiệt', role: 'Frontend Architect', status: 'bg-emerald-400', label: 'Đang code' },
                { name: 'Gia Huy', role: 'Backend Dev', status: 'bg-amber-400', label: 'Trong cuộc họp' },
                { name: 'Khánh Linh', role: 'Product Owner', status: 'bg-emerald-400', label: 'Sẵn sàng' },
              ].map((member) => (
                <div
                  key={member.name}
                  className="flex items-center justify-between bg-gray-900/65 border border-white/5 p-2.5 rounded-xl"
                >
                  <div className="flex items-center gap-2.5">
                    <div className="w-9 h-9 rounded-xl bg-purple-600/30 border border-purple-400/30 flex items-center justify-center text-xs font-bold text-purple-200">
                      {member.name.split(' ').map((w) => w[0]).join('')}
                    </div>
                    <div>
                      <div className="text-xs font-bold text-white">{member.name}</div>
                      <div className="text-[11px] text-gray-400 flex items-center gap-1.5">
                        <span className={`w-2 h-2 rounded-full ${member.status}`} />
                        {member.role} • {member.label}
                      </div>
                    </div>
                  </div>
                  <button
                    onClick={() => showToast(`Đã mở cửa sổ chat với ${member.name}`, 'info')}
                    className="p-2 rounded-lg bg-gray-800 hover:bg-purple-600/40 text-gray-300 hover:text-white transition-colors cursor-pointer"
                    title="Nhắn tin nhanh"
                  >
                    <MessageCircle className="w-4 h-4" />
                  </button>
                </div>
              ))}
            </div>
          </BentoCard>
        </div>
      </div>
    </div>
  );
}