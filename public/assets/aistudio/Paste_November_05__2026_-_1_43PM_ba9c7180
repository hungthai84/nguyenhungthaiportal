            const totalItems = headerPages.length;
            const navWidth = nav ? nav.clientWidth : 1080;
            const availableNavWidth = Math.max(100, navWidth - 16);
            const totalUnoverlappedWidth = totalItems * buttonWidth;

            let overlapMargin = 0;
            if (availableNavWidth < totalUnoverlappedWidth && totalItems > 1) {
                const neededShrink = totalUnoverlappedWidth - availableNavWidth;
                overlapMargin = Math.min(
                    Math.ceil(neededShrink / (totalItems - 1)),
                    Math.floor(buttonWidth * 0.65)
