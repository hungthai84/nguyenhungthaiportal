                      <td className="py-2.5 px-3 font-bold text-slate-900 whitespace-nowrap">{row.from}</td>
                      <td className="py-2.5 px-3 text-center font-mono text-blue-700 font-extrabold whitespace-nowrap">{row.dir}</td>
                      <td className="py-2.5 px-3 font-bold text-slate-900 whitespace-nowrap">{row.to}</td>
                      <td className="py-2.5 px-3 text-slate-700 font-medium">{row.data}</td>
                      <td className="py-2.5 px-3 font-mono text-indigo-700 font-bold whitespace-nowrap">{row.proto}</td>
                      <td className="py-2.5 px-3 text-slate-600 font-semibold whitespace-nowrap">{row.freq}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      )}

      {/* MODAL: SIMULATION */}
      {isSimOpen && (
        <div className="fixed inset-0 z-50 bg-slate-950/40 backdrop-blur-md flex items-center justify-center p-3" onClick={() => setIsSimOpen(false)}>
          <div className="bg-white/95 backdrop-blur-xl border border-slate-300 w-full max-w-lg rounded-[14px] p-4 sm:p-5 shadow-2xl space-y-4" onClick={(e) => e.stopPropagation()}>
            <div className="flex items-center justify-between border-b border-slate-200 pb-3">
              <div className="flex items-center gap-2.5">
                <div className="w-8 h-8 rounded-[10px] bg-blue-100 text-blue-700 flex items-center justify-center">
                  <Play className="w-4 h-4" />
                </div>
                <div>
                  <h3 className="font-black text-slate-950 text-sm">Quy Trình Xử Lý Cuộc Gọi CSKH Khép Kín</h3>
                  <p className="text-[10px] text-slate-600 font-bold">Chu trình luân chuyển dữ liệu thực tế</p>
                </div>
              </div>
              <button onClick={() => setIsSimOpen(false)} className="text-slate-500 hover:text-slate-800">
                <X className="w-4 h-4" />
              </button>
            </div>

            <div className="space-y-2 text-xs">
              <div className="p-2.5 rounded-[10px] bg-slate-50 border-l-4 border-cyan-500">
                <strong className="text-cyan-900 block text-[11px] font-black">Bước 1: Tiếp nhận cuộc gọi</strong>
                <span className="text-slate-700 font-medium">Tư vấn viên đăng nhập SDP (SSO qua <strong>HRM</strong>). <strong>CSC</strong> tự động bật popup cuộc gọi và tạo Ticket tương tác.</span>
              </div>
              <div className="p-2.5 rounded-[10px] bg-slate-50 border-l-4 border-blue-600">
                <strong className="text-blue-900 block text-[11px] font-black">Bước 2: Nạp hồ sơ khách hàng 360°</strong>
                <span className="text-slate-700 font-medium">SDP kéo thông tin liên hệ từ <strong>CRM</strong>, thẻ VIP và voucher tích điểm từ <strong>CLP</strong>, đơn hàng gần nhất từ <strong>POS / ERP</strong>.</span>
              </div>
              <div className="p-2.5 rounded-[10px] bg-slate-50 border-l-4 border-violet-600">
                <strong className="text-violet-900 block text-[11px] font-black">Bước 3: AI Assistant trợ lực</strong>
                <span className="text-slate-700 font-medium"><strong>AI Assistant</strong> tra cứu sổ tay quy trình từ <strong>LMS</strong>, gợi ý kịch bản trả lời và phản hồi tối ưu trực tiếp cho Agent.</span>
              </div>
              <div className="p-2.5 rounded-[10px] bg-slate-50 border-l-4 border-indigo-600">
                <strong className="text-indigo-900 block text-[11px] font-black">Bước 4: Điều phối quy trình & Báo cáo</strong>
                <span className="text-slate-700 font-medium">Trường hợp đổi trả, SDP gửi lệnh duyệt sang <strong>BPM</strong> & kho <strong>ERP</strong>. Chỉ số CSAT/SLA tự động đẩy vào <strong>OKR</strong> và hiển thị lên <strong>BI Dashboard</strong>.</span>
              </div>
            </div>

            <div className="pt-2 flex justify-end">
              <button onClick={() => setIsSimOpen(false)} className="px-4 py-2 rounded-[14px] bg-blue-600 hover:bg-blue-700 text-white font-extrabold text-xs transition-colors shadow-sm">
                Đóng và xem sơ đồ
              </button>
            </div>
          </div>
        </div>
      )}

      {/* TOAST NOTIFICATION */}
      <div className={`fixed bottom-4 right-4 z-50 bg-slate-950/95 backdrop-blur text-white px-3.5 py-2 rounded-[14px] shadow-xl flex items-center gap-2 text-xs font-bold transition-all duration-300 ${toastMessage ? 'opacity-100 translate-y-0' : 'opacity-0 pointer-events-none translate-y-2'}`}>
        <CheckCircle className="w-4 h-4 text-emerald-400" />
        <span>{toastMessage}</span>
      </div>

    </div>
  );
}

// Reusable Satellite Node Component
const NodeCard = React.forwardRef(({ opacity, offset, onPointerDown, icon: Icon, code, abbr, title, themeClass, iconBg, codeBg, textColor }, ref) => {
  return (
    <div
      ref={ref}
      style={{
        opacity,
        filter: opacity < 1 ? 'grayscale(80%)' : 'none',
        transform: offset ? `translate(${offset.x}px, ${offset.y}px)` : 'none'
      }}
      onPointerDown={onPointerDown}
      className={`system-node draggable-card ${themeClass} glass-flat-hover rounded-[14px] p-2 sm:p-2.5 flex items-center justify-between gap-2 shadow-md`}
    >
      <div className="flex items-center gap-2 sm:gap-2.5 min-w-0">
        <div className={`w-8 h-8 sm:w-9 sm:h-9 rounded-full ${iconBg} text-white flex items-center justify-center shrink-0 shadow-md border-2 border-white`}>
          <Icon className="w-3.5 sm:w-4 h-3.5 sm:h-4" />
        </div>
        <div className="min-w-0">
          <div className="flex items-center gap-1.5">
            <span className={`text-[9px] sm:text-[9.5px] font-mono px-1 sm:px-1.5 py-0.2 ${codeBg} text-white rounded font-extrabold`}>{code}</span>
            <h3 className="font-black text-slate-950 text-xs sm:text-sm tracking-tight">{abbr}</h3>
          </div>
          <p className="text-[9.5px] sm:text-[10.5px] text-slate-900 truncate font-extrabold">{title}</p>
        </div>
      </div>
      <Move className={`w-3 h-3 ${textColor} shrink-0 opacity-75`} />
    </div>
  );
});

function linkFontColor(hex) {
  return hex || '#2563eb';
}