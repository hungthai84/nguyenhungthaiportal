    const grid = document.getElementById('courseGrid');
    const emptyState = document.getElementById('emptyState');
    const searchInput = document.getElementById('searchInput');
    const filterButtons = [...document.querySelectorAll('.filter-btn')];
    const sectionHint = document.getElementById('sectionHint');
    let activeFilter = 'all';
    let expandedId = null;

    const escapeHtml = (value='') => String(value).replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    const listHTML = (items) => `<ul class="mini-list">${items.map(item=>`<li>${escapeHtml(item)}</li>`).join('')}</ul>`;
    const tagHTML = (items) => `<div class="tags">${items.map(item=>`<span>${escapeHtml(item)}</span>`).join('')}</div>`;
    const imageHTML = (url, alt, className) => url ? `<img class="${className}" src="${escapeHtml(url)}" alt="${escapeHtml(alt)}" loading="lazy" onerror="this.style.display='none'">` : '';
    const certificateHTML = (url, alt) => url
      ? `<a class="proof-image-link" href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer" aria-label="Mở ảnh minh chứng ${escapeHtml(alt)}">${imageHTML(url, alt, 'proof-thumb')}</a>`
      : `<div class="proof-missing">Chưa có ảnh minh chứng</div>`;

    function cardMarkup(course) {
      const expanded = expandedId === course.id;
      return `
        <article class="course-card ${expanded?'expanded':''}" data-id="${course.id}" style="--accent:${course.accent};--tint:${course.tint}">
          <button class="card-front" type="button" aria-expanded="${expanded}" aria-label="Xem chi tiết ${escapeHtml(course.title)}" data-open="${course.id}">
            <div class="card-topline"><span class="year-pill"><i data-lucide="calendar-days"></i><span>Năm ${escapeHtml(course.year)}</span></span><span class="category-pill">${escapeHtml(course.categoryLabel)}</span></div>
            <div class="card-banner"><div class="banner-fallback"><i data-lucide="${course.icon}"></i></div>${imageHTML(course.banner,course.title,'')}</div>
            <div class="card-title-row"><span class="card-title-icon"><i data-lucide="${course.icon}"></i></span><div class="card-title">${escapeHtml(course.title)}</div></div>
            <div class="card-institution">${escapeHtml(course.institution)}</div>
            <div class="card-bottom"><span class="card-kind">${escapeHtml(course.type)}</span><span class="open-hint">Xem chi tiết <b><i data-lucide="arrow-up-right"></i></b></span></div>
          </button>
          <section class="detail-view" aria-label="Chi tiết ${escapeHtml(course.title)}">
            <div class="detail-head">
              <div class="detail-head-main">
                <div class="detail-symbol"><i data-lucide="${course.icon}"></i></div>
                <div class="detail-heading"><h2>${escapeHtml(course.title)}</h2><p>${escapeHtml(course.institution)} · ${escapeHtml(course.year)}</p></div>
              </div>
              <div class="detail-actions"><span class="detail-chip">${escapeHtml(course.type)}</span><button class="close-detail" type="button" aria-label="Thu gọn thẻ" data-close="${course.id}"><i data-lucide="x"></i></button></div>
            </div>
            <div class="detail-bento">
              <article class="detail-tile tile-overview"><h3><span class="tile-icon"><i data-lucide="info"></i></span>Tổng quan chương trình</h3><p>${escapeHtml(course.summary)}</p><div class="meta-grid"><div class="meta-item"><small>Thời gian</small><strong>${escapeHtml(course.year)}</strong></div><div class="meta-item"><small>Hình thức</small><strong>${escapeHtml(course.type)}</strong></div><div class="meta-item"><small>Đơn vị</small><strong>${escapeHtml(course.institution)}</strong></div><div class="meta-item"><small>Nhóm năng lực</small><strong>${escapeHtml(course.categoryLabel)}</strong></div></div></article>
              <article class="detail-tile tile-goal"><h3><span class="tile-icon"><i data-lucide="target"></i></span>Mục tiêu & định hướng</h3><p>${escapeHtml(course.goal)}</p>${tagHTML(course.focus)}</article>
              <article class="detail-tile tile-curriculum"><h3><span class="tile-icon"><i data-lucide="book-open"></i></span>Nội dung chuyên môn</h3>${listHTML(course.curriculum)}</article>
              <article class="detail-tile tile-skills"><h3><span class="tile-icon"><i data-lucide="lightbulb"></i></span>Năng lực hình thành</h3>${listHTML(course.skills)}</article>
              <article class="detail-tile tile-application"><h3><span class="tile-icon"><i data-lucide="workflow"></i></span>Ứng dụng trong công việc</h3><p>${escapeHtml(course.application)}</p></article>
              <article class="detail-tile tile-proof"><h3><span class="tile-icon"><i data-lucide="badge-check"></i></span>Kết quả & minh chứng</h3><p>${escapeHtml(course.outcome)}</p><div class="proof-row">${certificateHTML(course.certificate,`Minh chứng ${course.title}`)}<div class="proof-copy"><strong>${escapeHtml(course.credential)}</strong><span>Hình ảnh minh chứng theo dữ liệu được cung cấp</span></div></div></article>
            </div>
            <div class="detail-foot"><span>HỒ SƠ HỌC VẤN · NGUYỄN HÙNG THÁI</span><strong>Chọn nút × để thu gọn</strong></div>
          </section>
        </article>`;
    }

    function captureRects() {
      return new Map([...grid.querySelectorAll('.course-card')].map(el=>[el.dataset.id,el.getBoundingClientRect()]));
    }
    function animateLayout(before, focusId, mode) {
      const cards = [...grid.querySelectorAll('.course-card')];
      cards.forEach((el, index) => {
        const old = before.get(el.dataset.id);
        if (!old) {
          if (mode === 'close') {
            el.animate([
              { opacity:0, transform:'translateY(14px) scale(.985)' },
              { opacity:1, transform:'translateY(0) scale(1)' }
            ], { duration:520, delay:Math.min(index * 35, 280), easing:'cubic-bezier(.2,.8,.2,1)', fill:'both' });
          }
          return;
        }
        const now = el.getBoundingClientRect();
        const dx = old.left - now.left;
        const dy = old.top - now.top;
        const sx = old.width / Math.max(now.width,1);
        const sy = old.height / Math.max(now.height,1);
        if (Math.abs(dx)+Math.abs(dy)+Math.abs(sx-1)+Math.abs(sy-1) < .02) return;
        el.animate([
          { transform:`translate(${dx}px,${dy}px) scale(${sx},${sy})`, transformOrigin:'top left', borderRadius:'18px' },
          { transform:'translate(0,0) scale(1,1)', transformOrigin:'top left', borderRadius:'18px' }
        ], { duration: mode==='open' ? 980 : 760, easing:'cubic-bezier(.16,1,.3,1)', fill:'both' });
      });
    }
    function render() {
      const query = searchInput.value.trim().toLocaleLowerCase('vi');
      const visible = courses.filter(course => {
        const filterMatch = activeFilter==='all' || course.category===activeFilter;
        const haystack = [course.title,course.institution,course.year,course.summary,course.categoryLabel].join(' ').toLocaleLowerCase('vi');
        return filterMatch && (!query || haystack.includes(query));
      });
      if (expandedId && !visible.some(item=>item.id===expandedId)) expandedId = null;
      const displayed = expandedId ? visible.filter(item=>item.id===expandedId) : visible;
      grid.classList.toggle('is-expanded', Boolean(expandedId));
      grid.innerHTML = displayed.map(cardMarkup).join('');
      emptyState.style.display = visible.length ? 'none' : 'block';
      if (sectionHint) {
        sectionHint.textContent = expandedId
          ? 'Đang xem hồ sơ chi tiết · Các thẻ học vấn khác tạm ẩn · Chọn nút đóng để trở về danh sách'
          : 'Chọn một thẻ để xem hồ sơ chi tiết · Mở rộng theo diện tích tương đương 9 thẻ học vấn';
      }
      refreshLucideIcons();
    }
    function setExpanded(id) {
      const before = captureRects();
      const opening = expandedId !== id;
      expandedId = opening ? id : null;
      render();
      requestAnimationFrame(()=>requestAnimationFrame(()=>animateLayout(before,id,opening?'open':'close')));
      if (expandedId) {
        const target = grid.querySelector(`[data-id="${expandedId}"]`);
        setTimeout(()=>target?.scrollIntoView({behavior:'smooth',block:'nearest'}),180);
      }
    }
    grid.addEventListener('click', event => {
      const openButton = event.target.closest('[data-open]');
      const closeButton = event.target.closest('[data-close]');
      if (openButton) setExpanded(openButton.dataset.open);
      if (closeButton) { event.stopPropagation(); setExpanded(closeButton.dataset.close); }
    });
    grid.addEventListener('keydown', event => {
      if ((event.key==='Enter' || event.key===' ') && event.target.matches('.card-front')) {
        event.preventDefault(); setExpanded(event.target.dataset.open);
      }
    });
    filterButtons.forEach(button => button.addEventListener('click', () => {
      activeFilter = button.dataset.filter;
      filterButtons.forEach(item=>item.classList.toggle('active',item===button));
      render();
    }));
    searchInput.addEventListener('input',render);
    render();
    refreshLucideIcons();
  </script>
</body>
</html>
