export default function App() {
  const [selectedService, setSelectedService] = useState(null);
  const [morphStyle, setMorphStyle] = useState(null);
  const [isContentVisible, setIsContentVisible] = useState(false);
  const cardRefs = useRef({});
  const containerRef = useRef(null);

  // Mở modal dạng Morphing animation
  const handleOpenDetail = (service) => {
    const cardEl = cardRefs.current[service.id];
    const containerEl = containerRef.current;

    if (cardEl && containerEl) {
      const cardRect = cardEl.getBoundingClientRect();
      const containerRect = containerEl.getBoundingClientRect();

      // Vị trí ban đầu tương đối với Container
      setMorphStyle({
        left: `${cardRect.left - containerRect.left}px`,
        top: `${cardRect.top - containerRect.top}px`,
        width: `${cardRect.width}px`,
        height: `${cardRect.height}px`,
        opacity: 0.9,
      });

      setSelectedService(service);

      // Kích hoạt animation phóng to toàn màn hình container
      requestAnimationFrame(() => {
        setTimeout(() => {
          setMorphStyle({
            left: '0px',
            top: '0px',
            width: '100%',
            height: '100%',
            opacity: 1,
          });
          setIsContentVisible(true);
        }, 20);
      });
    }
  };

  // Đóng modal chi tiết
  const handleCloseDetail = () => {
    if (!selectedService) return;
    const cardEl = cardRefs.current[selectedService.id];
    const containerEl = containerRef.current;

    setIsContentVisible(false);

    if (cardEl && containerEl) {
      const cardRect = cardEl.getBoundingClientRect();
      const containerRect = containerEl.getBoundingClientRect();

      setMorphStyle({
        left: `${cardRect.left - containerRect.left}px`,
        top: `${cardRect.top - containerRect.top}px`,
        width: `${cardRect.width}px`,
        height: `${cardRect.height}px`,
        opacity: 0,
      });

      setTimeout(() => {
        setSelectedService(null);
        setMorphStyle(null);
      }, 550);
    } else {
      setSelectedService(null);
    }
  };

  return (
    <div className="min-h-screen text-[#1E266D] font-['Play',sans-serif] bg-[#F8FAFF] relative overflow-hidden select-none">
      {/* Background Radial Gradients */}
      <div className="absolute inset-0 pointer-events-none z-0">
        <div className="absolute top-[5%] left-[4%] w-[30vw] h-[30vw] rounded-full bg-[#FFDF25]/15 blur-[90px]" />
        <div className="absolute top-[4%] right-[8%] w-[28vw] h-[28vw] rounded-full bg-[#EC7D21]/12 blur-[90px]" />
        <div className="absolute top-[38%] right-[0%] w-[32vw] h-[32vw] rounded-full bg-[#E64C72]/12 blur-[100px]" />
        <div className="absolute bottom-[12%] right-[18%] w-[30vw] h-[30vw] rounded-full bg-[#DD4E9E]/10 blur-[90px]" />
        <div className="absolute top-[2%] left-[57%] w-[25vw] h-[25vw] rounded-full bg-[#6353B5]/10 blur-[85px]" />
        <div className="absolute top-[38%] left-[15%] w-[28vw] h-[28vw] rounded-full bg-[#1480C0]/10 blur-[90px]" />
        <div className="absolute bottom-[12%] left-[6%] w-[26vw] h-[26vw] rounded-full bg-[#3BB8E6]/12 blur-[85px]" />
        <div className="absolute bottom-[0%] left-[46%] w-[32vw] h-[32vw] rounded-full bg-[#5DC3C8]/12 blur-[95px]" />
      </div>

      {/* Main Page Shell */}
      <main className="relative z-10 max-w-[1240px] mx-auto px-4 sm:px-6 py-8 sm:py-12 md:py-16">
        
        {/* Header Intro */}
        <header className="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 sm:mb-10">
          <div>
            <div className="inline-flex items-center gap-2 text-[#6353B5] text-[11px] font-extrabold tracking-[0.14em] uppercase mb-2">
              <span className="w-7 h-[4px] rounded-full bg-gradient-to-r from-[#FFDF25] via-[#EC7D21] via-[#E64C72] via-[#6353B5] via-[#1480C0] to-[#50B347]" />
              Hồ Sơ Năng Lực Cốt Lõi
            </div>
            <h1 className="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-[#1E266D] leading-tight">
              Lĩnh Vực Chuyên Môn
            </h1>
            <p className="mt-2 text-sm text-[#64748B] max-w-2xl leading-relaxed">
              Tổng quan các lĩnh vực công nghệ, hệ thống quy mô lớn và chuyển đổi số doanh nghiệp do Nguyễn Hùng Thái trực tiếp thiết kế giải pháp và điều phối triển khai.
            </p>
          </div>

          <div className="self-start md:self-auto flex items-center gap-2 px-4 py-2.5 rounded-xl border border-white/90 bg-gradient-to-r from-white/80 to-[#A78BFA]/15 text-[#6353B5] text-xs font-bold shadow-sm backdrop-blur-md">
            <span>Tổng số:</span>
            <strong className="text-sm font-extrabold text-[#1E266D]">6 Lĩnh Vực</strong>
          </div>
        </header>

        {/* Grid Container */}
        <div ref={containerRef} className="relative grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-5 min-h-[500px]">
          
          {SERVICES_DATA.map((service) => (
            <article
              key={service.id}
              ref={(el) => (cardRefs.current[service.id] = el)}
              onClick={() => handleOpenDetail(service)}
              className="group relative flex flex-col p-5 rounded-xl border border-white/90 cursor-pointer overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-lg backdrop-blur-md"
              style={{
                background: `linear-gradient(145deg, rgba(255,255,255,0.88), ${service.accentSoft}A0)`
              }}
            >
              {/* Header Card */}
              <div className="flex items-center justify-between mb-4 z-10">
                <div className="flex items-center gap-3">
                  <div 
                    className="w-11 h-11 rounded-full flex items-center justify-center border bg-white/90 shadow-sm backdrop-blur-sm"
                    style={{ borderColor: `${service.accent}40` }}
                  >
                    <span className="text-xs font-black tracking-tight" style={{ color: service.accentDeep }}>
                      {service.brandMark}
                    </span>
                  </div>
                  <div className="w-10 h-10 flex items-center justify-center" style={{ color: service.accentDeep }}>
                    <service.icon className="w-7 h-7 stroke-[1.85]" />
                  </div>
                </div>
                <span className="text-[10px] font-black tracking-wider opacity-75" style={{ color: service.accentDeep }}>
                  {service.num}
                </span>
              </div>

              {/* Title & Description */}
              <h2 className="text-lg font-bold text-[#1E266D] mb-1.5 leading-snug group-hover:text-black transition-colors z-10">
                {service.title}
              </h2>
              <p className="text-xs text-[#64748B] leading-relaxed mb-4 min-h-[40px] z-10">
                {service.description}
              </p>

              {/* Metric Pills */}
              <div className="mt-auto pt-3 flex flex-wrap gap-2 z-10">
                <span 
                  className="px-2.5 py-1 rounded-md text-[10.5px] font-bold border backdrop-blur-sm whitespace-nowrap"
                  style={{ 
                    color: service.accentDeep, 
                    backgroundColor: `${service.accent}12`,
                    borderColor: `${service.accent}30` 
                  }}
                >
                  {service.tag1}
                </span>
                <span 
                  className="px-2.5 py-1 rounded-md text-[10.5px] font-bold border backdrop-blur-sm whitespace-nowrap"
                  style={{ 
                    color: service.accentDeep, 
                    backgroundColor: `${service.accent}12`,
                    borderColor: `${service.accent}30` 
                  }}
                >
                  {service.tag2}
                </span>
              </div>

              {/* Bottom Action */}
              <div 
                className="mt-4 pt-3 flex items-center justify-between border-t text-[11px] font-extrabold z-10"
                style={{ 
                  borderColor: `${service.accent}25`,
                  color: service.accentDeep 
                }}
              >
                <span>Xem chi tiết chuyên môn</span>
                <div 
                  className="w-6 h-6 rounded-lg flex items-center justify-center border transition-transform duration-300 group-hover:translate-x-1"
                  style={{ 
                    backgroundColor: `${service.accent}15`,
                    borderColor: `${service.accent}30` 
                  }}
                >
                  <ArrowRight className="w-3.5 h-3.5" />
                </div>
              </div>
            </article>
          ))}

          {/* Morphing Detail View Overlay */}
          {selectedService && morphStyle && (
            <div
              className={`absolute z-50 rounded-xl border border-white/95 backdrop-blur-xl shadow-2xl transition-all duration-500 ease-out overflow-hidden flex flex-col`}
              style={{
                left: morphStyle.left,
                top: morphStyle.top,
                width: morphStyle.width,
                height: morphStyle.height,
                opacity: morphStyle.opacity,
                background: `linear-gradient(145deg, rgba(255,255,255,0.97), ${selectedService.accentSoft}D0)`
              }}
            >
              <div 
                className={`w-full h-full overflow-y-auto p-5 sm:p-7 md:p-8 transition-all duration-300 ease-out ${
                  isContentVisible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-4'
                }`}
              >
                {/* Detail Head */}
                <div className="flex items-start justify-between gap-4 pb-5 border-b border-[#1E266D]/10">
                  <div className="flex gap-4 min-w-0">
                    <div 
                      className="shrink-0 w-12 h-12 rounded-xl flex items-center justify-center bg-white/80 border shadow-sm"
                      style={{ color: selectedService.accent, borderColor: `${selectedService.accent}30` }}
                    >
                      <selectedService.icon className="w-7 h-7 stroke-[1.85]" />
                    </div>
                    <div>
                      <div 
                        className="text-[10px] font-black tracking-widest uppercase mb-1"
                        style={{ color: selectedService.accent }}
                      >
                        {selectedService.kicker}
                      </div>
                      <h2 className="text-xl sm:text-2xl md:text-3xl font-extrabold text-[#1E266D] tracking-tight">
                        {selectedService.title}
                      </h2>
                      <p className="mt-1.5 text-xs sm:text-sm text-[#64748B] max-w-3xl leading-relaxed">
                        {selectedService.summary}
                      </p>
                    </div>
                  </div>

                  <button
                    onClick={handleCloseDetail}
                    className="shrink-0 inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-slate-200 bg-white/80 text-[#666481] hover:bg-white text-xs font-bold transition-all hover:scale-105 active:scale-95"
                  >
                    <X className="w-4 h-4" />
                    <span className="hidden sm:inline">Đóng lại</span>
                  </button>
                </div>

                {/* Key Metrics Grid */}
                <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 my-5">
                  {selectedService.metrics.map((m, idx) => {
                    const topColors = ['#FFDF25', '#E64C72', '#3BB8E6', '#A78BFA'];
                    return (
                      <div 
                        key={idx} 
                        className="relative overflow-hidden p-3 sm:p-4 rounded-xl bg-white/70 border border-white/90 backdrop-blur-md shadow-xs"
                      >
                        <div 
                          className="absolute top-0 left-0 right-0 h-1" 
                          style={{ backgroundColor: topColors[idx % 4] }}
                        />
                        <span 
                          className="block text-xl sm:text-2xl font-black tracking-tight"
                          style={{ color: selectedService.accent }}
                        >
                          {m.val}
                        </span>
                        <span className="block mt-1 text-[11px] text-[#64748B] font-semibold leading-tight">
                          {m.label}
                        </span>
                      </div>
                    );
                  })}
                </div>

                {/* Top Info Cards */}
                <div className="grid grid-cols-1 lg:grid-cols-2 gap-3 mb-3">
                  {/* Partners */}
                  <div className="p-4 rounded-xl bg-white/70 border border-white/90 backdrop-blur-md">
                    <div className="flex items-center gap-2 text-xs font-black text-[#1E266D] mb-3">
                      <div className="w-6 h-6 rounded-md flex items-center justify-center bg-[#5DC3C8]/20 text-[#278A8F]">
                        <Users className="w-3.5 h-3.5" />
                      </div>
                      Đối tác & Khách hàng tiêu biểu
                    </div>
                    <div className="flex flex-wrap gap-2">
                      {selectedService.partners.map((p, i) => (
                        <span 
                          key={i} 
                          className="px-3 py-1.5 rounded-lg border border-slate-200/80 bg-white/80 text-[#64748B] text-xs font-bold shadow-2xs"
                        >
                          {p}
                        </span>
                      ))}
                    </div>
                  </div>

                  {/* Role */}
                  <div className="p-4 rounded-xl bg-white/70 border border-white/90 backdrop-blur-md">
                    <div className="flex items-center gap-2 text-xs font-black text-[#1E266D] mb-3">
                      <div className="w-6 h-6 rounded-md flex items-center justify-center bg-[#A78BFA]/20 text-[#7058C7]">
                        <Award className="w-3.5 h-3.5" />
                      </div>
                      Vai trò & Trách nhiệm chuyên môn
                    </div>
                    <p className="text-xs text-[#64748B] leading-relaxed font-semibold">
                      {selectedService.role}
                    </p>
                  </div>
                </div>

                {/* Main Technical Columns */}
                <div className="grid grid-cols-1 lg:grid-cols-3 gap-3">
                  
                  {/* Solution & Architecture */}
                  <div className="lg:col-span-2 space-y-3">
                    <div className="p-4 rounded-xl bg-white/70 border border-white/90 backdrop-blur-md">
                      <div className="flex items-center gap-2 text-xs font-black text-[#1E266D] mb-2">
                        <div className="w-6 h-6 rounded-md flex items-center justify-center bg-[#1480C0]/15 text-[#1480C0]">
                          <Activity className="w-3.5 h-3.5" />
                        </div>
                        Tổng quan giải pháp kỹ thuật
                      </div>
                      <p className="text-xs text-[#64748B] leading-relaxed">
                        {selectedService.overview}
                      </p>
                    </div>

                    <div className="p-4 rounded-xl bg-white/70 border border-white/90 backdrop-blur-md">
                      <div className="flex items-center gap-2 text-xs font-black text-[#1E266D] mb-3">
                        <div className="w-6 h-6 rounded-md flex items-center justify-center bg-[#EC7D21]/15 text-[#EC7D21]">
                          <Cpu className="w-3.5 h-3.5" />
                        </div>
                        Đặc điểm kiến trúc cốt lõi
                      </div>
                      <ul className="space-y-2">
                        {selectedService.architecture.map((arch, i) => (
                          <li key={i} className="flex items-start gap-2 text-xs text-[#64748B] leading-normal">
                            <span 
                              className="w-1.5 h-1.5 rounded-full mt-1.5 shrink-0" 
                              style={{ backgroundColor: selectedService.accent }}
                            />
                            <span>{arch}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  {/* Tech Stack Tags */}
                  <div className="lg:col-span-1">
                    <div className="h-full p-4 rounded-xl bg-white/70 border border-white/90 backdrop-blur-md">
                      <div className="flex items-center gap-2 text-xs font-black text-[#1E266D] mb-3">
                        <div className="w-6 h-6 rounded-md flex items-center justify-center bg-[#50B347]/15 text-[#50B347]">
                          <Settings className="w-3.5 h-3.5" />
                        </div>
                        Công nghệ & Công cụ sử dụng
                      </div>
                      <div className="flex flex-wrap gap-1.5">
                        {selectedService.technologies.map((tech, i) => {
                          const tagAccents = [
                            '#FFDF25', '#EC7D21', '#E64C72', '#DD4E9E', 
                            '#6353B5', '#1480C0', '#3BB8E6', '#5DC3C8', 
                            '#50B347', '#A3D43A', '#A78BFA'
                          ];
                          const tagColor = tagAccents[i % tagAccents.length];
                          return (
                            <span 
                              key={i} 
                              className="px-2.5 py-1 rounded-md text-[10px] font-bold border"
                              style={{ 
                                color: tagColor === '#FFDF25' ? '#B45309' : tagColor,
                                backgroundColor: `${tagColor}15`,
                                borderColor: `${tagColor}35`
                              }}
                            >
                              {tech}
                            </span>
                          );
                        })}
                      </div>
                    </div>
                  </div>

                </div>

                {/* Footer Note */}
                <div className="mt-6 text-[10px] text-[#94A3B8] leading-relaxed">
                  * Tài liệu chuyên môn kỹ thuật được cập nhật thường xuyên bởi Nguyễn Hùng Thái. Mọi thông tin về bản quyền kiến trúc được bảo lưu theo tiêu chuẩn công nghiệp.
                </div>

              </div>
            </div>
          )}

        </div>

        {/* Hint */}
        <div className="mt-6 flex items-center justify-center gap-2 text-xs text-[#82819A]">
          <Info className="w-4 h-4" />
          <span>Bấm vào từng thẻ để xem chi tiết kiến trúc, công nghệ và các dự án tiêu biểu.</span>
        </div>

        {/* Footer Note */}
        <footer className="mt-10 pt-4 border-t border-[#1E266D]/10 flex flex-col sm:flex-row items-center justify-between text-[11px] text-[#9A98AE] gap-2">
          <div>
            Được tối ưu hóa và phát triển bởi <strong className="text-[#777493]">Nguyễn Hùng Thái</strong>
          </div>
          <div>Bản quyền tài liệu chuyên môn © 2026</div>
        </footer>

      </main>
    </div>
  );
}