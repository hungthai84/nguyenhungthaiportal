                        {ZODIAC_SIGNS.map((z) => {
                          const isSelected = selectedZodiacKey === z.key;
                          return (
                            <button
                              key={z.key}
                              type="button"
                              onClick={() => handleSelectZodiacSign(z.key)}
                              title={`Tuổi ${z.name}: ${z.type}`}
                              className={`p-1.5 rounded-full border flex flex-col items-center justify-center gap-0.5 transition-all cursor-pointer ${
                                isSelected
                                  ? 'bg-gradient-to-br from-blue-600 to-indigo-600 text-white border-blue-600 shadow-md scale-105'
                                  : 'bg-white/85 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200/80 dark:border-white/10 hover:bg-white'
                              }`}
                            >
                              <span className="text-base leading-none">{z.icon}</span>
                              <span className="text-[10px] font-bold leading-tight">{z.name}</span>
                            </button>
                          );
                        })}
                      </div>
                    </div>
                  </div>

                  <p className="text-[10.5px] text-slate-500 dark:text-slate-400 mt-2">
                    💡 Bấm vào một con giáp hoặc nhập năm sinh bất kỳ để phân tích độ hòa hợp theo Can Chi &amp; Ngũ Hành.
                  </p>
                </article>

                <article className="lg:col-span-6 p-4 rounded-[14px] bg-gradient-to-br from-white/95 via-blue-50/50 to-indigo-50/60 dark:from-slate-900/95 dark:via-blue-950/30 dark:to-slate-900/95 border border-blue-200/80 dark:border-blue-700/50 shadow-xs flex flex-col justify-between gap-3">
                  <div>
                    <div className="flex items-center justify-between pb-2 border-b border-slate-200/60 dark:border-white/10">
                      <span className="text-xs font-bold text-slate-700 dark:text-slate-300 tracking-wide flex items-center gap-1.5">
                        <Sparkles className="w-3.5 h-3.5 text-blue-600" />
                        <span>Kết quả đối chiếu với Giáp Tý 1984</span>
                      </span>
                      {canChiData && (
                        <span className="text-[10px] font-bold font-mono px-2 py-0.5 rounded-full bg-blue-100 dark:bg-blue-950/80 text-blue-800 dark:text-cyan-300 border border-blue-200 dark:border-blue-800 flex items-center gap-1">
                          <Gem className="w-3 h-3 text-cyan-400" />
                          <span>Mệnh {canChiData.element}</span>
                        </span>
                      )}
                    </div>

                    <div className="flex items-center gap-3 mt-3">
                      <div className="w-12 h-12 rounded-[14px] bg-white dark:bg-slate-800 border border-slate-200 dark:border-white/15 flex items-center justify-center text-2xl shadow-xs shrink-0">
                        {currentZodiac.icon}
                      </div>
                      <div className="min-w-0">
                        <h3 className="text-slate-900 dark:text-white text-base font-bold flex items-center gap-1.5">
                          <span>Tuổi {currentZodiac.name}</span>
                          {activeYearResult && canChiData && (
                            <span className="text-xs font-mono font-normal text-blue-600 dark:text-cyan-300">
                              ({activeYearResult} · {canChiData.canChi})
                            </span>
                          )}
                        </h3>
                        <p className="text-xs text-slate-600 dark:text-slate-300 mt-0.5">
                          {activeYearResult && canChiData
                            ? `Ngũ hành: ${canChiData.elementRelation}`
                            : `Nhóm địa chi ${currentZodiac.name} · Vai trò: ${currentZodiac.role}`}
                        </p>
                      </div>
                    </div>

                    <div className="flex flex-wrap gap-1.5 mt-2.5">
                      <span className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10.5px] font-bold bg-blue-100 dark:bg-blue-950/80 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
                        <Zap className="w-3 h-3 text-amber-500" />
                        <span>{currentZodiac.type}</span>
                      </span>
                      <span className="px-2.5 py-0.5 rounded-full text-[10.5px] font-bold bg-white/90 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-white/10 flex items-center gap-1">
                        <Briefcase className="w-3 h-3 text-blue-500" />
                        <span>Vai trò: {currentZodiac.role}</span>
                      </span>
                    </div>

                    <p className="text-[12.5px] text-slate-700 dark:text-slate-200 mt-3 leading-relaxed">
                      {currentZodiac.detail}
                    </p>

                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5 mt-3">
                      <div className="p-2.5 rounded-[12px] bg-emerald-50/85 dark:bg-emerald-950/35 border border-emerald-200/80 dark:border-emerald-800/50">
                        <b className="text-xs font-bold text-emerald-800 dark:text-emerald-300 flex items-center gap-1">
                          <CheckCircle className="w-3.5 h-3.5 text-emerald-600" />
                          <span>Điểm mạnh kết hợp</span>
                        </b>
                        <p className="text-[11px] text-slate-800 dark:text-slate-200 mt-1 leading-snug">
                          {currentZodiac.strength}
                        </p>
                      </div>

                      <div className="p-2.5 rounded-[12px] bg-amber-50/85 dark:bg-amber-950/35 border border-amber-200/80 dark:border-amber-800/50">
                        <b className="text-xs font-bold text-amber-800 dark:text-amber-300 flex items-center gap-1">
                          <ShieldAlert className="w-3.5 h-3.5 text-amber-600" />
                          <span>Điểm nghẽn chú ý</span>
                        </b>
                        <p className="text-[11px] text-slate-800 dark:text-slate-200 mt-1 leading-snug">
                          {currentZodiac.caution}
                        </p>
                      </div>
                    </div>

                    <div className="p-2.5 rounded-[12px] bg-blue-50/85 dark:bg-blue-950/35 border border-blue-200/80 dark:border-blue-800/50 mt-2.5">
                      <b className="text-xs font-bold text-blue-800 dark:text-blue-300 flex items-center gap-1">
                        <Target className="w-3.5 h-3.5 text-blue-600" />
                        <span>Gợi ý điều phối công việc</span>
                      </b>
                      <p className="text-[11px] text-slate-800 dark:text-slate-200 mt-1 leading-snug">
                        {currentZodiac.advice}
                      </p>
                    </div>
                  </div>
                </article>
              </div>
            </section>
          </div>
        </main>
      </div>
    </div>
  );
}