                className="w-8 h-8 sm:w-9 sm:h-9 shrink-0 bg-transparent border-0 p-0 shadow-none drop-shadow-[0_2px_8px_rgba(79,70,229,0.75)]"
                style={{ color: '#4f46e5' }}
              />
