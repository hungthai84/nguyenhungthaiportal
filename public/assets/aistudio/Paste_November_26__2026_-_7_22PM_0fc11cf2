  // Bật / tạm dừng phát âm thanh MP3
  const toggleMp3Playback = useCallback(() => {
    const audio = bookAudioRef.current;
    if (!audio) return;
    if (audio.paused) {
      playBookOpenSound();
    } else {
      audio.pause();
    }
