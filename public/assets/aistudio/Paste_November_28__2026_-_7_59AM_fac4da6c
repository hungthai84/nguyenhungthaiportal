// Component Thẻ Hệ Thống BentoCard
const SystemBentoCard = ({
  sys,
  bentoStyle,
  isExpanded,
  onToggleExpand,
  onCollapse,
  showToast,
}) => {
  const inlineVideoRef = useRef(null);
  const fullVideoRef = useRef(null);
  const thumbImgRef = useRef(null);

  const [isThumbHovered, setIsThumbHovered] = useState(false);
  const [isVideoFull, setIsVideoFull] = useState(false);
  const [imgFailed, setImgFailed] = useState(false);
  const [inlineVideoStyle, setInlineVideoStyle] = useState({});
  const [inlineVideoFit, setInlineVideoFit] = useState('object-contain');

  // Tự động căn chỉnh thông minh video theo kích thước & tỷ lệ thực tế của hình ảnh
  const smartAlignInlineVideo = useCallback(() => {
    const videoEl = inlineVideoRef.current;
    const imgEl = thumbImgRef.current;
    if (!videoEl || !imgEl) return;

    const imgRect = imgEl.getBoundingClientRect();
    const parentRect = imgEl.parentElement?.getBoundingClientRect();

    if (imgRect.width > 0 && imgRect.height > 0 && parentRect && parentRect.width > 0) {
      setInlineVideoStyle({
        left: `${imgRect.left - parentRect.left}px`,
        top: `${imgRect.top - parentRect.top}px`,
        width: `${imgRect.width}px`,
        height: `${imgRect.height}px`,
      });
    }

    if (videoEl.videoWidth && videoEl.videoHeight && imgRect.width && imgRect.height) {
      const videoRatio = videoEl.videoWidth / videoEl.videoHeight;
      const imgRatio = imgRect.width / imgRect.height;
      setInlineVideoFit(Math.abs(videoRatio - imgRatio) < 0.35 ? 'object-cover' : 'object-contain');
    }
  }, []);

  // Xử lý rê chuột vào vùng hình: chuyển nền thẻ sang trắng & phát video ngay tại hình
  const handleThumbMouseEnter = () => {
    if (isVideoFull) return;
    setIsThumbHovered(true);
    smartAlignInlineVideo();
    if (inlineVideoRef.current) {
      inlineVideoRef.current.play().catch(() => {});
    }
  };

  const handleThumbMouseLeave = () => {
    setIsThumbHovered(false);
    if (inlineVideoRef.current) {
      inlineVideoRef.current.pause();
    }
  };

  // Mở chế độ video toàn thẻ
  const enterFullCardVideo = useCallback(() => {
    setIsVideoFull(true);
    setIsThumbHovered(false);
    if (inlineVideoRef.current) inlineVideoRef.current.pause();
    if (fullVideoRef.current) {
      fullVideoRef.current.currentTime = 0;
      fullVideoRef.current.play().catch(() => {});
    }
  }, []);

  const exitFullCardVideo = useCallback(() => {
    setIsVideoFull(false);
    if (fullVideoRef.current) {
      fullVideoRef.current.pause();
    }
  }, []);

  const handleCardClick = (e) => {
    if (isVideoFull) return;
    if (
      e.target.closest('button') ||
      e.target.closest('a') ||
      e.target.closest('.card-thumb-btn')
    ) {
      return;
    }
    onToggleExpand(sys.id);
  };

  return (
    <div
      onClick={handleCardClick}
      data-expanded={isExpanded ? 'true' : 'false'}
      data-video-full={isVideoFull ? 'true' : 'false'}
      data-thumb-hover={isThumbHovered ? 'true' : 'false'}
      style={{
        '--theme-color': sys.themeColor,
        '--badge-dark': sys.badgeTextColor,
        background: bentoStyle.cardBg,
      }}
      className={`system-card bento-card ${
        isExpanded ? 'md:col-span-2 md:row-span-2 ring-2 ring-purple-400/50' : ''
      } relative p-4 sm:p-5 text-white cursor-pointer flex flex-col`}
    >
      {/* Video toàn thẻ khi nhấp vào hình minh họa */}
      {sys.videoUrl && (
        <>
          <div
            onClick={(e) => {
              if (isVideoFull) {
                e.stopPropagation();
                exitFullCardVideo();
              }
            }}
            className={`card-video-wrapper absolute inset-0 overflow-hidden rounded-[14px] ${
              isVideoFull
                ? 'opacity-100 z-20 pointer-events-auto'
                : 'opacity-0 z-0 pointer-events-none'
            }`}
          >
            <video
              ref={fullVideoRef}
              src={sys.videoUrl}
              muted
              loop
              playsInline
              preload="metadata"
              className="w-full h-full object-cover scale-200 origin-center"
            />
          </div>

          {isVideoFull && (
            <button
              type="button"
              title="Thoát video"
              onClick={(e) => {
                e.stopPropagation();
                exitFullCardVideo();
              }}
              className="absolute top-3 right-3 z-30 w-8 h-8 rounded-full bg-slate-900/75 hover:bg-slate-900 text-white flex items-center justify-center shadow-md cursor-pointer"
            >
              <X className="w-4 h-4" />
            </button>
          )}
        </>
      )}

      {/* Lớp chuyển màu nền sang màu trắng khi rê chuột vào hình */}
      <div className="card-video-bg-sync" />

      {/* Top: Icon và Tên hệ thống chiếm trọn 1 hàng ngang phía trên cùng */}
      <div
        className={`card-header-top relative z-10 w-full pb-2.5 mb-2.5 border-b border-white/15 flex items-center justify-between gap-2 ${
          isVideoFull ? 'opacity-0 pointer-events-none' : ''
        }`}
      >
        <h3
          className="flex items-center gap-2 text-base sm:text-lg font-bold leading-snug min-w-0"
          style={{ color: bentoStyle.accentText }}
        >
          <SystemIcon
            iconName={sys.iconName}
            className="sys-icon w-5 h-5 shrink-0"
            style={{ color: bentoStyle.accentText }}
          />
          <span className="truncate">{sys.name}</span>
        </h3>
        <span className="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-black/25 text-white/85 border border-white/10 shrink-0">
          {sys.category}
        </span>
      </div>

      {/* Thân thẻ hình chữ nhật: Bên trái hình minh họa, Bên phải mô tả 4 hàng + Bottom */}
      <div
        className={`card-body-row relative z-10 flex items-center gap-3.5 ${
          isVideoFull ? 'opacity-0 pointer-events-none' : ''
        }`}
      >
        {/* Cột trái (42% chiều ngang): Hình minh họa không khung bao + video inline khi hover */}
        <div
          onClick={(e) => {
            e.stopPropagation();
            if (isVideoFull) {
              exitFullCardVideo();
            } else {
              enterFullCardVideo();
            }
          }}
          onMouseEnter={handleThumbMouseEnter}
          onMouseLeave={handleThumbMouseLeave}
          title="Nhấp để xem video toàn thẻ"
          className="card-thumb-btn relative z-20 w-[42%] flex items-center justify-center shrink-0 overflow-hidden rounded-xl"
        >
          {!imgFailed ? (
            <img
              ref={thumbImgRef}
              src={sys.imageUrl}
              alt={sys.abbr}
              onLoad={smartAlignInlineVideo}
              onError={() => setImgFailed(true)}
              className={`card-thumb-img w-full ${
                isExpanded ? 'h-40 sm:h-44' : 'h-32 sm:h-36'
              } object-contain ${isThumbHovered ? 'opacity-0' : 'opacity-100'}`}
            />
          ) : (
            <div className="w-16 h-16 text-white flex items-center justify-center">
              <SystemIcon iconName={sys.iconName} className="w-8 h-8" />
            </div>
          )}
          {/* Video phát ngay tại vị trí hình khi rê chuột vào hình (phóng to gấp 2 lần) */}
          <video
            ref={inlineVideoRef}
            src={sys.videoUrl}
            muted
            loop
            playsInline
            preload="metadata"
            onLoadedMetadata={smartAlignInlineVideo}
            style={{
              ...inlineVideoStyle,
              transform: 'scale(2)',
              transformOrigin: 'center center',
            }}
            className={`card-inline-video absolute inset-0 w-full h-full ${inlineVideoFit} pointer-events-none ${
              isThumbHovered ? 'opacity-100' : 'opacity-0'
            }`}
          />
        </div>

        {/* Cột phải (58% chiều ngang): Mô tả 4 hàng & Tên viết tắt / Tên đầy đủ ở Bottom */}
        <div className="card-content flex-1 flex flex-col justify-between gap-2 min-w-0">
          <p
            className={`text-white/90 text-xs sm:text-sm leading-relaxed ${
              isExpanded ? '' : 'line-clamp-4'
            }`}
          >
            {sys.description}
          </p>

          {/* Bottom: Tên viết tắt và Tên đầy đủ */}
          <div className="pt-2 border-t border-white/15">
            <div className="flex flex-wrap items-center gap-1.5 mb-0.5">
              <span
                className="w-2 h-2 rounded-full shrink-0"
                style={{ backgroundColor: bentoStyle.accentText }}
              />
              <span
                className="text-xs font-bold uppercase tracking-wider"
                style={{ color: bentoStyle.accentText }}
              >
                {sys.badge}
              </span>
            </div>
            <p
              className="text-[11px] font-normal text-white/75 leading-tight truncate"
              title={sys.fullName}
            >
              {sys.fullName}
            </p>
          </div>
        </div>
      </div>

      {/* Nội dung chi tiết chuẩn Bento Studio khi thẻ bung rộng gấp 4 lần */}
      {isExpanded && (
        <div
          className={`card-expanded-details relative z-10 mt-3.5 pt-3.5 border-t border-white/15 flex flex-col gap-3.5 ${
            isVideoFull ? 'opacity-0 pointer-events-none' : ''
          }`}
        >
          {/* Widget Bento phân tích chức năng chuyên biệt từng phân hệ */}
          <ExpandedBentoModule sys={sys} bentoStyle={bentoStyle} showToast={showToast} />

          <div className="space-y-2">
            <div className="flex flex-wrap items-center justify-between gap-2">
              <span
                className="text-xs font-bold uppercase tracking-wider"
                style={{ color: bentoStyle.accentText }}
              >
                Tính năng &amp; Chỉ số vận hành
              </span>
              <span className="px-2.5 py-1 rounded-full text-xs font-bold bg-black/30 text-white border border-white/15">
                {sys.metrics}
              </span>
            </div>
            <ul className="space-y-1.5 bg-black/20 border border-white/10 rounded-xl p-3">
              {sys.features.map((feat, i) => (
                <li key={i} className="flex items-start gap-2.5 text-xs sm:text-sm text-white/90">
                  <span
                    className="w-2 h-2 rounded-full mt-1.5 shrink-0"
                    style={{ backgroundColor: bentoStyle.accentText }}
                  />
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <div className="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-white/15">
            <div className="flex flex-wrap items-center gap-2">
              {sys.url ? (
                <a
                  href={sys.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  onClick={(e) => e.stopPropagation()}
                  className="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white text-gray-950 hover:bg-gray-100 text-xs font-bold shadow-lg"
                >
                  <span>Truy cập hệ thống</span>
                  <ArrowRight className="w-3.5 h-3.5" />
                </a>
              ) : (
                <span className="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-black/35 text-amber-300 border border-amber-400/30 text-xs font-bold">
                  <span className="w-1.5 h-1.5 rounded-full bg-amber-400" />
                  <span>Đang hoàn thiện tích hợp</span>
                </span>
              )}

              <button
                type="button"
                onClick={(e) => {
                  e.stopPropagation();
                  enterFullCardVideo();
                }}
                className="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white/15 hover:bg-white/25 text-white border border-white/20 text-xs font-bold cursor-pointer"
              >
                <Play className="w-3.5 h-3.5 fill-current" />
                <span>Xem Video</span>
              </button>
            </div>

            <button
              type="button"
              onClick={(e) => {
                e.stopPropagation();
                onCollapse();
              }}
              className="inline-flex items-center gap-1 px-3 py-2 rounded-xl text-white/80 hover:text-white hover:bg-white/15 text-xs font-bold cursor-pointer"
            >
              <span>Thu gọn</span>
              <ChevronUp className="w-3.5 h-3.5" />
            </button>
          </div>
        </div>
      )}
    </div>
  );
};

export default function App() {
  const [isLightMode, setIsLightMode] = useState(false);
  const [expandedId, setExpandedId] = useState(null);
  const [toasts, setToasts] = useState([]);

  const showToast = useCallback((message, type = 'info') => {
    const id = Date.now() + Math.random();
    setToasts((prev) => [...prev, { id, message, type }]);
    setTimeout(() => {
      setToasts((prev) => prev.filter((t) => t.id !== id));
    }, 3000);
  }, []);

  const toggleThemeMode = () => {
    setIsLightMode((prev) => {
      const next = !prev;
      showToast(
        next
          ? 'Đã chuyển sang giao diện Sáng (Light Mode)'
          : 'Đã chuyển sang giao diện Tối (Dark Mode)',
        next ? 'success' : 'info'
      );
      return next;
    });
  };

  const handleToggleExpand = useCallback((id) => {
    setExpandedId((prev) => (prev === id ? null : id));
  }, []);

  const handleCollapse = useCallback(() => {
    setExpandedId(null);
  }, []);

  // Nhấn ESC để thu gọn thẻ đang bung rộng
  useEffect(() => {
    const handleKeyDown = (e) => {
      if (e.key === 'Escape' && expandedId) {
        setExpandedId(null);
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [expandedId]);

  return (
    <div
      className={`bento-app-root text-white antialiased selection:bg-purple-500 selection:text-white min-h-screen py-10 px-4 sm:px-6 lg:px-8 ${
        isLightMode ? 'light-mode' : ''
      }`}
    >
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Play:wght@400;700&display=swap');

        .bento-app-root {
          font-family: 'Play', 'Inter', sans-serif;
          background-color: #090d16;
          background-image:
            radial-gradient(circle at 12% 14%, rgba(139, 92, 246, 0.24) 0%, transparent 42%),
            radial-gradient(circle at 88% 18%, rgba(56, 189, 248, 0.18) 0%, transparent 40%),
            radial-gradient(circle at 50% 92%, rgba(236, 72, 153, 0.15) 0%, transparent 45%),
            radial-gradient(rgba(148, 163, 184, 0.12) 1px, transparent 1px);
          background-size: 100% 100%, 100% 100%, 100% 100%, 24px 24px;
          background-attachment: fixed;
        }

        .bento-app-root.light-mode {
          background-color: #f4f7fb;
          background-image:
            radial-gradient(circle at 12% 14%, rgba(168, 85, 247, 0.16) 0%, transparent 44%),
            radial-gradient(circle at 88% 18%, rgba(14, 165, 233, 0.16) 0%, transparent 42%),
            radial-gradient(circle at 52% 90%, rgba(244, 114, 182, 0.14) 0%, transparent 46%),
            radial-gradient(rgba(71, 85, 105, 0.13) 1px, transparent 1px);
          background-size: 100% 100%, 100% 100%, 100% 100%, 24px 24px;
          background-attachment: fixed;
          color: #0f172a;
        }

        .bento-app-root.light-mode .studio-title {
          color: #0f172a !important;
        }

        .system-card.bento-card {
          border-radius: 14px;
          position: relative;
          overflow: hidden;
          border: 1px solid rgba(255, 255, 255, 0.16);
          box-shadow:
            0 14px 30px -8px rgba(0, 0, 0, 0.56),
            0 6px 14px -4px rgba(0, 0, 0, 0.38),
            inset 0 1px 0 rgba(255, 255, 255, 0.22);
          transition:
            transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
            box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1),
            border-color 0.35s ease;
        }

        .system-card.bento-card:hover {
          transform: translateY(-10px) scale(1.022);
          border-color: rgba(255, 255, 255, 0.34);
          box-shadow:
            0 32px 56px -12px rgba(0, 0, 0, 0.68),
            0 16px 28px -8px rgba(0, 0, 0, 0.46),
            0 0 0 1px rgba(255, 255, 255, 0.24),
            inset 0 1px 0 rgba(255, 255, 255, 0.32);
        }

        .system-card.bento-card:active {
          transform: translateY(-3px) scale(0.995);
        }

        /* Lớp chuyển màu nền thẻ sang màu trắng khi rê chuột vào hình */
        .card-video-bg-sync {
          position: absolute;
          inset: 0;
          border-radius: inherit;
          pointer-events: none;
          z-index: 1;
          opacity: 0;
          background: #ffffff !important;
        }

        .system-card.bento-card[data-thumb-hover="true"] .card-video-bg-sync {
          opacity: 1;
        }

        /* Điều chỉnh màu chữ & viền sang tông tối sắc nét khi nền thẻ chuyển sang màu trắng */
        .system-card.bento-card[data-thumb-hover="true"] {
          color: #0f172a !important;
          border-color: rgba(15, 23, 42, 0.15) !important;
        }

        .system-card.bento-card[data-thumb-hover="true"] .card-header-top,
        .system-card.bento-card[data-thumb-hover="true"] .card-content > div,
        .system-card.bento-card[data-thumb-hover="true"] .card-expanded-details {
          border-color: rgba(15, 23, 42, 0.12) !important;
        }

        .system-card.bento-card[data-thumb-hover="true"] h3,
        .system-card.bento-card[data-thumb-hover="true"] .card-content p {
          color: #0f172a !important;
        }

        .system-card.bento-card[data-thumb-hover="true"] .card-content p[title] {
          color: #475569 !important;
        }

        .system-card.bento-card[data-thumb-hover="true"] .card-header-top > span {
          background-color: rgba(15, 23, 42, 0.06) !important;
          color: #334155 !important;
          border-color: rgba(15, 23, 42, 0.12) !important;
        }

        .system-card.bento-card[data-thumb-hover="true"] .card-content span[style] {
          color: var(--badge-dark, #0f172a) !important;
        }
      `}</style>

      {/* Vùng thông báo nổi (Toast) */}
      <div className="fixed bottom-6 right-6 z-50 flex flex-col gap-3 pointer-events-none">
        {toasts.map((t) => (
          <div
            key={t.id}
            className={`pointer-events-auto flex items-center gap-3 bg-gray-900/95 backdrop-blur-md border px-4 py-3 rounded-xl shadow-2xl max-w-sm ${
              t.type === 'success'
                ? 'border-emerald-500/50 text-emerald-300'
                : 'border-purple-500/50 text-purple-300'
            }`}
          >
            <span
              className={`w-2 h-2 rounded-full shrink-0 ${
                t.type === 'success' ? 'bg-emerald-400' : 'bg-purple-400'
              }`}
            />
            <span className="text-sm font-bold text-gray-100">{t.message}</span>
          </div>
        ))}
      </div>

      {/* Container chính */}
      <div className="max-w-7xl mx-auto">
        {/* Thanh điều khiển giao diện */}
        <header className="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
          <div>
            <span className="text-xs font-bold tracking-wider uppercase text-purple-300 bg-purple-950/70 border border-purple-600/50 px-3 py-1 rounded-full">
              Hệ Sinh Thái Enterprise 2.0
            </span>
            <h1 className="studio-title text-2xl sm:text-3xl font-bold text-gray-100 mt-2 tracking-tight">
              Bảng Điều Khiển Hệ Thống Nghiệp Vụ
            </h1>
          </div>

          <div className="flex flex-wrap items-center gap-2.5 text-white">
            <button
              type="button"
              onClick={toggleThemeMode}
              className="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gray-800/85 hover:bg-gray-700 border border-gray-700 text-xs sm:text-sm font-bold cursor-pointer shadow-md"
            >
              {isLightMode ? (
                <Moon className="w-4 h-4 text-amber-400" />
              ) : (
                <Sun className="w-4 h-4 text-amber-400" />
              )}
              <span>{isLightMode ? 'Giao diện Tối' : 'Giao diện Sáng'}</span>
            </button>
          </div>
        </header>

        {/* Lưới Bento Grid chứa 12 thẻ hệ thống */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 grid-flow-dense items-start">
          {ENTERPRISE_SYSTEMS_LIST.map((sys) => {
            const bentoStyle = BENTO_SYSTEM_STYLES[sys.id] || BENTO_SYSTEM_STYLES.sdp;
            return (
              <SystemBentoCard
                key={sys.id}
                sys={sys}
                bentoStyle={bentoStyle}
                isExpanded={expandedId === sys.id}
                onToggleExpand={handleToggleExpand}
                onCollapse={handleCollapse}
                showToast={showToast}
              />
            );
          })}
        </div>
      </div>
    </div>
  );
}