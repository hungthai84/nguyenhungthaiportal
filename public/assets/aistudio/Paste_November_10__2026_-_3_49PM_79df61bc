<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f4f5ff" />
  <title>Học vấn & phát triển chuyên môn | Nguyễn Hùng Thái</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Play:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: #262443;
      --muted: #74738f;
      --line: rgba(115, 111, 169, .15);
      --surface: rgba(255,255,255,.62);
      --shadow: 0 16px 42px rgba(100, 91, 159, .12);
      --radius: 18px;
      --ease: cubic-bezier(.2,.8,.2,1);
      --glass-border: rgba(255,255,255,.88);
      --glass-blur: blur(18px) saturate(155%);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      font-family: 'Play', sans-serif;
      background:
        radial-gradient(ellipse at 5% 8%, rgba(255, 164, 197, .52), transparent 29rem),
        radial-gradient(ellipse at 96% 5%, rgba(116, 199, 255, .48), transparent 31rem),
        radial-gradient(ellipse at 82% 76%, rgba(188, 160, 255, .40), transparent 30rem),
        radial-gradient(ellipse at 20% 92%, rgba(255, 215, 145, .38), transparent 27rem),
        radial-gradient(ellipse at 53% 46%, rgba(142, 235, 211, .20), transparent 34rem),
        linear-gradient(135deg, #fff8fc 0%, #f4f5ff 38%, #effaff 72%, #fff8ee 100%);
      background-attachment: fixed;
      background-size: cover;
    }
    button, input { font: inherit; }
    button, input, textarea, select { font-family:'Play',sans-serif; }
    button { cursor: pointer; }
    svg { display:block; }
    .page-shell { width: min(1440px, calc(100% - 48px)); margin: 0 auto; padding: 28px 0 56px; }
    .topbar { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom: 36px; }
    .identity { display:flex; align-items:center; gap:12px; min-width:0; }
    .monogram {
      width: 46px; height: 46px; border-radius: 15px; display:grid; place-items:center;
      color:#fff; font-size:14px; font-weight:700; letter-spacing:.5px;
      background: linear-gradient(135deg,#6a9cff,#a68cff 55%,#f2a5c3);
      box-shadow: 0 9px 22px rgba(126,132,231,.28);
    }
    .identity-name { font-size:14px; font-weight:700; }
    .identity-role { color:var(--muted); font-size:11px; margin-top:3px; }
    .top-note { display:flex; align-items:center; gap:8px; color:#696b85; font-size:12px; padding:9px 13px; border-radius:999px; background:rgba(255,255,255,.58); border:1px solid var(--glass-border); backdrop-filter:var(--glass-blur); box-shadow:0 8px 24px rgba(95,90,155,.07); }
    .top-note span { width:7px; height:7px; border-radius:50%; background:#59c99b; box-shadow:0 0 0 4px rgba(89,201,155,.13); }
    .hero { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:end; gap:24px; margin-bottom:26px; }
    .eyebrow { display:inline-flex; align-items:center; gap:8px; color:#7476a0; font-size:11px; font-weight:700; letter-spacing:1.55px; text-transform:uppercase; margin-bottom:12px; }
    .eyebrow:before { content:""; width:22px; height:2px; border-radius:5px; background:linear-gradient(90deg,#68a8ff,#c59af5); }
    h1 { margin:0; max-width:760px; font-size:clamp(29px,4vw,48px); line-height:1.08; letter-spacing:-1.4px; font-weight:700; }
    .hero p { margin:14px 0 0; max-width:790px; color:#686b86; font-size:14px; line-height:1.7; }
    .service-label { display:inline-flex; margin-top:15px; align-items:center; gap:8px; color:#654ab2; background:linear-gradient(110deg,rgba(255,222,239,.78),rgba(226,220,255,.76),rgba(214,242,255,.78)); border:1px solid rgba(255,255,255,.9); border-radius:999px; padding:9px 14px; font-size:12px; font-weight:700; box-shadow:0 8px 20px rgba(149,116,205,.10); backdrop-filter:var(--glass-blur); }
    .service-label svg { width:15px;height:15px; }
    .hero-mark { width:134px; height:134px; border-radius:34px; display:grid; place-items:center; position:relative; overflow:hidden; background:linear-gradient(145deg,rgba(255,255,255,.78),rgba(224,220,255,.56),rgba(208,241,255,.60)); border:1px solid var(--glass-border); box-shadow:var(--shadow); backdrop-filter:var(--glass-blur); }
    .hero-mark:before,.hero-mark:after { content:""; position:absolute; border-radius:50%; filter:blur(1px); }
    .hero-mark:before { width:94px;height:94px;right:-19px;top:-24px;background:rgba(255,183,210,.6); }
    .hero-mark:after { width:78px;height:78px;left:-19px;bottom:-21px;background:rgba(130,191,255,.56); }
    .hero-mark strong { position:relative; z-index:1; color:#6970b2; font-size:29px; letter-spacing:-2px; }
    .metrics { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; margin:26px 0 30px; }
    .metric { min-height:80px; display:flex; align-items:center; gap:12px; padding:15px 17px; border-radius:16px; background:rgba(255,255,255,.57); border:1px solid var(--glass-border); box-shadow:0 10px 26px rgba(89,93,147,.07); backdrop-filter:var(--glass-blur); transition:transform .25s var(--ease),box-shadow .25s var(--ease); }
    .metric:hover { transform:translateY(-3px);box-shadow:0 15px 32px rgba(89,93,147,.12); }
    .metric-icon { width:39px;height:39px;flex:0 0 39px;border-radius:13px;display:grid;place-items:center; }
    .metric-icon svg { width:19px;height:19px;stroke-width:2.1; }
    .metric:nth-child(1) .metric-icon{background:linear-gradient(135deg,#dce9ff,#e9e1ff);color:#5d70c7}.metric:nth-child(2) .metric-icon{background:linear-gradient(135deg,#ffe0ec,#ffeede);color:#c35e8b}.metric:nth-child(3) .metric-icon{background:linear-gradient(135deg,#d8f6e8,#dff5f8);color:#268f7b}.metric:nth-child(4) .metric-icon{background:linear-gradient(135deg,#fff0d3,#ffe5d8);color:#bd7a37}
    .metric strong { display:block; font-size:20px; line-height:1.1; }
    .metric span:last-child { display:block; color:var(--muted); font-size:11px; margin-top:5px; }
    .section-toolbar { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:15px; }
    .section-title { font-size:16px; font-weight:700; }
    .section-hint { font-size:11px; color:var(--muted); margin-top:4px; }
    .toolbar-right { display:flex; align-items:center; gap:10px; }
    .search-wrap { position:relative; }
    .search-wrap svg { position:absolute; left:13px;top:50%;transform:translateY(-50%);width:15px;height:15px;color:#9294ac;pointer-events:none; }
    .search { width:210px; height:39px; outline:none; border:1px solid var(--glass-border); background:rgba(255,255,255,.66); backdrop-filter:var(--glass-blur); border-radius:12px; padding:0 13px 0 36px; color:var(--ink); font-size:12px; box-shadow:0 7px 18px rgba(91,94,145,.06); }
    .search:focus { border-color:rgba(130,153,255,.7); box-shadow:0 0 0 3px rgba(130,153,255,.13); }
    .filters { display:flex; gap:7px; flex-wrap:wrap; margin-bottom:19px; }
    .filter-btn { border:1px solid var(--glass-border); background:rgba(255,255,255,.54); backdrop-filter:var(--glass-blur); color:#777991; padding:8px 12px; border-radius:999px; font-size:11px; transition:all .22s var(--ease); box-shadow:0 5px 14px rgba(91,94,145,.035); }
    .filter-btn:hover { transform:translateY(-1px); background:#fff; }
    .filter-btn.active { color:#fff; background:linear-gradient(110deg,#779bfa,#a58be8); border-color:transparent; box-shadow:0 6px 15px rgba(131,139,226,.22); }
    .course-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); grid-auto-rows:240px; gap:15px; align-items:stretch; }
    .course-grid.is-expanded { grid-template-columns:minmax(0,1fr); grid-auto-rows:auto; }
    .course-card { min-width:0; height:100%; position:relative; border-radius:var(--radius); background:linear-gradient(145deg,color-mix(in srgb,var(--tint) 48%,white),rgba(255,255,255,.60)); border:1px solid var(--glass-border); box-shadow:var(--shadow); overflow:hidden; transition:box-shadow .35s var(--ease), border-color .35s var(--ease),background .35s var(--ease); isolation:isolate; backdrop-filter:var(--glass-blur); }
    .course-card:hover { box-shadow:0 18px 40px color-mix(in srgb,var(--accent) 17%,transparent); border-color:color-mix(in srgb,var(--accent) 38%,white); background:linear-gradient(145deg,color-mix(in srgb,var(--tint) 62%,white),rgba(255,255,255,.72)); }
    .course-card.expanded { display:grid; grid-template-rows:minmax(0,1fr); grid-column:1 / -1; grid-row:auto; height:calc(240px * 3 + 15px * 2); min-height:calc(240px * 3 + 15px * 2); z-index:4; box-shadow:0 22px 55px rgba(77,82,145,.17); border-color:rgba(169,180,255,.72); }
    .card-front { display:flex; width:100%; height:100%; padding:12px; text-align:left; color:inherit; border:0; background:transparent; flex-direction:column; position:relative; }
    .card-topline { display:flex; align-items:center; justify-content:flex-end; gap:8px; margin-bottom:9px; min-height:22px; }
    .category-pill { display:inline-flex; align-items:center; gap:5px; max-width:75%; padding:5px 8px; border-radius:999px; background:linear-gradient(120deg,var(--tint),rgba(255,255,255,.76)); color:var(--accent); font-size:9px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .category-pill svg { width:12px;height:12px;flex:0 0 12px;stroke-width:2.1; }
    .year-pill { position:absolute; left:12px; top:12px; z-index:2; display:inline-flex; align-items:center; justify-content:center; gap:6px; min-width:78px; padding:6px 10px; border-radius:999px; color:var(--accent); background:rgba(255,255,255,.88); border:1px solid rgba(255,255,255,.96); box-shadow:0 4px 12px rgba(85,88,140,.08); backdrop-filter:blur(10px); font-size:12px; font-weight:700; }
    .year-pill svg { width:14px;height:14px;flex:0 0 14px;stroke-width:2.2; }
    .card-banner { width:100%; height:88px; flex:0 0 88px; border-radius:12px; overflow:hidden; position:relative; background:linear-gradient(125deg,var(--tint),#fff); }
    .card-banner img { width:100%;height:100%;object-fit:cover;display:block; transition:transform .5s var(--ease); }
    .course-card:hover .card-banner img { transform:scale(1.045); }
    .banner-fallback { position:absolute;inset:0;display:grid;place-items:center;color:var(--accent);background:linear-gradient(130deg,var(--tint),rgba(255,255,255,.7)); }
    .banner-fallback svg { width:30px;height:30px;stroke-width:1.6;opacity:.8; }
    .card-title-row { display:flex; align-items:center; gap:8px; min-width:0; margin:10px 0 4px; }
    .card-title-icon { width:30px;height:30px;flex:0 0 30px;display:grid;place-items:center;border-radius:9px;color:var(--accent);background:linear-gradient(135deg,var(--tint),rgba(255,255,255,.88));border:1px solid rgba(255,255,255,.9);box-shadow:0 3px 9px rgba(89,91,145,.06); }
    .card-title-icon svg { width:16px;height:16px;stroke-width:2.5; }
    .card-title { min-width:0; margin:0; font-size:16px; line-height:1.28; font-weight:700; display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden; }
    .card-institution { color:#666b86; font-size:15px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .card-bottom { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-top:auto; padding-top:9px; }
    .card-kind { color:#74778f; font-size:15px; line-height:1.2; }
    .open-hint { color:var(--accent); font-size:11px; font-weight:700; display:inline-flex; align-items:center; gap:5px; }
    .open-hint b { display:inline-flex;align-items:center;font-size:15px;font-weight:400;transition:transform .2s; }
    .open-hint b svg { width:14px;height:14px; }
    .course-card:hover .open-hint b { transform:translate(2px,-2px); }
    .detail-view { display:none; height:100%; padding:16px; min-height:0; }
    .course-card.expanded .card-front { display:none; }
    .course-card.expanded .detail-view { display:flex; height:auto; min-height:0; flex-direction:column; gap:15px; }
    .course-card.expanded .detail-head { animation:detailReveal .62s .12s both; }
    .course-card.expanded .detail-bento { animation:detailReveal .72s .24s both; }
    .course-card.expanded .detail-foot { animation:detailReveal .58s .38s both; }
    @keyframes detailReveal { from { opacity:0; transform:translateY(13px); filter:blur(4px); } to { opacity:1; transform:translateY(0); filter:blur(0); } }
    .detail-head { display:flex; align-items:center; justify-content:space-between; gap:14px; min-height:43px; }
    .detail-head-main { min-width:0; display:flex; align-items:center; gap:10px; }
    .detail-symbol { width:38px;height:38px;flex:0 0 38px;border-radius:13px;display:grid;place-items:center;background:linear-gradient(135deg,var(--tint),rgba(255,255,255,.92));color:var(--accent);box-shadow:inset 0 0 0 1px rgba(255,255,255,.75); }
    .detail-symbol svg { width:20px;height:20px;stroke-width:1.9; }
    .detail-heading { min-width:0; }
    .detail-heading h2 { margin:0; font-size:16px; line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .detail-heading p { margin:4px 0 0; color:var(--muted); font-size:15px; }
    .detail-actions { display:flex; align-items:center; gap:8px; flex:0 0 auto; }
    .detail-chip { background:var(--tint); color:var(--accent); border-radius:999px; padding:7px 10px; font-size:10px; font-weight:700; white-space:nowrap; }
    .close-detail { display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--line);border-radius:11px;background:rgba(255,255,255,.72);backdrop-filter:var(--glass-blur);color:#74768f;transition:all .2s; }
    .close-detail svg { width:17px;height:17px; }
    .close-detail:hover { background:#fff0f3;color:#d45b82;transform:rotate(90deg); }
    .detail-bento { flex:1; min-height:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); grid-template-rows:repeat(2,minmax(0,1fr)); gap:15px; }
    .detail-tile { min-width:0; min-height:0; overflow:auto; border-radius:13px; padding:11px 12px; border:1px solid rgba(255,255,255,.84); box-shadow:inset 0 1px 0 rgba(255,255,255,.45),0 5px 15px rgba(95,93,150,.045); backdrop-filter:blur(12px) saturate(135%); scrollbar-width:thin; scrollbar-color:rgba(113,123,178,.25) transparent; }
    .detail-tile h3 { display:flex;align-items:center;gap:8px;margin:0 0 10px;font-size:16px;line-height:1.2;font-weight:700; }
    .tile-icon { width:30px;height:30px;flex:0 0 30px;display:grid;place-items:center;border-radius:8px;background:rgba(255,255,255,.75);color:#656b91;box-shadow:0 2px 8px rgba(73,78,130,.06); }
    .tile-icon svg { width:16px;height:16px;stroke-width:2.4; }
    .detail-tile p { margin:0; color:#4e5572; font-size:15px; line-height:1.5; }
    .tile-overview { background:linear-gradient(135deg,rgba(210,225,255,.91),rgba(235,226,255,.78)); }
    .tile-goal { background:linear-gradient(135deg,rgba(255,215,231,.88),rgba(255,235,213,.82)); }
    .tile-curriculum { background:linear-gradient(135deg,rgba(204,244,226,.90),rgba(211,242,250,.82)); }
    .tile-skills { background:linear-gradient(135deg,rgba(255,232,184,.91),rgba(255,244,214,.84)); }
    .tile-application { background:linear-gradient(135deg,rgba(222,213,255,.91),rgba(243,222,255,.82)); }
    .tile-proof { background:linear-gradient(135deg,rgba(204,232,255,.91),rgba(216,247,250,.84)); }
    .meta-grid { display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:12px; }
    .meta-item { padding:6px 7px;border-radius:8px;background:rgba(255,255,255,.56); }
    .meta-item small { display:block;color:#747990;font-size:12px;margin-bottom:4px; }
    .meta-item strong { display:block;font-size:15px;line-height:1.25;color:#454a68; }
    .mini-list { margin:0;padding:0 0 0 18px;color:#4e5572;font-size:15px;line-height:1.42; }
    .mini-list li { margin:0 0 5px; }
    .tags { display:flex;flex-wrap:wrap;gap:5px;margin-top:7px; }
    .tags span { font-size:13px;padding:4px 6px;border-radius:7px;background:rgba(255,255,255,.68);color:#5f6786; }
    .proof-row { display:flex;align-items:flex-start;gap:12px;margin-top:12px; }
    .proof-thumb { width:116px;height:86px;flex:0 0 116px;border-radius:8px;object-fit:contain;padding:4px;background:rgba(255,255,255,.82);border:1px solid rgba(255,255,255,.95); }
    .proof-image-link { display:block;flex:0 0 auto;border-radius:9px;line-height:0;transition:transform .2s var(--ease),box-shadow .2s var(--ease); }
    .proof-image-link:hover,.proof-image-link:focus-visible { transform:translateY(-2px);box-shadow:0 8px 18px rgba(65,92,150,.18);outline:2px solid rgba(100,133,220,.45);outline-offset:2px; }
    .proof-copy { min-width:0; }
    .proof-missing { display:grid;place-items:center;width:116px;min-height:86px;flex:0 0 116px;border-radius:8px;background:rgba(255,255,255,.58);color:#777b98;font-size:12px;text-align:center;padding:8px; }
    .proof-copy strong { display:block;color:#3f5578;font-size:15px;line-height:1.3; }
    .proof-copy span { display:block;color:#7a8298;font-size:13px;margin-top:4px;line-height:1.35; }
    .detail-foot { display:flex;align-items:center;justify-content:space-between;gap:10px;color:#898ba1;font-size:8px; }
    .detail-foot strong {color:#777b98;font-size:9px;}
    .empty-state { display:none; padding:34px; text-align:center; color:#777991; background:rgba(255,255,255,.6); border:1px dashed rgba(126,132,181,.3); border-radius:16px; font-size:13px; }
    .page-footer { display:flex;justify-content:space-between;gap:12px;margin-top:27px;padding-top:16px;border-top:1px solid rgba(122,125,169,.13);color:#9698ac;font-size:10px; }
    @media (max-width: 980px) {
      .page-shell { width:min(100% - 32px, 840px); }
      .course-grid { grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:235px;gap:15px; }
      .course-card.expanded { height:calc(235px * 5 + 15px * 4); min-height:calc(235px * 5 + 15px * 4); }
      .detail-bento { grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(3,minmax(0,1fr));gap:15px; }
      .hero-mark { width:110px;height:110px; }
    }
    @media (max-width: 640px) {
      .page-shell { width:calc(100% - 24px);padding-top:17px; }
      .topbar { margin-bottom:27px; }
      .top-note { display:none; }
      .hero { grid-template-columns:1fr; }
      .hero-mark { display:none; }
      h1 { font-size:34px; }
      .hero p { font-size:12px; }
      .metrics { grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:20px 0 25px; }
      .metric { min-height:70px;padding:11px;gap:9px; }
      .metric-icon { width:34px;height:34px;flex-basis:34px; }
      .metric strong { font-size:17px; }
      .section-toolbar { align-items:flex-start;flex-direction:column; }
      .toolbar-right,.search-wrap,.search { width:100%; }
      .course-grid { grid-template-columns:1fr;grid-auto-rows:235px;gap:15px; }
      .course-card.expanded { height:calc(235px * 9 + 15px * 8); min-height:calc(235px * 9 + 15px * 8); }
      .detail-view { padding:11px; }
      .detail-head { align-items:flex-start; }
      .detail-heading h2 { white-space:normal;font-size:16px; }
      .detail-heading p { font-size:13px; }
      .detail-actions { gap:5px; }
      .detail-chip { display:none; }
      .detail-bento { grid-template-columns:1fr;grid-template-rows:repeat(6,minmax(0,1fr));gap:15px; }
      .detail-tile { padding:12px 13px; }
      .proof-thumb { width:94px;height:74px;flex-basis:94px; }
      .proof-missing { width:94px;min-height:74px;flex-basis:94px; }
      .detail-tile p { font-size:15px; }
      .mini-list { font-size:15px; }
      .page-footer { flex-direction:column; }
    }
    @media (prefers-reduced-motion: reduce) {
      *,*::before,*::after { scroll-behavior:auto !important;transition-duration:.01ms !important;animation-duration:.01ms !important; }
    }
  </style>
</head>
<body>
  <main class="page-shell">
    <header class="topbar">
      <div class="identity">
        <div class="monogram">NHT</div>
        <div>
          <div class="identity-name">Nguyễn Hùng Thái</div>
          <div class="identity-role">Hồ sơ năng lực · Customer Experience & Operations</div>
        </div>
      </div>
      <div class="top-note"><span></span> Hồ sơ học vấn được cập nhật</div>
    </header>

    <section class="hero">
      <div>
        <div class="eyebrow">Education & professional development</div>
        <h1>Học vấn & phát triển chuyên môn</h1>
        <p>Nền tảng Công nghệ thông tin kết hợp cùng quản trị, dữ liệu, vận hành và trải nghiệm khách hàng. Mỗi chương trình học được kết nối với năng lực ứng dụng thực tế trong xây dựng hệ thống và điều hành dịch vụ.</p>
        <div class="service-label"><i data-lucide="headset"></i> Dịch Vụ Khách Hàng</div>
      </div>
      <div class="hero-mark" aria-hidden="true"><strong>HT.</strong></div>
