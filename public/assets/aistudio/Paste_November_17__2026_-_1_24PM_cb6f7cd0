                      {/* Top Badge & Phân Quyền Selector */}
                      <div className="flex items-center justify-between w-full mb-1 gap-1.5 sm:gap-2">
                        <span className="px-2 py-0.5 rounded-full bg-blue-700 text-white text-[9.5px] sm:text-[10px] font-black border border-blue-400 flex items-center gap-1 shadow-xs shrink-0">
                          <span className="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span> 9.1 TRUNG TÂM
                        </span>

                        <div
                          className="flex items-center gap-1 bg-white border-2 border-blue-500 px-1.5 py-0.5 rounded-[10px] shadow-xs"
                          onClick={e => e.stopPropagation()}
                        >
                          <ShieldCheck className="w-3 h-3 text-blue-700 shrink-0" />
                          <span className="text-[9px] sm:text-[10px] font-black text-slate-800 uppercase">Quyền:</span>
                          <select
                            value={currentRole}
                            onChange={e => {
                              setCurrentRole(e.target.value);
                              showToast(`Đã chuyển sang phân quyền: ${SDP_ROLES[e.target.value].title}`);
                            }}
                            className="text-[9px] sm:text-[10px] font-black text-blue-950 bg-transparent border-0 outline-none cursor-pointer"
                          >
                            <option value="admin">Quản trị viên (Admin Toàn quyền)</option>
                            <option value="lead">Trưởng nhóm CSKH (Lead)</option>
                            <option value="agent">Tư vấn viên (Agent)</option>
                          </select>
                        </div>
                      </div>

                      {/* Main Identity */}
                      <div className="flex items-center gap-2.5 sm:gap-3 my-0.5 sm:my-1">
                        <div className="w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-700 text-white flex items-center justify-center shadow-lg shadow-blue-500/40 group-hover:scale-105 transition-transform p-1.5 shrink-0 border-2 border-white">
                          <Layers className="w-5 h-5" />
                        </div>
                        <div className="text-left">
                          <h2 className="text-xl sm:text-2xl font-black text-slate-950 tracking-tight leading-none">SDP</h2>
                          <p className="text-[10px] sm:text-[11px] text-blue-900 font-black font-mono mt-0.5">Service Delivery Platform</p>
                          <p className="text-[10px] sm:text-[11px] text-slate-900 font-extrabold">Cổng làm việc CSKH</p>
                        </div>
                      </div>

                      <p className="text-[10px] sm:text-[11px] text-slate-900 font-bold mt-0.5 leading-tight px-1 hidden sm:block">
                        Trang làm việc chính của Phòng CSKH, cổng truy cập tập trung để sử dụng toàn bộ các hệ thống nghiệp vụ (Single Agent Workspace & SSO).
                      </p>

                      {/* Core 4 Capabilities Chips */}
                      <div className="mt-1.5 grid grid-cols-2 gap-1 sm:gap-1.5 w-full text-left text-[9.5px] sm:text-[10.5px]">
                        <div className="bg-white p-1 sm:p-1.5 rounded-[10px] border border-blue-400 shadow-xs">
                          <div className="font-black text-blue-900 flex items-center gap-1">
                            <KeyRound className="w-2.5 h-2.5 text-blue-700" /> SSO & Portal
                          </div>
                          <span className="text-[8.5px] sm:text-[9.5px] text-slate-800 font-extrabold">Đăng nhập tập trung</span>
                        </div>
                        <div className="bg-white p-1 sm:p-1.5 rounded-[10px] border border-cyan-400 shadow-xs">
                          <div className="font-black text-cyan-900 flex items-center gap-1">
                            <GitMerge className="w-2.5 h-2.5 text-cyan-700" /> Hub Tích Hợp
                          </div>
                          <span className="text-[8.5px] sm:text-[9.5px] text-slate-800 font-extrabold">Chuyển tiếp Data</span>
                        </div>
                        <div className="bg-white p-1 sm:p-1.5 rounded-[10px] border border-indigo-400 shadow-xs">
                          <div className="font-black text-indigo-900 flex items-center gap-1">
                            <Bot className="w-2.5 h-2.5 text-indigo-700" /> AI Workspace
                          </div>
                          <span className="text-[8.5px] sm:text-[9.5px] text-slate-800 font-extrabold">Bàn làm việc Agent</span>
                        </div>
                        <div className="bg-white p-1 sm:p-1.5 rounded-[10px] border border-emerald-400 shadow-xs">
                          <div className="font-black text-emerald-900 flex items-center gap-1">
                            <Gauge className="w-2.5 h-2.5 text-emerald-700" /> Giám Sát Realtime
                          </div>
                          <span className="text-[8.5px] sm:text-[9.5px] text-slate-800 font-extrabold">Điều phối luồng việc</span>
                        </div>
                      </div>

                      {/* Phân quyền hiện hành */}
                      <div className="mt-1.5 w-full px-2 py-0.5 sm:py-1 bg-blue-100/95 border-2 border-blue-400 rounded-[10px] text-left text-[9px] sm:text-[10px] text-blue-950 flex items-center justify-between shadow-xs">
                        <span className="flex items-center gap-1 font-black">
                          <Lock className="w-2.5 h-2.5 text-blue-800" />
                          <span>Quyền: {currentRoleData.title}</span>
                        </span>
                        <span className="px-1.5 py-0.2 rounded bg-blue-800 text-white font-mono text-[8.5px] font-black">
                          {currentRoleData.badge}
                        </span>
                      </div>

                      {/* Footer Quick info */}
                      <div className="mt-1 pt-1 border-t border-blue-400/80 w-full flex items-center justify-between text-[9.5px] sm:text-[10.5px] text-blue-950 font-black">
                        <span className="flex items-center gap-1 truncate">
                          <ExternalLink className="w-2.5 h-2.5" /> sdp.powerservice.one
                        </span>
                        <span className="text-slate-900 font-extrabold text-[8.5px] sm:text-[9.5px] shrink-0">
                          Bấm: Chi tiết | Kéo: Đổi chỗ
                        </span>
                      </div>
                    </div>
                  </div>

                  {/* TẦNG DƯỚI (NAM): 9.10 BI DASHBOARD */}
                  <div className="w-full flex items-center justify-center shrink-0 pb-2">
                    {renderSatelliteCard('BI', 'theme-bi', 'bg-emerald-900', 'text-emerald-700', 'text-emerald-800', true)}
                  </div>
                </div>

                {/* CỘT PHẢI (ĐÔNG): 4 Hệ Thống Quản Trị & Vận Hành Doanh Nghiệp (Tạo lề ngoài bên phải cho đường liên hệ thống) */}
                <div className="col-span-12 md:col-span-3 flex flex-col justify-between h-full py-1 sm:py-1.5 min-h-0 pr-0 md:pr-12 lg:pr-14">
                  <div className="flex flex-col justify-around items-end flex-1 gap-2 sm:gap-2.5 py-1 sm:py-2 min-h-0">
                    {renderSatelliteCard('ERP', 'theme-erp', 'bg-purple-900', 'text-purple-700', 'text-purple-800')}
                    {renderSatelliteCard('HRM', 'theme-hrm', 'bg-pink-900', 'text-pink-700', 'text-pink-800')}
                    {renderSatelliteCard('BPM', 'theme-bpm', 'bg-indigo-900', 'text-indigo-700', 'text-indigo-800')}
                    {renderSatelliteCard('OKR', 'theme-okr', 'bg-orange-900', 'text-orange-700', 'text-orange-800')}
                  </div>
                </div>
              </div>
            </div>
          )}
        </main>
      </div>

      {/* MODAL: CHI TIẾT HỆ THỐNG */}
      {selectedSystem && (
        <div
          onClick={() => setSelectedSystemKey(null)}
          className="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-3"
        >
          <div
            onClick={e => e.stopPropagation()}
            className="bg-white/95 backdrop-blur-xl border border-slate-300 w-full max-w-xl rounded-[14px] shadow-2xl overflow-hidden flex flex-col max-h-[90vh]"
          >
            {/* Modal Header */}
            <div className="p-4 border-b border-slate-200 bg-gradient-to-r from-blue-50/90 via-white to-slate-50 flex items-start justify-between">
              <div className="flex items-center gap-3">
                <div
                  style={{ backgroundColor: selectedSystem.color }}
                  className="w-12 h-12 rounded-full text-white flex items-center justify-center shadow-md"
                >
                  <DynamicIcon name={selectedSystem.icon} className="w-5 h-5" />
                </div>
                <div>
                  <div className="flex items-center gap-2">
                    <span className="text-[10px] font-mono px-2 py-0.2 rounded bg-blue-100 text-blue-900 font-bold">
                      {selectedSystem.code}
                    </span>
                    <span className="text-xs text-slate-600 font-mono font-bold">{selectedSystem.full}</span>
                  </div>
                  <h3 className="text-base font-black text-slate-950 mt-0.5">
                    {selectedSystem.abbr} - {selectedSystem.name}
                  </h3>
                </div>
              </div>
              <button
                onClick={() => setSelectedSystemKey(null)}
                className="w-7 h-7 rounded-[10px] bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-900 flex items-center justify-center transition-colors"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            {/* Modal Body */}
            <div className="p-4 space-y-3.5 text-xs overflow-y-auto no-scrollbar">
              <div>
                <label className="text-[10px] font-extrabold text-slate-600 uppercase tracking-wider block mb-1">
                  Mô tả tổng quan
                </label>
                <p className="text-slate-800 font-medium leading-relaxed bg-slate-50 p-2.5 rounded-[10px] border border-slate-200">
                  {selectedSystem.desc}
                </p>
              </div>

              <div>
                <label className="text-[10px] font-extrabold text-slate-600 uppercase tracking-wider block mb-1">
                  Tính năng chính
                </label>
                <ul className="space-y-1.5 text-slate-800">
                  {selectedSystem.features.map((feat, idx) => (
                    <li key={idx} className="flex items-start gap-2 font-medium">
                      <CheckCircle className="w-3.5 h-3.5 text-blue-700 mt-0.5 shrink-0" />
                      <span className="text-slate-900 leading-normal">{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <label className="text-[10px] font-extrabold text-slate-600 uppercase tracking-wider block mb-1">
                  Luồng Dữ Liệu Tương Tác Với Hệ Sinh Thái
                </label>
                <div className="bg-blue-50/70 border border-blue-200 p-2.5 rounded-[10px] space-y-1.5">
                  {selectedSystem.flows?.map((fl, idx) => (
                    <div key={idx} className="flex items-start gap-2 border-b border-blue-200 pb-1.5 last:border-b-0 last:pb-0">
                      <span className="px-1.5 py-0.2 rounded bg-blue-200 text-blue-950 font-mono text-[9px] font-extrabold shrink-0">
                        {fl.type}
                      </span>
                      <div>
                        <span className="font-extrabold text-slate-900">{fl.to}:</span>
                        <span className="text-slate-700 ml-1 font-medium">{fl.desc}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              {/* URL & Access Link */}
              <div className="pt-2 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div>
                  <span className="text-slate-600 text-[11px] font-bold">Đường dẫn hệ thống:</span>
                  <div className="font-mono text-blue-800 font-bold select-all text-xs">
                    {selectedSystem.isPending ? (
                      <span className="text-amber-700 font-bold italic">{selectedSystem.url}</span>
                    ) : (
                      <a href={selectedSystem.url} target="_blank" rel="noopener noreferrer" className="hover:underline font-bold">
                        {selectedSystem.url}
                      </a>
                    )}
                  </div>
                </div>
                {!selectedSystem.isPending && (
                  <div className="flex items-center gap-2">
                    <button
                      onClick={() => handleCopyUrl(selectedSystem.url)}
                      className="px-3 py-1.5 rounded-[10px] bg-slate-100 hover:bg-slate-200 text-slate-800 font-extrabold transition-colors flex items-center gap-1 border border-slate-300"
                    >
                      <Copy className="w-3.5 h-3.5" /> Sao chép URL
                    </button>
                    <a
                      href={selectedSystem.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      className="px-3.5 py-1.5 rounded-[10px] bg-blue-600 hover:bg-blue-700 text-white font-extrabold transition-colors flex items-center gap-1 shadow-sm"
                    >
                      <span>Mở website</span>
                      <ExternalLink className="w-3.5 h-3.5" />
                    </a>
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      )}

      {/* TOAST NOTIFICATION */}
      <div
        className={`fixed bottom-4 right-4 z-50 bg-slate-950/95 backdrop-blur text-white px-3.5 py-2 rounded-[14px] shadow-xl flex items-center gap-2 text-xs font-bold transition-all duration-300 ${
          toastMsg ? 'opacity-100 translate-y-0' : 'opacity-0 pointer-events-none translate-y-2'
        }`}
      >
        <CheckCircle className="w-4 h-4 text-emerald-400" />
        <span>{toastMsg}</span>
      </div>
    </div>
  );
}