        {/* SUB-BAR METRICS & LINE GROUP FILTER */}
        <div className="bg-white/95 border-b border-slate-300/80 px-3.5 sm:px-4 py-1 text-[11px] text-slate-800 font-bold flex flex-wrap items-center justify-between shrink-0 gap-1.5">
          <div className="flex items-center gap-1 flex-wrap">
