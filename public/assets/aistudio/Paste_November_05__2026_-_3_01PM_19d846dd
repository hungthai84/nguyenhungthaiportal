    hrm: { text: 'Hoạt động', dotColor: 'bg-emerald-400' },
    bpm: { text: 'Hoạt động', dotColor: 'bg-emerald-400' },
    okr: { text: 'Hoạt động', dotColor: 'bg-emerald-400' },
    clp: { text: 'Hoạt động', dotColor: 'bg-emerald-400' },
    lms: { text: 'Hoạt động', dotColor: 'bg-emerald-400' },
    csc: { text: 'Hoạt động', dotColor: 'bg-emerald-400' },
    bi: { text: 'Đang tích hợp API', dotColor: 'bg-amber-400' },
    ai: { text: 'AI Trực Tuyến', dotColor: 'bg-fuchsia-400' },
    pos: { text: 'Hoạt động', dotColor: 'bg-emerald-400' },
  };

  return (
    <section
      id="systems"
      className="relative w-full h-full max-h-full flex flex-col justify-start items-stretch font-sans text-slate-800 dark:text-slate-100 transition-colors duration-500 select-none bg-transparent overflow-hidden text-left"
    >
      {/* 100% Matching Animation CSS Rules */}
      <style
        dangerouslySetInnerHTML={{
          __html: `
        @keyframes icon-floating {
          0%, 100% {
            transform: translateY(0px) rotate(0deg) scale(1);
          }
          50% {
            transform: translateY(-5px) rotate(2deg) scale(1.07);
          }
        }

        .animated-service-icon {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          animation: icon-floating 3.2s ease-in-out infinite;
          filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.28));
          transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .system-item:hover .animated-service-icon {
          transform: scale(1.15) translateY(-3px);
          filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.4));
        }

        .system-flip-wrap {
          perspective: 1000px;
          height: auto;
          min-height: fit-content;
          transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
          will-change: transform;
          box-shadow: none !important;
        }

        .system-flip-wrap:hover {
          transform: translateY(-3px);
        }

        .system-flip-inner {
          position: relative;
          width: 100%;
          height: 100%;
          min-height: fit-content;
          transition: transform 0.65s cubic-bezier(0.34, 1.35, 0.64, 1);
          transform-style: preserve-3d;
          border-radius: 22px;
          box-shadow: none !important;
        }

        .system-flip-inner.is-flipped {
          transform: rotateY(180deg);
        }

        .system-flip-front {
          position: relative;
          width: 100%;
          height: auto;
          min-height: fit-content;
          -webkit-backface-visibility: hidden;
          backface-visibility: hidden;
          border-radius: 26px;
          overflow: hidden;
          transition: border-color 0.3s ease, background 0.3s ease;
          box-shadow: none !important;
          z-index: 2;
          transform: rotateY(0deg) !important;
        }

        .system-flip-back {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          -webkit-backface-visibility: hidden;
          backface-visibility: hidden;
          border-radius: 26px;
          overflow: hidden;
          transition: border-color 0.3s ease, background 0.3s ease;
          box-shadow: none !important;
          transform: rotateY(180deg) !important;
          z-index: 1;
        }

        .system-item {
          border-radius: 26px;
          backdrop-filter: blur(14px);
          -webkit-backdrop-filter: blur(14px);
          transition: border-color 0.3s ease, background 0.3s ease;
          box-shadow: none !important;
        }

        .system-item:hover {
          /* Không áp dụng transform translateY lên system-item vì nó là mặt thẻ lật 3D - Nâng thẻ đã được xử lý an toàn tại .system-flip-wrap:hover */
        }

        @keyframes ring-pulse {
          0% {
            box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.5);
          }
          70% {
            box-shadow: 0 0 0 12px rgba(99, 102, 241, 0);
          }
          100% {
            box-shadow: 0 0 0 0 rgba(99, 102, 241, 0);
          }
        }

        .video-circle-halo {
          animation: ring-pulse 2.2s infinite;
        }

        @keyframes clp-ripple-wave {
          0% {
            transform: scale(0);
            opacity: 1;
          }
          30% {
            opacity: 0.9;
          }
          65% {
            opacity: 0.35;
          }
          100% {
            transform: scale(38);
            opacity: 0;
          }
        }

        @keyframes clp-ring-pulse {
          0% {
            transform: scale(0);
            opacity: 1;
          }
          45% {
            opacity: 0.8;
          }
          100% {
            transform: scale(32);
            opacity: 0;
          }
        }

        .clp-ripple-active .clp-wave-1 {
          animation: clp-ripple-wave 0.85s cubic-bezier(0.12, 0.8, 0.25, 1) forwards;
        }

        .clp-ripple-active .clp-wave-2 {
          animation: clp-ring-pulse 1.05s cubic-bezier(0.12, 0.8, 0.25, 1) 0.1s forwards;
        }

        .clp-ripple-active .clp-wave-3 {
          animation: clp-ring-pulse 1.25s cubic-bezier(0.12, 0.8, 0.25, 1) 0.2s forwards;
        }
      `,
        }}
      />

      <div className="w-full h-full flex-1 flex flex-col gap-[15px] items-stretch justify-start relative z-10 overflow-y-auto no-scrollbar">
        {/* BANNER HỆ THỐNG: Phủ lớp 30% cho nhìn rõ chữ hơn, ẩn khi mở sơ đồ liên kết thẻ */}
        {!isDataFlowModalOpen && (
          <motion.div
            initial={{ opacity: 0, y: -15 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: -15 }}
            transition={{ duration: 0.35 }}
            className="hero-banner w-full h-44 sm:h-52 rounded-2xl overflow-visible relative bg-transparent border-0 shadow-none shrink-0 flex flex-col justify-between p-[10px] z-30"
            style={{ padding: '10px' }}
          >
            <div className="absolute inset-0 rounded-2xl overflow-hidden bg-transparent pointer-events-none">
              <img
                src="https://res.cloudinary.com/q5tpzaxk/image/upload/v1793820835/Gemini_Generated_Image_xcghnmxcghnmxcgh.png"
                alt="Hệ thống vận hành"
                referrerPolicy="no-referrer"
                className="absolute inset-0 w-full h-full object-cover object-center opacity-100 pointer-events-none filter brightness-110 contrast-110 saturate-110"
              />
              {/* Phủ lớp 30% cho nhìn rõ chữ và icon hơn theo yêu cầu */}
              <div className="absolute inset-0 bg-black/30 pointer-events-none" />
            </div>

          {/* Vùng Tiêu Đề: Tiêu đề 18px in đậm đồng bộ, icon đồng bộ 18px; Sub tiêu đề 15px font chữ viết tay nghiêng */}
          <div className="relative z-10 flex flex-col justify-start text-left max-w-2xl" style={{}}>
            <div className="flex items-center gap-2" style={{ color: '#ea580c' }}>
              <span className="inline-flex items-center justify-center">
                <WebIcon
                  name="network"
                  className="shrink-0 bg-transparent border-0 p-0 shadow-none drop-shadow-[0_2px_8px_rgba(234,88,12,0.75)]"
                  style={{ color: '#ea580c', width: '18px', height: '18px' }}
                />
              </span>
              <h1
                className="font-bold font-play tracking-tight drop-shadow-[0_2px_10px_rgba(0,0,0,0.9)] leading-tight"
                style={{ color: '#ea580c', fontSize: '18px', textTransform: 'none' }}
              >
                Hệ thống vận hành
              </h1>
            </div>

            {/* Sub tiêu đề: font chữ Italianno màu chữ vàng */}
            <p
              className="font-handwriting font-italianno text-yellow-300 text-2xl sm:text-3xl font-bold drop-shadow-[0_2px_8px_rgba(0,0,0,0.95)] mt-1.5 select-none"
              style={{ color: '#facc15', fontFamily: "'Italianno', cursive, sans-serif" }}
            >
              &quot;Hệ thống thông minh, vận hành tinh gọn và đồng bộ ♡&quot;
            </p>
          </div>

          {/* Nhóm các nút lại thành 1 filter icon & Sơ đồ liên kết ở bên dưới banner bên trái */}
          <div className="relative z-30 flex items-center justify-start gap-2.5 mt-auto pt-2" ref={filterDropdownRef}>
            <div className="relative inline-block text-left">
              <button
                type="button"
                onClick={() => {
                  SoundEngine.playTap();
                  setIsFilterDropdownOpen((prev) => !prev);
                }}
                className="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/95 hover:bg-white text-orange-900 border border-orange-300 shadow-[0_4px_16px_rgba(0,0,0,0.15)] backdrop-blur-md transition-all cursor-pointer text-xs font-bold font-play active:scale-95 group"
                title="Bộ lọc hệ thống"
                aria-expanded={isFilterDropdownOpen}
                aria-haspopup="listbox"
              >
                <WebIcon name="sliders" className="w-4 h-4 text-orange-700 transition-transform group-hover:rotate-45 shrink-0" />
                <span>Bộ lọc hệ thống</span>
                {activeCategory !== 'all' && (
                  <span className="px-1.5 py-0.2 rounded-full bg-orange-100 border border-orange-300 text-[10px] font-mono text-orange-900 font-bold">
                    {ecosystemSegments.find((s) => s.id === activeCategory)?.label}
                  </span>
                )}
                <WebIcon
                  name="chevron-down"
                  className={cn(
                    'w-3.5 h-3.5 text-orange-700 transition-transform duration-200 shrink-0',
                    isFilterDropdownOpen && 'rotate-180'
                  )}
                />
              </button>

              <AnimatePresence>
                {isFilterDropdownOpen && (
                  <motion.div
                    initial={{ opacity: 0, y: 6, scale: 0.96 }}
                    animate={{ opacity: 1, y: 0, scale: 1 }}
                    exit={{ opacity: 0, y: 6, scale: 0.96 }}
                    transition={{ duration: 0.16 }}
                    role="listbox"
                    className="absolute left-0 top-[calc(100%+8px)] w-64 rounded-2xl bg-white/98 border border-orange-200 shadow-[0_12px_36px_rgba(0,0,0,0.18)] backdrop-blur-2xl py-2 px-2 z-50 flex flex-col gap-1 text-slate-800"
                  >
                    {ecosystemSegments.map((seg) => {
                      const isActive = activeCategory === seg.id;
                      return (
                        <button
                          key={seg.id}
                          type="button"
                          role="option"
                          aria-selected={isActive}
                          onClick={() => {
                            SoundEngine.playTap();
                            setActiveCategory(seg.id);
                            setExpandedSystemId(null);
                            setIsFilterDropdownOpen(false);
                          }}
                          className={cn(
                            'w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-bold font-play transition-all cursor-pointer text-left',
                            isActive
                              ? 'bg-orange-100 text-orange-900 border border-orange-300 shadow-xs'
                              : 'text-slate-700 hover:bg-slate-100 hover:text-slate-900 border border-transparent font-medium'
                          )}
                        >
                          <span>{seg.label} ({seg.count})</span>
                          {isActive && <span className="w-2 h-2 rounded-full bg-orange-600" />}
                        </button>
                      );
                    })}
                    <div className="my-1 border-t border-slate-200" />
                    <button
                      type="button"
                      onClick={() => {
                        SoundEngine.playTap();
                        setIsDataFlowModalOpen(true);
                        setIsFilterDropdownOpen(false);
                      }}
                      className="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-bold font-play text-cyan-800 hover:bg-cyan-50 transition-all cursor-pointer text-left"
                    >
                      <span>Mở Sơ Đồ Tổng Luồng Dữ Liệu</span>
                      <WebIcon name="activity" className="w-3.5 h-3.5 text-cyan-600" />
                    </button>
                  </motion.div>
                )}
              </AnimatePresence>
            </div>

            {/* Standalone Nút Sơ đồ liên kết các thẻ */}
            <button
              type="button"
              onClick={() => {
                SoundEngine.playTap();
                setIsDataFlowModalOpen(true);
              }}
              className="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-600 hover:bg-cyan-500 text-white border border-cyan-300/80 shadow-[0_4px_16px_rgba(6,182,212,0.35)] backdrop-blur-md transition-all cursor-pointer text-xs font-bold font-play active:scale-95 group shrink-0"
              title="Mở Sơ đồ liên kết các thẻ hệ thống"
            >
              <WebIcon name="activity" className="w-4 h-4 text-cyan-200 transition-transform group-hover:scale-110 shrink-0" />
              <span>Sơ đồ liên kết các thẻ</span>
            </button>
            </div>
          </motion.div>
        )}

        {/* VÙNG CHÍNH: LƯỚI 12 HỆ THỐNG C-LEVEL HOẶC BACKDROP SƠ ĐỒ LIÊN KẾT 12 THẺ HOẶC BẢNG MA TRẬN */}
        <div 
          className="flex-1 min-h-0 flex flex-col h-full overflow-hidden py-0 bg-transparent border-none shadow-none backdrop-blur-none"
          style={{ paddingTop: 0, paddingBottom: 0, background: 'transparent', backgroundColor: 'transparent' }}
        >
          {isDataFlowModalOpen ? (
            /* BACKDROP SƠ ĐỒ LIÊN KẾT THẺ: Kích thước bằng 12 thẻ hệ thống cộng lại, lúc xuất hiện ẩn banner hệ thống */
            <motion.div
              initial={{ opacity: 0, scale: 0.98 }}
              animate={{ opacity: 1, scale: 1 }}
              exit={{ opacity: 0, scale: 0.98 }}
              transition={{ duration: 0.3 }}
              className="flex-1 min-h-[500px] w-full rounded-[26px] bg-slate-950/95 dark:bg-black/95 backdrop-blur-2xl border border-cyan-500/40 p-4 sm:p-6 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.8)] flex flex-col justify-between text-left relative overflow-hidden"
              style={{
                boxShadow: '0 25px 60px -15px rgba(0, 0, 0, 0.8), 0 0 35px rgba(6, 182, 212, 0.25), inset 0 1px 2px rgba(255, 255, 255, 0.2)',
              }}
            >
              {/* Header Sơ Đồ Liên Kết 12 Thẻ */}
              <div className="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-cyan-500/30 shrink-0">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 rounded-2xl bg-cyan-500/20 border border-cyan-400/40 flex items-center justify-center text-cyan-300 shadow-[0_0_15px_rgba(6,182,212,0.4)]">
                    <WebIcon name="activity" className="w-5 h-5 text-cyan-300 animate-pulse" />
                  </div>
                  <div>
                    <div className="flex items-center gap-2">
                      <span className="px-2 py-0.5 rounded-md text-[10.5px] font-mono font-black bg-cyan-950 text-cyan-300 border border-cyan-400/40 uppercase tracking-wider">
                        Real-time Mesh
                      </span>
                      <h2 className="font-black font-play text-base sm:text-lg text-white tracking-tight">
                        Sơ Đồ Liên Kết & Dòng Chảy Dữ Liệu 12 Hệ Thống C-Level
                      </h2>
                    </div>
                    <p className="text-xs text-cyan-200/80 mt-0.5 font-medium">
                      Backdrop liên kết dữ liệu toàn cảnh diện tích bằng 12 thẻ hệ thống • Đồng bộ sự kiện qua Kafka Event Stream & Enterprise Service Bus
                    </p>
                  </div>
                </div>

                <div className="flex items-center gap-2">
                  <span className="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-400/30 text-emerald-300 text-xs font-mono font-bold">
                    <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" />
                    <span>12/12 Phân Hệ Đang Đồng Bộ</span>
                  </span>
                  <button
                    type="button"
                    onClick={() => {
                      SoundEngine.playTap();
                      setIsDataFlowModalOpen(false);
                    }}
                    className="px-4 py-1.5 rounded-full bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold font-play flex items-center gap-1.5 shadow-[0_0_15px_rgba(244,63,94,0.4)] border border-rose-400/40 transition active:scale-95 cursor-pointer"
                  >
                    <WebIcon name="cancel" className="w-3.5 h-3.5" />
                    <span>Đóng sơ đồ liên kết (Hiện lại 12 thẻ & Banner)</span>
                  </button>
                </div>
              </div>

              {/* VÙNG TRỰC QUAN SƠ ĐỒ 12 THẺ & LUỒNG DỮ LIỆU DẠNG CHIỀU NGANG (HORIZONTAL DATA PIPELINE) */}
              <div className="grid grid-cols-1 md:grid-cols-12 gap-3 py-3.5 flex-1 min-h-0 overflow-y-auto glass-scrollbar items-stretch">
                {/* Giai đoạn 1: CỔNG TIẾP NHẬN & TƯƠNG TÁC ĐA KÊNH (2/12 hoặc 3/12) */}
                <div className="md:col-span-3 rounded-2xl bg-white/5 border border-sky-400/30 p-3 sm:p-3.5 flex flex-col justify-between shadow-lg relative overflow-hidden group">
                  <div className="absolute top-0 right-0 w-24 h-24 bg-sky-500/10 rounded-full blur-xl pointer-events-none" />
                  <div>
                    <div className="flex items-center justify-between pb-2 border-b border-sky-400/20 mb-2">
                      <span className="text-xs font-bold font-mono text-sky-300 uppercase tracking-wider flex items-center gap-1.5">
                        <WebIcon name="globe" className="w-3.5 h-3.5 text-sky-400" />
                        <span>1. Cổng Tiếp Nhận (2)</span>
                      </span>
                      <span className="text-[9.5px] font-mono text-sky-400 font-bold bg-sky-950/80 px-1.5 py-0.5 rounded border border-sky-400/30">Inbound ➔</span>
                    </div>
                    <div className="space-y-2">
                      {[
                        { id: 'sdp', abbr: 'SDP', name: 'Cổng Dịch Vụ Số', desc: 'Self-Service Portal / Mobile App khách hàng', to: 'CRM, BPM', color: 'from-sky-600 to-blue-700' },
                        { id: 'csc', abbr: 'CSC', name: 'Tổng Đài Đa Kênh', desc: 'Contact Center WebRTC / Hotline / Chat', to: 'CRM, CLP, AI', color: 'from-blue-600 to-indigo-700' },
                      ].map((item) => (
                        <div key={item.id} className="p-2.5 rounded-xl bg-black/50 border border-sky-400/20 hover:border-sky-400/60 transition flex flex-col gap-1 text-xs">
                          <div className="flex items-center justify-between">
                            <span className={`px-2 py-0.5 rounded-md font-mono font-black text-[10.5px] text-white bg-gradient-to-r ${item.color}`}>
                              {item.abbr}
                            </span>
                            <span className="text-[10px] font-mono text-cyan-300">➔ {item.to}</span>
                          </div>
                          <span className="font-bold text-white text-[12px] truncate">{item.name}</span>
                          <span className="text-[10px] text-slate-300/80 leading-snug line-clamp-1">{item.desc}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                  <div className="mt-2 pt-2 border-t border-white/10 text-[10px] font-mono text-sky-200/80 flex items-center justify-between">
                    <span>Độ trễ: &lt; 8ms</span>
                    <span className="text-sky-300 font-bold">Chuyển tiếp ➔</span>
                  </div>
                </div>

                {/* Giai đoạn 2: KHÁCH HÀNG 360°, ĐIỂM CHẠM & LOYALTY (3/12) */}
                <div className="md:col-span-3 rounded-2xl bg-white/5 border border-amber-400/30 p-3 sm:p-3.5 flex flex-col justify-between shadow-lg relative overflow-hidden group">
                  <div className="absolute top-0 right-0 w-24 h-24 bg-amber-500/10 rounded-full blur-xl pointer-events-none" />
                  <div>
                    <div className="flex items-center justify-between pb-2 border-b border-amber-400/20 mb-2">
                      <span className="text-xs font-bold font-mono text-amber-300 uppercase tracking-wider flex items-center gap-1.5">
                        <WebIcon name="users" className="w-3.5 h-3.5 text-amber-400" />
                        <span>2. Khách Hàng 360° (3)</span>
                      </span>
                      <span className="text-[9.5px] font-mono text-amber-400 font-bold bg-amber-950/80 px-1.5 py-0.5 rounded border border-amber-400/30">Process ➔</span>
                    </div>
                    <div className="space-y-1.5">
                      {[
                        { id: 'crm', abbr: 'CRM', name: 'Quản Trị Khách Hàng', desc: 'Hồ sơ 360° & Hành trình tương tác', to: 'ERP, AI, BI', color: 'from-amber-600 to-orange-700' },
                        { id: 'clp', abbr: 'CLP', name: 'Khách Hàng Thân Thiết', desc: 'Tích lũy điểm, ưu đãi & giữ chân', to: 'POS, CRM', color: 'from-rose-600 to-pink-700' },
                        { id: 'pos', abbr: 'POS', name: 'Điểm Bán & Thanh Toán', desc: 'Offline-First POS & Cổng thanh toán', to: 'ERP, CRM', color: 'from-emerald-600 to-teal-700' },
                      ].map((item) => (
                        <div key={item.id} className="p-2 rounded-xl bg-black/50 border border-amber-400/20 hover:border-amber-400/60 transition flex flex-col gap-0.5 text-xs">
                          <div className="flex items-center justify-between">
                            <span className={`px-2 py-0.5 rounded-md font-mono font-black text-[10px] text-white bg-gradient-to-r ${item.color}`}>
                              {item.abbr}
                            </span>
                            <span className="text-[9.5px] font-mono text-amber-300">➔ {item.to}</span>
                          </div>
                          <span className="font-bold text-white text-[11.5px] truncate">{item.name}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                  <div className="mt-2 pt-2 border-t border-white/10 text-[10px] font-mono text-amber-200/80 flex items-center justify-between">
                    <span>Đồng bộ 360° Realtime</span>
                    <span className="text-amber-300 font-bold">Chuyển tiếp ➔</span>
                  </div>
                </div>

                {/* Giai đoạn 3: ĐIỀU HÀNH DOANH NGHIỆP & LÕI TÁC NGHIỆP (3/12 hoặc 4/12) */}
                <div className="md:col-span-3 rounded-2xl bg-white/5 border border-purple-400/30 p-3 sm:p-3.5 flex flex-col justify-between shadow-lg relative overflow-hidden group">
                  <div className="absolute top-0 right-0 w-24 h-24 bg-purple-500/10 rounded-full blur-xl pointer-events-none" />
                  <div>
                    <div className="flex items-center justify-between pb-2 border-b border-purple-400/20 mb-2">
                      <span className="text-xs font-bold font-mono text-purple-300 uppercase tracking-wider flex items-center gap-1.5">
                        <WebIcon name="briefcase" className="w-3.5 h-3.5 text-purple-400" />
