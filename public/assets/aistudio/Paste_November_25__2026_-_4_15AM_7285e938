  }
  .library:when(--sel == 5) .case:nth-child(6) .out::before {
    animation: glint 4.8s cubic-bezier(0.45, 0.05, 0.35, 1) -1.4s infinite;
  }
  .library:when(--sel == 6) .case:nth-child(7) .out::before {
