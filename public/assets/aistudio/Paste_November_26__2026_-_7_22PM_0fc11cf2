          border-radius: 50%;
          filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.35));
          transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease;
        }
        .book-cover-page:hover .book-yinyang-btn {
          transform: scale(1.04);
          filter: drop-shadow(0 0 18px rgba(214, 179, 114, 0.65));
        }
        .book-cover-page:hover .book-yinyang-svg {
          transform: rotate(35deg);
        }

        .cover-medallion-circle {
          position: relative;
          width: 70%;
          height: 70%;
          border-radius: 50%;
          overflow: hidden;
          border: 1.6px solid var(--nat-vang);
          box-shadow:
            0 0 16px rgba(198, 218, 238, 0.25),
            inset 0 0 12px rgba(7, 9, 12, 0.65);
          background: #0b0e13;
          z-index: 2;
        }
        .cover-medallion-img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          border-radius: 50%;
          display: block;
          pointer-events: none;
        }
        .cover-medallion-overlay {
          position: absolute;
          inset: 0;
          border-radius: 50%;
          background: radial-gradient(circle, transparent 60%, rgba(10, 13, 18, 0.38) 100%);
          box-shadow: inset 0 0 8px rgba(214, 179, 114, 0.3);
          pointer-events: none;
        }
        .book-yinyang-svg {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          display: block;
          pointer-events: none;
          z-index: 3;
          transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
        }

        /* ================= TRANG TRÁI & TRANG PHẢI BÊN TRONG SÁCH (CHỮ RÕ NÉT) ================= */
        .book-inner-left,
        .book-inner-right {
          width: 100%;
          height: 100%;
          padding: 16px;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
        }

        .page-top-badge {
          font-size: 14px;
          letter-spacing: 2px;
          color: var(--nat-vang-sang);
          font-weight: 700;
          text-transform: uppercase;
        }

        .thien-co-medallion {
          position: relative;
          width: 164px;
          height: 164px;
          margin: 4px 0;
          display: flex;
          align-items: center;
          justify-content: center;
          border-radius: 50%;
          filter: drop-shadow(0 0 16px rgba(214, 179, 114, 0.32));
        }
        .thien-co-ring-svg {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          pointer-events: none;
          z-index: 3;
        }
        .thien-co-video-circle {
          position: relative;
          width: 126px;
          height: 126px;
          border-radius: 50%;
          overflow: hidden;
          border: 1.8px solid var(--nat-vang);
          box-shadow:
            0 0 18px rgba(198, 218, 238, 0.22),
            inset 0 0 16px rgba(7, 9, 12, 0.65);
          background: #0b0e13;
          z-index: 2;
        }
        .thien-co-video {
          width: 100%;
          height: 100%;
          object-fit: cover;
          border-radius: 50%;
          display: block;
          transform: scale(1.04);
        }
        .thien-co-video-overlay {
          position: absolute;
          inset: 0;
          border-radius: 50%;
          background: radial-gradient(circle, transparent 58%, rgba(10, 13, 18, 0.45) 100%);
          box-shadow: inset 0 0 10px rgba(214, 179, 114, 0.28);
          pointer-events: none;
        }

        .click-bagua-hint {
          font-size: 11px;
          font-weight: 700;
          letter-spacing: 1px;
          color: var(--nat-ngan);
          text-transform: uppercase;
          z-index: 3;
        }

        .book-seal {
          font-weight: 700;
          font-size: 10.5px;
          line-height: 1.25;
          color: var(--nat-vang-sang);
          border: 1.5px solid var(--nat-vang);
          padding: 5px 8px;
          background: rgba(214, 179, 114, 0.14);
          box-shadow: inset 0 0 8px rgba(214, 179, 114, 0.18);
          letter-spacing: 1px;
          text-transform: uppercase;
          z-index: 3;
          text-align: center;
        }

        .inner-page-border {
          width: 100%;
          height: 100%;
          border: 1px solid rgba(223, 185, 115, 0.42);
          background: var(--inner-border-bg);
          padding: 15px 15px 12px;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          position: relative;
        }
        .inner-page-header {
          display: flex;
          align-items: flex-start;
          justify-content: space-between;
          gap: 8px;
          border-bottom: 1px solid rgba(223, 185, 115, 0.35);
          padding-bottom: 9px;
          margin-bottom: 10px;
        }
        .inner-close-btn {
          background: rgba(214, 179, 114, 0.14);
          border: 1px solid var(--nat-vang);
          color: var(--nat-vang-sang);
          border-radius: 4px;
          font-size: 11px;
          font-weight: 700;
          padding: 5px 9px;
          cursor: pointer;
          text-transform: uppercase;
          white-space: nowrap;
          transition: all 0.25s ease;
        }
        .inner-close-btn:hover {
          background: var(--nat-vang);
          color: #0e1217;
        }

        .inner-scroll-body {
          flex: 1;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          gap: 10px;
          overflow-y: auto;
          scrollbar-width: none;
          font-size: clamp(13px, 1.05vw + 9px, 15px);
          line-height: 1.66;
          text-align: left;
          color: var(--nat-testo);
          padding-right: 2px;
        }
        .inner-scroll-body::-webkit-scrollbar { display: none; }

        .body-para {
          margin: 0 0 10px;
          font-size: clamp(13px, 1.05vw + 9px, 15px);
          line-height: 1.66;
          color: var(--nat-testo);
        }

        /* Khung đoạn nội dung đồng bộ theo thời gian thực khi phát MP3 */
        .sync-passage-box {
          flex: 1;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          gap: 10px;
          position: relative;
          border-radius: 7px;
          padding: 10px 12px;
          margin-bottom: 0;
          border: 1px solid transparent;
          border-left: 2.5px solid transparent;
          cursor: pointer;
          transition: background 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease, transform 0.25s ease;
        }
        .sync-passage-box:hover {
          background: rgba(223, 185, 115, 0.08);
          border-color: rgba(223, 185, 115, 0.28);
        }
        .sync-passage-box.is-reading-active {
          background: linear-gradient(120deg, rgba(223, 185, 115, 0.24) 0%, rgba(247, 223, 158, 0.12) 55%, rgba(214, 230, 245, 0.08) 100%);
          border-color: var(--nat-vang);
          border-left: 4px solid var(--nat-vang-sang);
          box-shadow: 0 6px 22px rgba(212, 175, 106, 0.24), inset 0 0 16px rgba(247, 223, 158, 0.14);
          animation: activePassagePulse 2.4s ease-in-out infinite;
        }
        .sync-passage-box.is-reading-active .data-card-compact,
        .sync-passage-box.is-reading-active .pillar-card {
          border-color: rgba(223, 185, 115, 0.45);
          background: linear-gradient(145deg, rgba(223, 185, 115, 0.12), var(--surface-card-bg));
        }
        @keyframes activePassagePulse {
          0%, 100% {
            box-shadow: 0 4px 16px rgba(212, 175, 106, 0.18), inset 0 0 10px rgba(247, 223, 158, 0.08);
          }
          50% {
            box-shadow: 0 8px 26px rgba(212, 175, 106, 0.34), inset 0 0 18px rgba(247, 223, 158, 0.18);
          }
        }
        .sync-reading-pill {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          margin-bottom: 4px;
          padding: 3px 9px;
          border-radius: 999px;
          background: linear-gradient(90deg, rgba(223, 185, 115, 0.28), rgba(247, 223, 158, 0.18));
          border: 1px solid var(--nat-vang-sang);
          color: var(--nat-vang-sang);
          font-size: 10.5px;
          font-weight: 700;
          letter-spacing: 0.6px;
          text-transform: uppercase;
          box-shadow: 0 0 12px rgba(223, 185, 115, 0.25);
        }
        .sync-live-dot {
          width: 7px;
          height: 7px;
          border-radius: 50%;
          background: var(--nat-vang-sang);
          box-shadow: 0 0 8px var(--nat-vang-sang);
          animation: liveDotBlink 1.1s ease-in-out infinite;
        }
        @keyframes liveDotBlink {
          0%, 100% { transform: scale(0.85); opacity: 0.55; }
          50% { transform: scale(1.25); opacity: 1; }
        }
        .sync-passage-box:hover {
          background: rgba(223, 185, 115, 0.08);
          border-color: rgba(223, 185, 115, 0.28);
        }
        .sync-passage-box.is-reading-active {
          background: linear-gradient(90deg, rgba(223, 185, 115, 0.19) 0%, rgba(214, 230, 245, 0.08) 100%);
          border-color: rgba(223, 185, 115, 0.55);
          border-left: 3px solid var(--nat-vang-sang);
          box-shadow: 0 4px 16px rgba(214, 179, 114, 0.16), inset 0 0 12px rgba(223, 185, 115, 0.08);
        }
        .sync-reading-pill {
          display: inline-flex;
          align-items: center;
          gap: 4px;
          margin-bottom: 5px;
          padding: 2px 7px;
          border-radius: 999px;
          background: rgba(223, 185, 115, 0.22);
          border: 1px solid var(--nat-vang);
          color: var(--nat-vang-sang);
          font-size: 10px;
          font-weight: 700;
          letter-spacing: 0.6px;
          text-transform: uppercase;
        }

        .quote-text {
          font-size: 13px;
          line-height: 1.65;
          color: var(--nat-chiaro);
          margin: 0;
        }

        /* ================= THẺ DỮ LIỆU CHUYÊN SÂU TRONG CÁC TRANG SÁCH ================= */
        .section-sub-heading {
          font-size: 11.5px;
          font-weight: 700;
          letter-spacing: 0.8px;
          text-transform: uppercase;
          color: var(--nat-vang-sang);
          margin-bottom: 6px;
          padding-bottom: 3px;
          border-bottom: 1px dashed rgba(223, 185, 115, 0.35);
        }
        .data-list-stack {
          flex: 1;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          gap: 8px;
        }
        .subcard-two-col-grid {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 10px;
          width: 100%;
          flex: 1;
          align-content: stretch;
        }
        .subcard-two-col-item {
          display: flex;
          flex-direction: column;
          justify-content: center;
          padding: 10px 12px;
          min-width: 0;
        }
        .data-card-compact {
          flex: 1;
          display: flex;
          flex-direction: column;
          justify-content: center;
          background: var(--surface-card-bg);
          border: 1px solid rgba(223, 185, 115, 0.28);
          border-radius: 5px;
          padding: 9px 11px;
          text-align: left;
        }
        .data-card-top {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 6px;
          flex-wrap: wrap;
        }
        .data-card-label {
          font-size: clamp(10.5px, 0.4vw + 9px, 12px);
          font-weight: 700;
          color: var(--nat-spento);
          text-transform: uppercase;
        }
        .data-card-val {
          font-size: clamp(11.5px, 0.5vw + 9.5px, 13.5px);
          font-weight: 700;
          color: var(--nat-vang-sang);
        }
        .data-card-sub {
          font-size: clamp(11.5px, 0.55vw + 9.2px, 13.2px);
          line-height: 1.5;
          color: var(--nat-testo);
          margin-top: 2px;
        }
        .data-card-focus {
          font-size: clamp(11px, 0.45vw + 9px, 12.5px);
          font-weight: 700;
          color: var(--nat-ngan);
          margin-top: 4px;
        }
        .quote-item-compact {
          margin: 0;
          font-size: clamp(11.5px, 0.5vw + 9.5px, 13px);
          line-height: 1.52;
          color: var(--nat-chiaro);
          padding: 6px 8px;
          background: rgba(223, 185, 115, 0.07);
          border-left: 2px solid var(--nat-vang);
          border-radius: 0 4px 4px 0;
        }
        .pillar-card {
          flex: 1;
          display: flex;
          flex-direction: column;
          justify-content: center;
          background: var(--surface-card-bg);
          border: 1px solid rgba(223, 185, 115, 0.34);
          border-radius: 6px;
          padding: 11px 12px;
        }
        .pillar-header-row {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 6px;
          flex-wrap: wrap;
        }
        .pillar-title {
          font-size: clamp(12.5px, 0.65vw + 10px, 14.5px);
          font-weight: 700;
          color: var(--nat-vang-sang);
        }
        .pillar-badge {
          font-size: clamp(10px, 0.35vw + 8.5px, 11.5px);
          font-weight: 700;
          padding: 2px 7px;
          border-radius: 999px;
          background: rgba(223, 185, 115, 0.16);
          border: 1px solid rgba(223, 185, 115, 0.45);
          color: var(--nat-chu-sa);
          white-space: nowrap;
        }
        .pillar-basis {
          font-size: clamp(10.5px, 0.4vw + 9px, 12px);
          font-weight: 700;
          color: var(--nat-ngan);
          margin-top: 3px;
        }
        .bullet-list-compact {
          flex: 1;
          margin: 4px 0 0;
          padding-left: 4px;
          list-style: none;
          display: flex;
          flex-direction: column;
          justify-content: space-evenly;
          gap: 6px;
          font-size: clamp(12px, 0.6vw + 9.8px, 14px);
          line-height: 1.55;
          color: var(--nat-chiaro);
        }
        .chart-grid {
          flex: 1;
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 8px;
          align-content: stretch;
        }
        .chart-item {
          display: flex;
          flex-direction: column;
          justify-content: center;
          background: var(--surface-card-bg);
          border: 1px solid rgba(223, 185, 115, 0.28);
          border-radius: 5px;
          padding: 8px 10px;
          font-size: clamp(11.5px, 0.5vw + 9.5px, 13px);
          line-height: 1.45;
          color: var(--nat-testo);
        }
        .dept-score-badge {
          font-size: 12px;
          font-weight: 700;
          color: #0e1217;
          background: var(--nat-vang-sang);
          padding: 1px 7px;
          border-radius: 4px;
        }
        .dept-progress-track {
          width: 100%;
          height: 5px;
          background: rgba(255, 255, 255, 0.1);
          border-radius: 999px;
          overflow: hidden;
          margin: 5px 0 4px;
        }
        .dept-progress-fill {
          height: 100%;
          background: linear-gradient(90deg, var(--nat-vang), var(--nat-vang-sang));
          border-radius: 999px;
        }

        .inline-diagram-box {
          display: flex;
          justify-content: center;
          align-items: center;
          padding: 8px;
          margin-bottom: 10px;
          border: 1px solid rgba(223, 185, 115, 0.3);
          border-radius: 6px;
          background: var(--surface-card-bg);
        }

        .page-bagua-grid {
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          gap: 6px;
        }

        .page-footer-row {
          display: flex;
          align-items: center;
          justify-content: space-between;
          width: 100%;
          padding-top: 9px;
          margin-top: 8px;
          border-top: 1px solid rgba(223, 185, 115, 0.28);
        }

        .page-number-tag {
          font-size: 11.5px;
          font-weight: 700;
          letter-spacing: 1px;
          color: var(--nat-spento);
        }

        .page-nav-mini-btn {
          background: rgba(255, 255, 255, 0.06);
          border: 1px solid rgba(223, 185, 115, 0.45);
          color: var(--nat-vang-sang);
          border-radius: 4px;
          font-size: 11.5px;
          font-weight: 700;
          padding: 5px 10px;
          cursor: pointer;
          transition: all 0.2s ease;
        }
        .page-nav-mini-btn:hover {
          background: rgba(223, 185, 115, 0.22);
          color: var(--nat-chiaro);
        }
        .chart-item b {
          color: var(--nat-vang-sang);
          display: block;
          font-size: clamp(10px, 0.35vw + 8.8px, 11.5px);
          letter-spacing: 0.6px;
          text-transform: uppercase;
          margin-bottom: 2px;
        }

        .nat-nome {
          display: block;
          font-size: clamp(14px, 0.8vw + 11.5px, 17px);
          font-weight: 700;
          letter-spacing: 1.4px;
          text-transform: uppercase;
          color: var(--nat-vang-sang);
          line-height: 1.25;
        }
        .tv-meta {
          display: block;
          margin-top: 2px;
          font-size: clamp(11px, 0.45vw + 9.5px, 12.8px);
          letter-spacing: 0.4px;
          color: var(--nat-spento);
        }
        .tv-highlight { color: var(--nat-chiaro); font-weight: 700; }
        .tv-gold { color: var(--nat-vang-sang); font-weight: 700; }
        .tv-red { color: var(--nat-chu-sa); font-weight: 700; }

        /* ================= THANH ĐỒNG BỘ ÂM THANH MP3 & CHƯƠNG TRANG DƯỚI SÁCH ================= */
        .nat-lettore {
          width: 100%;
          max-width: 1020px;
          margin: 10px auto 6px;
          text-align: center;
          position: relative;
          z-index: 10;
        }
        .mp3-sync-panel {
          background: var(--link-bar-bg);
          border: 1px solid var(--switcher-border);
          border-radius: 10px;
          padding: 9px 14px;
          box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
          display: flex;
          flex-direction: column;
          gap: 7px;
          backdrop-filter: blur(12px);
        }
        .mp3-top-row {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 10px;
          flex-wrap: wrap;
        }
        .mp3-play-btn {
          background: rgba(223, 185, 115, 0.18);
          border: 1px solid var(--nat-vang);
          color: var(--nat-vang-sang);
          border-radius: 6px;
          padding: 6px 12px;
          font-size: clamp(11.5px, 0.45vw + 9.8px, 13px);
          font-weight: 700;
          cursor: pointer;
          display: inline-flex;
          align-items: center;
          gap: 6px;
          transition: all 0.2s ease;
        }
        .mp3-play-btn:hover {
          background: var(--nat-vang);
          color: #0e1217;
        }
        .mp3-chapter-info {
          flex: 1;
          text-align: left;
          min-width: 180px;
        }
        .mp3-chapter-title {
          font-size: clamp(12px, 0.55vw + 10px, 14px);
          font-weight: 700;
          color: var(--nat-vang-sang);
        }
        .mp3-chapter-sub {
          font-size: clamp(10.5px, 0.4vw + 9px, 12px);
          color: var(--nat-spento);
        }
        .mp3-time-readout {
          font-size: clamp(11.5px, 0.45vw + 9.8px, 13px);
          font-weight: 700;
          color: var(--nat-chiaro);
          letter-spacing: 0.6px;
        }
        .mp3-wave-bar {
          display: flex;
          align-items: flex-end;
          gap: 3px;
          height: 22px;
          cursor: pointer;
          padding: 2px 0;
        }
        .mp3-wave-col {
          flex: 1;
          border-radius: 2px;
          background: rgba(180, 194, 208, 0.25);
          transition: background 0.2s ease, height 0.2s ease;
        }
        .mp3-wave-col.is-played {
          background: var(--nat-vang);
        }
        .mp3-chapters-row {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 6px;
          flex-wrap: wrap;
        }
        .mp3-chapter-pill {
          flex: 1;
          min-width: 145px;
          background: rgba(255, 255, 255, 0.04);
          border: 1px solid rgba(223, 185, 115, 0.28);
          border-radius: 6px;
          padding: 6px 8px;
          color: var(--nat-spento);
          font-size: 11.5px;
          font-weight: 700;
          cursor: pointer;
          text-align: center;
          transition: all 0.2s ease;
        }
        .mp3-chapter-pill:hover {
          border-color: var(--nat-vang);
          color: var(--nat-chiaro);
        }
        .mp3-chapter-pill.is-active {
          background: rgba(223, 185, 115, 0.2);
          border-color: var(--nat-vang);
          color: var(--nat-vang-sang);
        }
        .mp3-autosync-toggle {
          background: none;
          border: 1px solid rgba(214, 230, 245, 0.25);
          border-radius: 5px;
          color: var(--nat-ngan);
          font-size: clamp(10.5px, 0.4vw + 9px, 12px);
          font-weight: 700;
          padding: 5px 9px;
          cursor: pointer;
        }
        .mp3-autosync-toggle.is-on {
          border-color: var(--nat-vang);
          color: var(--nat-vang-sang);
        }

        /* Ẩn thanh công cụ bên dưới cuốn sách theo yêu cầu */
        .nat-lettore {
          display: none !important;
        }

        .nat-hint {
          margin-top: 6px;
          font-size: clamp(11px, 0.45vw + 9.2px, 12.5px);
          letter-spacing: 0.5px;
          color: var(--nat-spento);
        }

        /* ================= ĐIỀU CHỈNH RESPONSIVE THEO KÍCH THƯỚC THIẾT BỊ ================= */
        @media (max-width: 768px) {
          .koi-theme-switcher {
            top: 10px;
            right: 10px;
            padding: 3px;
          }
          .koi-theme-btn {
            padding: 5px 9px;
            font-size: 11px;
          }
          .nat-lettore {
            margin: 8px auto 4px;
            padding: 0 4px;
          }
          .mp3-sync-panel {
            padding: 8px 10px;
            gap: 6px;
          }
          .mp3-chapter-info {
            min-width: 140px;
          }
          .subcard-two-col-grid {
            gap: 7px;
          }
          .subcard-two-col-item {
            padding: 8px 9px;
          }
        }

        @media (max-width: 520px) {
          .tuvi-app-root {
            padding: 10px 6px;
          }
          .inner-scroll-body,
          .body-para {
            font-size: 14.5px;
            line-height: 1.62;
          }
          .nat-nome {
            font-size: 16px;
          }
          .tv-meta {
            font-size: 12px;
          }
          .data-card-sub,
          .bullet-list-compact,
          .chart-item {
            font-size: 13px;
          }
          .pillar-title {
            font-size: 14px;
          }
        }

        /* ================= MODAL CỔ THƯ ================= */
        .nws-modal {
          position: fixed;
          inset: 0;
          z-index: 9999;
          display: flex;
          align-items: center;
          justify-content: center;
          animation: modalFadeIn 0.3s ease;
        }
        @keyframes modalFadeIn {
          from { opacity: 0; }
          to { opacity: 1; }
        }
        .nws-backdrop {
          position: absolute;
          inset: 0;
          background: var(--modal-backdrop);
          backdrop-filter: blur(3px);
          cursor: pointer;
        }
        .nws-window {
          position: relative;
          width: 400px;
          max-width: calc(100% - 24px);
          max-height: 92vh;
          overflow-y: auto;
          scrollbar-width: none;
          padding: 18px 20px;
          background: var(--modal-bg);
          border: 1.5px solid var(--book-border);
          border-radius: 8px;
          box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
          z-index: 2;
        }
        .nws-window::-webkit-scrollbar { display: none; }
        .nws-close {
          position: absolute;
          top: 8px;
          right: 12px;
          z-index: 3;
          background: none;
          border: none;
          padding: 4px 8px;
          font-size: 24px;
          font-weight: 700;
          line-height: 1;
          color: var(--nat-spento);
          cursor: pointer;
        }
        .nws-close:hover { color: var(--nat-chu-sa); }

        .nlg {
          width: 350px;
          max-width: 100%;
          margin: 0 auto;
          padding: 10px 0 14px;
          text-align: center;
        }
        .nlg-visual-box {
          height: 155px;
          margin: 6px 14px 0;
          overflow: hidden;
          border: 3px double var(--book-border);
          border-radius: 6px;
          background: var(--visual-box-bg);
          display: flex;
          align-items: center;
          justify-content: center;
        }
        .nlg-title {
          margin: 14px 0 0;
          font-weight: 700;
          font-size: 19px;
          letter-spacing: .12em;
          text-transform: uppercase;
          color: var(--nat-vang-sang);
        }
        .nlg-sub {
          display: flex;
          align-items: center;
          gap: 8px;
          margin: 8px 0 0;
          padding: 0 14px;
          font-size: 12px;
          letter-spacing: 0.6px;
          color: var(--nat-chu-sa);
          font-weight: 700;
        }
        .nlg-sub::before, .nlg-sub::after { content: ''; flex: 1; height: 1px; }
        .nlg-sub::before { background: linear-gradient(to right, transparent, var(--book-border)); }
        .nlg-sub::after  { background: linear-gradient(to left, transparent, var(--book-border)); }

        .nlg-text {
          margin: 12px 0 0;
          padding: 0 12px;
          font-size: 13.5px;
          line-height: 1.65;
          text-align: left;
          color: var(--nat-testo);
        }
        .nlg-text b { color: var(--nat-vang-sang); }

        .khau-quyet-btn {
          background: none;
          border: none;
          margin-top: 12px;
          cursor: pointer;
          transition: transform 0.25s ease;
        }
        .khau-quyet-btn:hover { transform: scale(1.06); }
        .nlg-more-box {
          margin: 10px 12px 0;
          padding-top: 10px;
          border-top: 1px solid rgba(184, 139, 70, 0.35);
        }

        .nlg-gallery {
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          gap: 8px;
          margin: 16px 12px 0;
        }
        .bagua-cell {
          aspect-ratio: 1 / 1;
          border: 1px solid var(--book-border);
          border-radius: 5px;
          background: var(--cell-bg);
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          padding: 4px;
          transition: all 0.25s ease;
        }
        .bagua-cell:hover {
          border-color: var(--nat-chu-sa);
          background: var(--cell-hover-bg);
          transform: translateY(-2px);
        }
        .bagua-glyph { font-size: 20px; line-height: 1; color: var(--nat-vang-sang); }
        .bagua-name { font-size: 10.5px; font-weight: 700; color: var(--nat-chiaro); margin-top: 3px; text-transform: uppercase; }
        .bagua-elem { font-size: 9px; color: var(--nat-spento); }

        @keyframes slowSpin {
          from { transform: rotate(0deg); }
          to { transform: rotate(360deg); }
        }
        .spin-slow {
          transform-origin: center;
          animation: slowSpin 35s linear infinite;
        }
      `}</style>

      {/* ================= SÂN KHẤU SÁCH TỬ VI VỚI HIỆU ỨNG LẬT TRANG ================= */}
      <div className="nat-stage" style={{ height: `${785 * scale}px` }}>
        <div
          className={`nat ${isPeekingOrTurning ? 'is-active' : ''} ${isBookOpen ? 'is-book-open' : ''}`}
          style={{ transform: scale < 1 ? `scale(${scale})` : 'none' }}
          tabIndex={0}
        >
          {/* Vòng la bàn Bát Quái xoay phía sau */}
          <CompassBackdrop />

          {/* Khối sách lật trang vật lý (PageFlip) */}
          <TalismanPageFlip
            ref={pageFlipRef}
            pages={bookPages}
            onSpreadChange={handleSpreadChange}
            onInteractionStateChange={setIsPeekingOrTurning}
          />
        </div>
      </div>

      {/* ================= THANH ĐỒNG BỘ MỞ SÁCH THEO ÂM THANH MP3 ================= */}
      <div className="nat-lettore" style={{ display: 'none' }} onClick={(e) => e.stopPropagation()}>
        <div className="mp3-sync-panel">
          <div className="mp3-top-row">
            <button
              type="button"
              className="mp3-play-btn"
              onClick={toggleMp3Playback}
            >
              <span>{isMp3Playing ? '❚❚ Tạm Dừng' : '▶ Phát & Mở Sách'}</span>
            </button>

            <div className="mp3-chapter-info">
              <div className="mp3-chapter-title">
                {activeSegment ? activeSegment.label : currentChapter.title}
              </div>
              <div className="mp3-chapter-sub">
                {activeSegment
                  ? `Đang đánh dấu nội dung · ${activeSegment.timeRange}`
                  : currentChapter.subtitle}
              </div>
            </div>

            <button
              type="button"
              className={`mp3-autosync-toggle ${autoSyncPages ? 'is-on' : ''}`}
              onClick={() => setAutoSyncPages((prev) => !prev)}
              title="Tự động mở và lật sách đến đoạn âm thanh đang phát"
            >
              {autoSyncPages ? '✓ Tự Mở Theo Âm Thanh' : '○ Tự Mở Tắt'}
            </button>

            <div className="mp3-time-readout">
              {formatTime(mp3CurrentTime)} / {formatTime(mp3Duration)}
            </div>
          </div>

          <div
            className="mp3-wave-bar"
            onClick={(e) => {
              const rect = e.currentTarget.getBoundingClientRect();
              const ratio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
              playBookOpenSound(ratio * (mp3Duration || MP3_TOTAL_SECONDS));
            }}
            title="Bấm vào thanh sóng âm để tua đến đoạn nội dung tương ứng"
          >
            {mp3WaveformBars.map((barHeight, idx) => {
              const barPos = (idx + 0.5) / mp3WaveformBars.length;
              const isPlayed = barPos <= progressPercent / 100;
              return (
                <span
                  key={idx}
                  className={`mp3-wave-col ${isPlayed ? 'is-played' : ''}`}
                  style={{ height: `${Math.max(24, Math.min(100, barHeight))}%` }}
                />
              );
            })}
          </div>
        </div>
      </div>

      {/* ================= CỬA SỔ MODAL LUẬN GIẢI ================= */}
      <BookModal activeModal={activeModal} onClose={() => setActiveModal(null)} />
    </div>
  );
}