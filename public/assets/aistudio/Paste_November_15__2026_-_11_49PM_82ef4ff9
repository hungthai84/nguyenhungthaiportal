/**
 * Component hiển thị ảnh logo hình tròn với fallback tự động khi lỗi tải ảnh
 */
const CircularLogo = ({ logo, isStacked, index, total }) => {
  const [imgSrc, setImgSrc] = useState(logo.src);

  return (
    <div
      style={{
        marginInlineStart: isStacked && index > 0 ? '-12px' : '0px',
        zIndex: total - index,
      }}
      className={`w-[50px] h-[50px] aspect-square bg-white rounded-full flex items-center justify-center shadow-md overflow-hidden shrink-0 transition-transform duration-300 group-hover:scale-105 ${
        isStacked ? 'ring-2 ring-white' : ''
      }`}
    >
      <img
        src={imgSrc}
        onError={() => {
          if (imgSrc !== logo.fallback) {
            setImgSrc(logo.fallback);
          }
        }}
        alt={logo.alt}
        className="w-full h-full object-cover"
      />
    </div>
  );
};

export default function ExperienceTimeline() {
  const [milestones] = useState(INITIAL_MILESTONES);
  const [startIndex, setStartIndex] = useState(0);
  const [visibleCols, setVisibleCols] = useState(5);
  const [isFolded, setIsFolded] = useState(true);
  const [hoveredCol, setHoveredCol] = useState(null);
  const [isDragging, setIsDragging] = useState(false);

  // Refs quản lý thao tác kéo thả chuột, vuốt chạm và chống trôi quá nhanh khi lăn chuột
  const dragStartXRef = React.useRef(null);
  const lastWheelTimeRef = React.useRef(0);

  // Tự động điều chỉnh số cột hiển thị khi thu nhỏ màn hình (Desktop: 5 cột, Tablet: 3 cột, Mobile: 1-2 cột)
  useEffect(() => {
    const handleResize = () => {
      const width = window.innerWidth;
      if (width < 640) {
        setVisibleCols(1);
      } else if (width < 1024) {
        setVisibleCols(3);
      } else {
        setVisibleCols(5);
      }
    };
    handleResize();
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, []);

  // Đảm bảo startIndex không vượt quá giới hạn khi thay đổi số cột hiển thị
  useEffect(() => {
    const maxStart = Math.max(0, milestones.length - visibleCols);
    if (startIndex > maxStart) {
      setStartIndex(maxStart);
    }
  }, [visibleCols, milestones.length, startIndex]);

  const maxStartIndex = Math.max(0, milestones.length - visibleCols);

  const handlePrev = () => {
    setStartIndex((prev) => Math.max(0, prev - 1));
  };

  const handleNext = () => {
    setStartIndex((prev) => Math.min(maxStartIndex, prev + 1));
  };

  // Hiệu ứng cuộn bằng con lăn chuột (hỗ trợ cả cuộn ngang trackpad lẫn cuộn dọc chuột thường)
  const handleWheelScroll = (e) => {
    const dominantDelta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
    if (Math.abs(dominantDelta) < 12) return;

    const now = Date.now();
    if (now - lastWheelTimeRef.current < 260) return;
    lastWheelTimeRef.current = now;

    if (dominantDelta > 0) {
      handleNext();
    } else {
      handlePrev();
    }
  };

  // Bắt đầu kéo ngang bằng chuột hoặc vuốt chạm
  const handlePointerDown = (clientX, target) => {
    if (target?.closest('button')) return;
    dragStartXRef.current = clientX;
    setIsDragging(true);
  };

  // Kết thúc kéo ngang -> tự động trượt tới/lùi theo hướng kéo
  const handlePointerUp = (clientX) => {
    if (dragStartXRef.current === null) return;
    const diffX = dragStartXRef.current - clientX;
    if (Math.abs(diffX) > 45) {
      if (diffX > 0) {
        handleNext();
      } else {
        handlePrev();
      }
    }
    dragStartXRef.current = null;
    setIsDragging(false);
  };

  // Hỗ trợ phím mũi tên trái/phải để trượt timeline
  useEffect(() => {
    const handleKeyDown = (e) => {
      if (e.key === 'ArrowLeft') handlePrev();
      if (e.key === 'ArrowRight') handleNext();
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  });

  const translatePercent = (startIndex * 100) / visibleCols;

  return (
    <div
      style={{ fontFamily: "'Play', sans-serif" }}
      className="min-h-screen w-full bg-[#E6EBF1] flex items-center justify-center p-3 sm:p-6 overflow-x-hidden"
    >
      {/* Tải Google Font Play trực tiếp để đảm bảo hiển thị chuẩn xác */}
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Play:wght@400;700&display=swap');
      `}</style>

      {/* KHUNG THẺ CHÍNH: Ngang 1250px, Cao 750px, Bo cong 4 góc */}
      <main
        onWheel={handleWheelScroll}
        onMouseDown={(e) => handlePointerDown(e.clientX, e.target)}
        onMouseUp={(e) => handlePointerUp(e.clientX)}
        onMouseLeave={() => {
          dragStartXRef.current = null;
          setIsDragging(false);
        }}
        onTouchStart={(e) => handlePointerDown(e.touches[0].clientX, e.target)}
        onTouchEnd={(e) => handlePointerUp(e.changedTouches[0].clientX)}
        className={`group/board relative w-full max-w-[1250px] h-[750px] rounded-[28px] overflow-hidden bg-[#F8FAFC] shadow-[0_25px_70px_rgba(15,23,42,0.16)] border border-white/80 select-none ${
          isDragging ? 'cursor-grabbing' : 'cursor-grab'
        }`}
      >
        
        {/* LỚP BẢN ĐỒ THẾ GIỚI DẠNG CHẤM TRÒN (HALFTONE DOTTED WORLD MAP) */}
        <div className="absolute inset-0 z-[15] pointer-events-none opacity-25 mix-blend-multiply">
          <svg
            className="w-full h-full"
            viewBox="0 0 1600 900"
            preserveAspectRatio="xMidYMid slice"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <pattern
                id="halftoneDotsReact"
                x="0"
                y="0"
                width="6"
                height="6"
                patternUnits="userSpaceOnUse"
              >
                <circle cx="2.5" cy="2.5" r="1.45" fill="#64748B" />
              </pattern>
              <mask id="worldMapMaskReact">
                <rect width="1600" height="900" fill="black" />
                <path
                  d="M 65 160 Q 130 130 220 140 L 290 110 L 345 145 L 315 215 L 255 245 L 235 300 L 270 355 L 250 385 L 195 330 L 160 280 L 95 235 Z"
                  fill="white"
                />
                <path
                  d="M 355 75 L 445 65 L 465 115 L 405 145 L 365 115 Z"
                  fill="white"
                />
                <path
                  d="M 285 405 L 355 415 L 415 485 L 395 585 L 345 695 L 315 765 L 290 745 L 295 620 L 265 510 Z"
                  fill="white"
                />
                <path
                  d="M 520 135 L 610 100 L 690 120 L 720 185 L 665 245 L 595 265 L 535 255 L 510 205 Z"
                  fill="white"
                />
                <path
                  d="M 515 295 L 625 290 L 705 345 L 735 435 L 695 555 L 645 645 L 595 630 L 575 510 L 505 435 L 490 360 Z"
                  fill="white"
                />
                <path
                  d="M 730 125 L 920 95 L 1140 105 L 1340 130 L 1460 175 L 1420 265 L 1310 315 L 1245 415 L 1150 455 L 1045 435 L 965 465 L 895 405 L 805 375 L 745 290 Z"
                  fill="white"
                />
                <path
                  d="M 1145 485 L 1225 495 L 1265 535 L 1185 555 L 1125 525 Z"
                  fill="white"
                />
                <path
                  d="M 1285 515 L 1355 525 L 1365 555 L 1295 545 Z"
                  fill="white"
                />
                <path
                  d="M 1175 605 L 1295 595 L 1375 645 L 1365 735 L 1275 765 L 1185 725 L 1155 665 Z"
                  fill="white"
                />
              </mask>
            </defs>
            <rect
              width="1600"
              height="900"
              fill="url(#halftoneDotsReact)"
              mask="url(#worldMapMaskReact)"
            />
          </svg>
        </div>

        {/* TIÊU ĐỀ GÓC TRÊN BÊN TRÁI "THỜI GIAN CÔNG TÁC" */}
        <header className="absolute top-[5.2%] left-[2.8%] z-[30] pointer-events-auto">
          <div className="font-normal text-[#0284C7] uppercase tracking-[0.06em] leading-[1.05] text-[22px] sm:text-[26px]">
            Thời Gian
          </div>
          <div className="font-bold text-[#1E293B] uppercase tracking-[0.06em] leading-[1.02] mt-1 text-[28px] sm:text-[34px]">
            Công Tác
          </div>
          {/* Hàng 5 chấm tròn màu + gạch chân hồng */}
          <div className="flex items-center gap-[6px] mt-3">
            <span className="w-[8px] h-[8px] rounded-full bg-[#F8C605]" />
            <span className="w-[8px] h-[8px] rounded-full bg-[#EE2A7B]" />
            <span className="w-[8px] h-[8px] rounded-full bg-[#00AEEF]" />
            <span className="w-[8px] h-[8px] rounded-full bg-[#39B54A]" />
            <span className="w-[8px] h-[8px] rounded-full bg-[#334155]" />
            <span className="w-[44px] h-[2px] bg-[#EE2A7B] ml-1" />
          </div>
        </header>

        {/* THANH ĐIỀU HƯỚNG GÓC TRÊN BÊN PHẢI: HIỆU ỨNG BÌA GẤP + NÚT TỚI / LÙI */}
        <div className="absolute top-[5.2%] right-[2.8%] z-[35] flex items-center gap-2.5 bg-white/85 backdrop-blur-md px-3.5 py-2 rounded-full shadow-md border border-slate-200/80">
          {/* Nút bật/tắt hiệu ứng bìa gấp */}
          <button
            type="button"
            onClick={() => setIsFolded((prev) => !prev)}
            title="Bật/Tắt hiệu ứng bìa gấp 3D"
            className={`hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold transition-all ${
              isFolded
                ? 'bg-[#0284C7] text-white shadow-sm'
                : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
            }`}
          >
            <Layers className="w-3.5 h-3.5" />
            <span>Bìa gấp: {isFolded ? 'BẬT' : 'TẮT'}</span>
          </button>

          <div className="hidden sm:block w-[1px] h-5 bg-slate-200" />

          {/* Chỉ số cột đang hiển thị */}
          <span className="text-xs font-bold text-slate-600 px-1.5 tabular-nums">
            {startIndex + 1} – {Math.min(startIndex + visibleCols, milestones.length)} / {milestones.length}
          </span>

          {/* Nút Lùi */}
          <button
            type="button"
            onClick={handlePrev}
            disabled={startIndex === 0}
            aria-label="Lùi lại"
            className="w-9 h-9 rounded-full flex items-center justify-center bg-slate-100 text-slate-800 hover:bg-[#0284C7] hover:text-white disabled:opacity-35 disabled:hover:bg-slate-100 disabled:hover:text-slate-800 transition-all shadow-sm"
          >
            <ChevronLeft className="w-5 h-5" />
          </button>

          {/* Nút Tiến tới */}
          <button
            type="button"
            onClick={handleNext}
            disabled={startIndex >= maxStartIndex}
            aria-label="Tiến tới"
            className="w-9 h-9 rounded-full flex items-center justify-center bg-slate-100 text-slate-800 hover:bg-[#0284C7] hover:text-white disabled:opacity-35 disabled:hover:bg-slate-100 disabled:hover:text-slate-800 transition-all shadow-sm"
          >
            <ChevronRight className="w-5 h-5" />
          </button>
        </div>

        {/* NÚT CUỘN NỔI HAI BÊN MÉP TRÁI / PHẢI KHI RÊ CHUỘT VÀO THẺ */}
        {startIndex > 0 && (
          <button
            type="button"
            onClick={handlePrev}
            aria-label="Cuộn lùi sang trái"
            className="absolute left-3.5 top-1/2 -translate-y-1/2 z-[40] w-11 h-11 rounded-full bg-white/95 backdrop-blur-md text-slate-800 border border-slate-200/90 shadow-[0_10px_25px_rgba(15,23,42,0.2)] flex items-center justify-center opacity-85 sm:opacity-0 sm:group-hover/board:opacity-100 hover:bg-[#0284C7] hover:text-white hover:scale-110 active:scale-95 transition-all duration-300"
          >
            <ChevronLeft className="w-6 h-6" />
          </button>
        )}

        {startIndex < maxStartIndex && (
          <button
            type="button"
            onClick={handleNext}
            aria-label="Cuộn tới sang phải"
            className="absolute right-3.5 top-1/2 -translate-y-1/2 z-[40] w-11 h-11 rounded-full bg-white/95 backdrop-blur-md text-slate-800 border border-slate-200/90 shadow-[0_10px_25px_rgba(15,23,42,0.2)] flex items-center justify-center opacity-85 sm:opacity-0 sm:group-hover/board:opacity-100 hover:bg-[#0284C7] hover:text-white hover:scale-110 active:scale-95 transition-all duration-300"
          >
            <ChevronRight className="w-6 h-6" />
          </button>
        )}

        {/* KHUNG SLIDER HIỂN THỊ 5 CỘT CÙNG LÚC */}
        <div
          className="relative w-full h-full overflow-hidden"
          style={{ perspective: '1800px' }}
        >
          <div
            className="flex h-full transition-transform duration-500 ease-out"
            style={{
              transform: `translateX(-${translatePercent}%)`,
              transformStyle: 'preserve-3d',
            }}
          >
            {milestones.map((item, idx) => {
              // Bìa gấp từ trái qua phải: Đảo ngược logic xoay trục (Cột chẵn gập trái, cột lẻ gập phải)
              const isEven = idx % 2 === 0;
              const isHovered = hoveredCol === item.id;
              const foldAngle = isFolded
                ? isHovered
                  ? 0
                  : isEven
                  ? -8
                  : 8
                : 0;

              return (
                <div
                  key={item.id}
                  onMouseEnter={() => setHoveredCol(item.id)}
                  onMouseLeave={() => setHoveredCol(null)}
                  style={{
                    flex: `0 0 ${100 / visibleCols}%`,
                    width: `${100 / visibleCols}%`,
                    background: item.colBgGradient,
                    transform: `rotateY(${foldAngle}deg) ${
                      isHovered ? 'translateZ(14px)' : 'translateZ(0px)'
                    }`,
                    transformOrigin: isEven ? 'left center' : 'right center',
                    zIndex: isHovered ? 25 : idx + 1,
                  }}
                  className="group relative h-full transition-all duration-300 shadow-[-10px_0_20px_-4px_rgba(15,23,42,0.12)]"
                >
                  {/* Đường nếp gấp ánh sáng/bóng đổ tạo độ nổi 3D theo chiều từ trái qua phải */}
                  {isFolded && (
                    <div
                      className="absolute inset-0 pointer-events-none z-[12] transition-opacity duration-300"
                      style={{
                        background: isEven
                          ? 'linear-gradient(to right, rgba(255,255,255,0.25) 0%, rgba(15,23,42,0.06) 100%)'
                          : 'linear-gradient(to right, rgba(15,23,42,0.08) 0%, rgba(255,255,255,0.22) 50%, rgba(15,23,42,0.04) 100%)',
                        opacity: isHovered ? 0.15 : 1,
                      }}
                    />
                  )}

                  {/* NỘI DUNG TỪNG CỘT MỐC */}
                  <div className="relative z-[20] w-full h-full">
                    {/* 1. ICON LỊCH MÀU ĐEN + CHỮ NĂM + SỐ NĂM */}
                    <div className="absolute top-[35.2%] left-0 w-full flex items-center justify-center gap-1.5 font-bold text-[#0F172A] uppercase tracking-[0.03em] leading-none text-[16px]">
                      <Calendar
                        className="w-[17px] h-[17px] shrink-0 text-[#0F172A]"
                        strokeWidth={2.3}
                      />
                      <span>{item.year}</span>
                    </div>

                    {/* 2. KHỐI MÀU NGANG CHỨA LOGO TRÒN Ở GIỮA */}
                    <div
                      style={{ background: item.blockGradient }}
                      className="absolute top-[40.5%] left-0 w-full h-[18.0%] flex items-center justify-center px-3 shadow-[0_12px_22px_-2px_rgba(15,23,42,0.25)] transition-all duration-300 group-hover:brightness-105"
                    >
                      <div className="flex items-center justify-center">
                        {item.logos.map((logo, logoIdx) => (
                          <CircularLogo
                            key={logoIdx}
                            logo={logo}
                            isStacked={item.logos.length > 1}
                            index={logoIdx}
                            total={item.logos.length}
                          />
                        ))}
                      </div>
                    </div>

                    {/* 3. THÔNG TIN CÔNG TY, VỊ TRÍ, QUẢN LÝ & MÔ TẢ PHÍA DƯỚI */}
                    <div className="absolute top-[61.8%] left-[11%] w-[78%] text-[#1E293B]">
                      {/* Tên công ty cố định độ cao tương đương 4 hàng */}
                      <h3 className="font-bold text-[#0F172A] leading-[1.28] text-[16px] min-h-[5.1em] border-b border-slate-300 pb-2 mb-2.5">
                        {item.company}
                      </h3>

                      {/* Vị trí & Quản lý kèm icon */}
                      <div className="space-y-1.5 mb-2.5 text-[12px] text-slate-700">
                        <div className="flex items-start gap-1.5 leading-[1.35]">
                          <span
                            style={{ color: item.accentColor }}
                            className="font-bold shrink-0 inline-flex items-center gap-1"
                          >
                            <Briefcase className="w-3.5 h-3.5 shrink-0" strokeWidth={2.2} />
                            Vị trí:
                          </span>
                          <span className="font-medium text-[#0F172A]">
                            {item.position}
                          </span>
                        </div>

                        <div className="flex items-start gap-1.5 leading-[1.35]">
                          <span
                            style={{ color: item.accentColor }}
                            className="font-bold shrink-0 inline-flex items-center gap-1"
                          >
                            <Users className="w-3.5 h-3.5 shrink-0" strokeWidth={2.2} />
                            Quản lý:
                          </span>
                          <span className="font-medium text-[#0F172A]">
                            {item.teamSize}
                          </span>
                        </div>
                      </div>

                      {/* Mô tả chi tiết */}
                      <p className="font-normal text-slate-600 leading-[1.4] text-[11.5px]">
                        {item.description}
                      </p>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* CHẤM PHÂN TRANG DƯỚI ĐÁY THẺ ĐỂ CHUYỂN NHANH */}
        <div className="absolute bottom-4 left-1/2 -translate-x-1/2 z-[35] flex items-center gap-2 bg-white/80 backdrop-blur-sm px-3 py-1.5 rounded-full shadow-sm border border-slate-200/70">
          {Array.from({ length: maxStartIndex + 1 }).map((_, idx) => (
            <button
              key={idx}
              type="button"
              onClick={() => setStartIndex(idx)}
              aria-label={`Chuyển tới trang ${idx + 1}`}
              className={`h-2 rounded-full transition-all duration-300 ${
                startIndex === idx
                  ? 'w-7 bg-[#0284C7]'
                  : 'w-2 bg-slate-300 hover:bg-slate-400'
              }`}
            />
          ))}
        </div>
      </main>
    </div>
  );
}