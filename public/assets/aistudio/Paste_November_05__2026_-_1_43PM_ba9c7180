                    itemBg = `linear-gradient(135deg, ${cardThemeColor} 0%, ${neonData.neon || cardThemeColor}EE 100%)`;
                    itemBorder = neonData.neon || cardThemeColor;
                    itemBoxShadow = `0 4px 16px -2px ${cardThemeColor}60, 0 0 10px ${neonData.glow || `${cardThemeColor}50`}`;
                    iconColor = '#FFFFFF';
                    titleColor = '#FFFFFF';
