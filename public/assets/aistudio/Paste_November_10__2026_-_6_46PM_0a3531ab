  { from: 'CLP (Loyalty)', dir: '⇄ Tra cứu', to: 'POS (Quầy bán)', data: 'Xác thực voucher ưu đãi & chiết khấu điểm loyalty tại quầy', proto: 'RESTful API', freq: 'Thời gian thực' },
  { from: 'CSC (Tổng đài)', dir: '→ Cấp bù', to: 'CLP (Loyalty)', data: 'Tặng voucher ưu đãi, tích điểm đền bù khách hàng', proto: 'REST API', freq: 'Theo sự vụ' },
  { from: 'ERP (Tài chính)', dir: '⇄ 2 Chiều', to: 'HRM (Nhân sự)', data: 'Hạch toán chi phí lương, bảo hiểm, thưởng nhân sự', proto: 'Batch Job / REST', freq: 'Cuối kỳ tính lương' },
  { from: 'BPM (Quy trình)', dir: '⇄ 2 Chiều', to: 'HRM (Nhân sự)', data: 'Luồng phê duyệt tuyển dụng, thăng cấp, nghỉ phép', proto: 'Webhook / Kafka', freq: 'Theo yêu cầu duyệt' },
  { from: 'HRM (Nhân sự)', dir: '⇄ Đối chiếu', to: 'OKR (Mục tiêu)', data: 'Dữ liệu kết quả OKR phục vụ xếp loại hiệu suất nhân sự', proto: 'RESTful API', freq: 'Theo quý / Năm' },
  { from: 'AI Assistant', dir: '⇄ Đọc tri thức', to: 'LMS (Đào tạo)', data: 'Nạp bộ câu hỏi, cẩm nang CSKH phục vụ gợi ý trả lời', proto: 'Vector DB / Embedding', freq: 'Hàng ngày' },
  { from: 'AI Assistant', dir: '→ Dự báo', to: 'BI Dashboard', data: 'Mô hình phân tích hành vi và dự đoán churn rate', proto: 'Python API / Kafka', freq: 'Near-Realtime' },
  { from: 'CRM (Khách hàng)', dir: '→ Phân tích', to: 'BI Dashboard', data: 'Phễu chuyển đổi bán hàng, vòng đời khách hàng LTV', proto: 'ETL Pipeline', freq: 'Mỗi giờ' },
  { from: 'Toàn bộ 11 phân hệ', dir: '→ Streaming', to: 'BI Dashboard', data: 'Toàn bộ event tương tác, thời gian phản hồi, wallboard', proto: 'Kafka / ClickHouse / SQL', freq: 'Near-Realtime (5s)' }
];

export default function App() {
  const [showHubLines, setShowHubLines] = useState(true);
  const [showInterSystemLines, setShowInterSystemLines] = useState(true);
  const [activeFilter, setActiveFilter] = useState('all');
  const [activeLineGroup, setActiveLineGroup] = useState('all');
  const [isAnimationActive, setIsAnimationActive] = useState(true);
  const [currentRole, setCurrentRole] = useState('admin');
  
  // Card position offsets for dragging
  const [offsets, setOffsets] = useState({});
  
  // Modals state
  const [selectedSystem, setSelectedSystem] = useState(null);
  const [isMatrixOpen, setIsMatrixOpen] = useState(false);
  const [isSimOpen, setIsSimOpen] = useState(false);
  const [toastMessage, setToastMessage] = useState('');

  // Svg connection lines state
  const [lines, setLines] = useState({ hub: [], inter: [] });

  const boardRef = useRef(null);
  const nodeRefs = useRef({});

  // Helper for Toast
  const showToast = (msg) => {
    setToastMessage(msg);
    setTimeout(() => {
      setToastMessage('');
    }, 2200);
  };

  // Reset positions
  const handleResetPositions = () => {
    setOffsets({});
    showToast('Đã đưa vị trí các thẻ về mặc định');
  };

  // Role Selection Change
  const handleRoleChange = (roleKey) => {
    setCurrentRole(roleKey);
    showToast(`Đã chuyển sang phân quyền: ${sdpRoles[roleKey].title}`);
  };

  // Line Group Filter Change
  const handleLineGroupFilter = (groupKey) => {
    setActiveLineGroup(groupKey);
    const groupNames = {
      all: 'Tất cả các tuyến line (28 lines)',
      sdp_hub: 'Chỉ các tuyến kết nối SDP Hub (11 lines)',
      crm_retail: 'Nhóm tuyến Bán Hàng & Khách Hàng',
      enterprise: 'Nhóm tuyến Quản Trị & Vận Hành Doanh Nghiệp',
      ai_bi: 'Nhóm tuyến Trí Tuệ AI & Phân Tích BI'
    };
    showToast(`Đã lọc: ${groupNames[groupKey]}`);
  };

  // Dragging logic
  const handlePointerDown = (sysKey, e) => {
    if (e.target.closest('button') || e.target.closest('select') || e.target.closest('a')) return;

    const startX = e.clientX || (e.touches && e.touches[0].clientX);
    const startY = e.clientY || (e.touches && e.touches[0].clientY);
    const initialOffset = offsets[sysKey] || { x: 0, y: 0 };
    let hasMoved = false;

    const onPointerMove = (moveEvent) => {
      const currentX = moveEvent.clientX || (moveEvent.touches && moveEvent.touches[0].clientX);
      const currentY = moveEvent.clientY || (moveEvent.touches && moveEvent.touches[0].clientY);
      const dx = currentX - startX;
      const dy = currentY - startY;

      if (Math.abs(dx) > 3 || Math.abs(dy) > 3) {
        hasMoved = true;
      }

      setOffsets((prev) => ({
        ...prev,
        [sysKey]: {
          x: initialOffset.x + dx,
          y: initialOffset.y + dy
        }
      }));
    };

    const onPointerUp = () => {
      window.removeEventListener('pointermove', onPointerMove);
      window.removeEventListener('pointerup', onPointerUp);

      if (!hasMoved) {
        setSelectedSystem(sysKey);
      }
    };

    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', onPointerUp);
  };

  // Recalculate connection lines
  const recalculateLines = () => {
    if (!boardRef.current) return;
    const boardRect = boardRef.current.getBoundingClientRect();
    const sdpEl = nodeRefs.current['SDP'];
    if (!sdpEl) return;

    const sdpRect = sdpEl.getBoundingClientRect();
    const allowedNodes = sdpRoles[currentRole] ? sdpRoles[currentRole].accessibleNodes : [];

    const sdpLeft = sdpRect.left - boardRect.left;
    const sdpRight = sdpRect.right - boardRect.left;
    const sdpTop = sdpRect.top - boardRect.top;
    const sdpBottom = sdpRect.bottom - boardRect.top;
    const sdpWidth = sdpRect.width;
    const sdpHeight = sdpRect.height;
    const sdpCenterX = sdpLeft + sdpWidth / 2;
    const sdpCenterY = sdpTop + sdpHeight / 2;

    const makeOrthogonalBusPath = (x1, y1, x2, y2, channelX, radius = 5) => {
      if (Math.abs(x1 - x2) < 2 || Math.abs(y1 - y2) < 2) {
        return `M ${x1} ${y1} L ${x2} ${y2}`;
      }
      const r = Math.max(1, Math.min(radius, Math.abs(channelX - x1) / 2, Math.abs(x2 - channelX) / 2, Math.abs(y2 - y1) / 2));
      const dirY = y2 >= y1 ? 1 : -1;
      const dirX1 = channelX >= x1 ? 1 : -1;
      const dirX2 = x2 >= channelX ? 1 : -1;

      return [
        `M ${x1} ${y1}`,
        `L ${channelX - dirX1 * r} ${y1}`,
        `Q ${channelX} ${y1} ${channelX} ${y1 + dirY * r}`,
        `L ${channelX} ${y2 - dirY * r}`,
        `Q ${channelX} ${y2} ${channelX + dirX2 * r} ${y2}`,
        `L ${x2} ${y2}`
      ].join(' ');
    };

    const makeVerticalBusPath = (x1, y1, x2, y2, channelY, radius = 5) => {
      if (Math.abs(x1 - x2) < 2 || Math.abs(y1 - y2) < 2) {
        return `M ${x1} ${y1} L ${x2} ${y2}`;
      }
      const r = Math.max(1, Math.min(radius, Math.abs(channelY - y1) / 2, Math.abs(y2 - channelY) / 2, Math.abs(x2 - x1) / 2));
      const dirX = x2 >= x1 ? 1 : -1;
      const dirY1 = channelY >= y1 ? 1 : -1;
      const dirY2 = y2 >= channelY ? 1 : -1;

      return [
        `M ${x1} ${y1}`,
        `L ${x1} ${channelY - dirY1 * r}`,
        `Q ${x1} ${channelY} ${x1 + dirX * r} ${channelY}`,
        `L ${x2 - dirX * r} ${channelY}`,
        `Q ${x2} ${channelY} ${x2} ${channelY + dirY2 * r}`,
        `L ${x2} ${y2}`
      ].join(' ');
    };

    const makeOuterDetourPath = (x1, y1, x2, y2, corridorX, radius = 5) => {
      const r = Math.max(1, Math.min(radius, Math.abs(corridorX - x1) / 2, Math.abs(x2 - corridorX) / 2, Math.abs(y2 - y1) / 2));
      const dirY = y2 >= y1 ? 1 : -1;
      const dirX1 = corridorX >= x1 ? 1 : -1;
      const dirX2 = x2 >= corridorX ? 1 : -1;

      return [
        `M ${x1} ${y1}`,
        `L ${corridorX - dirX1 * r} ${y1}`,
        `Q ${corridorX} ${y1} ${corridorX} ${y1 + dirY * r}`,
        `L ${corridorX} ${y2 - dirY * r}`,
        `Q ${corridorX} ${y2} ${corridorX + dirX2 * r} ${y2}`,
        `L ${x2} ${y2}`
      ].join(' ');
    };

    // Calculate Hub Lines
    const calculatedHubLines = [];
    if (showHubLines) {
      const allSatelliteNodes = [
        { code: 'CRM', category: 'core_crm', group: 'crm_retail', label: '360° Profile' },
        { code: 'CSC', category: 'core_crm', group: 'crm_retail', label: 'Omni Tickets' },
        { code: 'CLP', category: 'core_crm', group: 'crm_retail', label: 'Loyalty & Points' },
        { code: 'POS', category: 'core_crm', group: 'crm_retail', label: 'POS In-store' },
        { code: 'ERP', category: 'enterprise', group: 'enterprise', label: 'ERP Ledger' },
        { code: 'HRM', category: 'enterprise', group: 'enterprise', label: 'HR Identity' },
        { code: 'BPM', category: 'enterprise', group: 'enterprise', label: 'BPM Approvals' },
        { code: 'OKR', category: 'enterprise', group: 'enterprise', label: 'OKR Metrics' },
        { code: 'AI',  category: 'intelligence', group: 'ai_bi', label: 'AI Copilot' },
        { code: 'LMS', category: 'intelligence', group: 'ai_bi', label: 'LMS Training' },
        { code: 'BI',  category: 'intelligence', group: 'ai_bi', label: 'BI Telemetry' }
      ];

      const positionGroups = { left: [], right: [], top: [], bottom: [] };

      allSatelliteNodes.forEach(item => {
        const el = nodeRefs.current[item.code];
        if (!el) return;
        const r = el.getBoundingClientRect();
        const nodeCenterX = r.left + r.width / 2 - boardRect.left;
        const nodeCenterY = r.top + r.height / 2 - boardRect.top;

        const dx = nodeCenterX - sdpCenterX;
        const dy = nodeCenterY - sdpCenterY;

        if (Math.abs(dx) >= Math.abs(dy) * 0.9) {
          if (dx < 0) {
            positionGroups.left.push({ ...item, r, nodeCenterX, nodeCenterY });
          } else {
            positionGroups.right.push({ ...item, r, nodeCenterX, nodeCenterY });
          }
        } else {
          if (dy < 0) {
            positionGroups.top.push({ ...item, r, nodeCenterX, nodeCenterY });
          } else {
            positionGroups.bottom.push({ ...item, r, nodeCenterX, nodeCenterY });
          }
        }
      });

      // Left Column
      positionGroups.left.sort((a, b) => a.nodeCenterY - b.nodeCenterY);
      const leftCount = positionGroups.left.length;
      positionGroups.left.forEach((item, index) => {
        const isCatMatch = activeFilter === 'all' || activeFilter === item.category;
        const isRolePermitted = allowedNodes.includes(item.code);
        const isGroupMatch = activeLineGroup === 'all' || activeLineGroup === 'sdp_hub' || activeLineGroup === item.group;
        const isHighlighted = isCatMatch && isRolePermitted && isGroupMatch;

        if (!isGroupMatch && activeLineGroup !== 'all' && activeLineGroup !== 'sdp_hub') return;

        const targetPoint = {
          x: item.r.right - boardRect.left,
          y: item.r.top + item.r.height / 2 - boardRect.top
        };
        const sdpPortY = sdpTop + (sdpHeight * (index + 1)) / (leftCount + 1);
        const sdpPortPoint = { x: sdpLeft, y: sdpPortY };
        const gutterWidth = Math.max(20, sdpLeft - targetPoint.x);
        const channelX = targetPoint.x + (gutterWidth * (index + 1)) / (leftCount + 1.2);
        const pathData = makeOrthogonalBusPath(sdpPortPoint.x, sdpPortPoint.y, targetPoint.x, targetPoint.y, channelX, 6);

        calculatedHubLines.push({
          id: `hub-${item.code}`,
          pathData,
          p1: sdpPortPoint,
          p2: targetPoint,
          label: item.label,
          labelX: channelX,
          labelY: (sdpPortPoint.y + targetPoint.y) / 2,
          isHighlighted
        });
      });

      // Right Column
      positionGroups.right.sort((a, b) => a.nodeCenterY - b.nodeCenterY);
      const rightCount = positionGroups.right.length;
      positionGroups.right.forEach((item, index) => {
        const isCatMatch = activeFilter === 'all' || activeFilter === item.category;
        const isRolePermitted = allowedNodes.includes(item.code);
        const isGroupMatch = activeLineGroup === 'all' || activeLineGroup === 'sdp_hub' || activeLineGroup === item.group;
        const isHighlighted = isCatMatch && isRolePermitted && isGroupMatch;

        if (!isGroupMatch && activeLineGroup !== 'all' && activeLineGroup !== 'sdp_hub') return;

        const targetPoint = {
          x: item.r.left - boardRect.left,
          y: item.r.top + item.r.height / 2 - boardRect.top
        };
        const sdpPortY = sdpTop + (sdpHeight * (index + 1)) / (rightCount + 1);
        const sdpPortPoint = { x: sdpRight, y: sdpPortY };
        const gutterWidth = Math.max(20, targetPoint.x - sdpRight);
        const channelX = sdpRight + (gutterWidth * (rightCount - index)) / (rightCount + 1.2);
        const pathData = makeOrthogonalBusPath(sdpPortPoint.x, sdpPortPoint.y, targetPoint.x, targetPoint.y, channelX, 6);

        calculatedHubLines.push({
          id: `hub-${item.code}`,
          pathData,
          p1: sdpPortPoint,
          p2: targetPoint,
          label: item.label,
          labelX: channelX,
          labelY: (sdpPortPoint.y + targetPoint.y) / 2,
          isHighlighted
        });
      });

      // Top Column
      positionGroups.top.sort((a, b) => a.nodeCenterX - b.nodeCenterX);
      const topCount = positionGroups.top.length;
      positionGroups.top.forEach((item, index) => {
        const isCatMatch = activeFilter === 'all' || activeFilter === item.category;
        const isRolePermitted = allowedNodes.includes(item.code);
        const isGroupMatch = activeLineGroup === 'all' || activeLineGroup === 'sdp_hub' || activeLineGroup === item.group;
        const isHighlighted = isCatMatch && isRolePermitted && isGroupMatch;

        if (!isGroupMatch && activeLineGroup !== 'all' && activeLineGroup !== 'sdp_hub') return;

        const targetPoint = {
          x: item.r.left + item.r.width / 2 - boardRect.left,
          y: item.r.bottom - boardRect.top
        };
        const sdpPortX = sdpLeft + (sdpWidth * (index + 1)) / (topCount + 1);
        const sdpPortPoint = { x: sdpPortX, y: sdpTop };
        const channelY = sdpPortPoint.y - Math.max(12, (sdpPortPoint.y - targetPoint.y) * 0.5);
        const pathData = makeVerticalBusPath(sdpPortPoint.x, sdpPortPoint.y, targetPoint.x, targetPoint.y, channelY, 6);

        calculatedHubLines.push({
          id: `hub-${item.code}`,
          pathData,
          p1: sdpPortPoint,
          p2: targetPoint,
          label: item.label,
          labelX: (targetPoint.x + sdpPortPoint.x) / 2,
          labelY: channelY,
          isHighlighted
        });
      });

      // Bottom Column
      positionGroups.bottom.sort((a, b) => a.nodeCenterX - b.nodeCenterX);
      const bottomCount = positionGroups.bottom.length;
      positionGroups.bottom.forEach((item, index) => {
        const isCatMatch = activeFilter === 'all' || activeFilter === item.category;
        const isRolePermitted = allowedNodes.includes(item.code);
        const isGroupMatch = activeLineGroup === 'all' || activeLineGroup === 'sdp_hub' || activeLineGroup === item.group;
        const isHighlighted = isCatMatch && isRolePermitted && isGroupMatch;

        if (!isGroupMatch && activeLineGroup !== 'all' && activeLineGroup !== 'sdp_hub') return;

        const targetPoint = {
          x: item.r.left + item.r.width / 2 - boardRect.left,
          y: item.r.top - boardRect.top
        };
        const sdpPortX = sdpLeft + (sdpWidth * (index + 1)) / (bottomCount + 1);
        const sdpPortPoint = { x: sdpPortX, y: sdpBottom };
        const channelY = sdpPortPoint.y + Math.max(12, (targetPoint.y - sdpPortPoint.y) * 0.5);
        const pathData = makeVerticalBusPath(sdpPortPoint.x, sdpPortPoint.y, targetPoint.x, targetPoint.y, channelY, 6);

        calculatedHubLines.push({
          id: `hub-${item.code}`,
          pathData,
          p1: sdpPortPoint,
          p2: targetPoint,
          label: item.label,
          labelX: (targetPoint.x + sdpPortPoint.x) / 2,
          labelY: channelY,
          isHighlighted
        });
      });
    }

    // Inter-System Data Lines
    const calculatedInterLines = [];
    if (showInterSystemLines && activeLineGroup !== 'sdp_hub') {
      const directInterLinks = [
        { from: 'CRM', to: 'CSC', color: '#0284c7', offsetIdx: 1, side: 'left', group: 'crm_retail', label: 'Ticket 360°' },
        { from: 'CRM', to: 'CLP', color: '#d97706', offsetIdx: 2, side: 'left', group: 'crm_retail', label: 'Tier & Points' },
        { from: 'CRM', to: 'POS', color: '#059669', offsetIdx: 3, side: 'left', group: 'crm_retail', label: 'In-Store Trans' },
        { from: 'CSC', to: 'CLP', color: '#4f46e5', offsetIdx: 4, side: 'left', group: 'crm_retail', label: 'Gift & Point' },
        { from: 'CLP', to: 'POS', color: '#b45309', offsetIdx: 5, side: 'left', group: 'crm_retail', label: 'Voucher POS' },
        { from: 'ERP', to: 'HRM', color: '#db2777', offsetIdx: 1, side: 'right', group: 'enterprise', label: 'Payroll Ledger' },
        { from: 'BPM', to: 'ERP', color: '#7c3aed', offsetIdx: 2, side: 'right', group: 'enterprise', label: 'Auto Voucher' },
        { from: 'BPM', to: 'HRM', color: '#4f46e5', offsetIdx: 3, side: 'right', group: 'enterprise', label: 'HR Approval' },
        { from: 'HRM', to: 'OKR', color: '#ea580c', offsetIdx: 4, side: 'right', group: 'enterprise', label: 'Perf Review' },
        { from: 'AI',  to: 'LMS', color: '#7c3aed', offsetIdx: 1, isTopDirect: true, group: 'ai_bi', label: 'SOP Docs' },
        { from: 'CSC', to: 'AI',  color: '#8b5cf6', isTopCauseway: true, offsetIdx: 1, group: 'ai_bi', label: 'Voice AI Copilot' },
        { from: 'CRM', to: 'ERP', color: '#0284c7', isTopCauseway: true, offsetIdx: 2, group: 'crm_retail', label: 'B2B Debt & Invoice' },
        { from: 'POS', to: 'ERP', color: '#059669', isBottomCauseway: true, offsetIdx: 1, group: 'crm_retail', label: 'Sync Stock & Ledger' },
        { from: 'OKR', to: 'BI',  color: '#ea580c', offsetIdx: 1, isRightToBottom: true, group: 'ai_bi', label: 'KPI Target' },
        { from: 'CRM', to: 'BI',  color: '#06b6d4', offsetIdx: 1, isLeftToBottom: true, group: 'ai_bi', label: 'Funnel & Churn' },
        { from: 'AI',  to: 'BI',  color: '#8b5cf6', offsetIdx: 2, isTopToBottom: true, group: 'ai_bi', label: 'Predictive BI' }
      ];

      directInterLinks.forEach((link, idx) => {
        const fromEl = nodeRefs.current[link.from];
        const toEl = nodeRefs.current[link.to];
        if (!fromEl || !toEl) return;

        if (activeLineGroup !== 'all' && link.group !== activeLineGroup) return;

        const isRolePermitted = allowedNodes.includes(link.from) && allowedNodes.includes(link.to);
        const isFilterPermitted = activeFilter === 'all';
        const isVisible = isRolePermitted && isFilterPermitted;

        const fromR = fromEl.getBoundingClientRect();
        const toR = toEl.getBoundingClientRect();
        let pathData = '';
        let labelX = 0, labelY = 0;

        if (link.isTopDirect) {
          const p1 = { x: fromR.right - boardRect.left, y: fromR.top + fromR.height / 2 - boardRect.top };
          const p2 = { x: toR.left - boardRect.left, y: toR.top + toR.height / 2 - boardRect.top };
          pathData = `M ${p1.x} ${p1.y} L ${p2.x} ${p2.y}`;
          labelX = (p1.x + p2.x) / 2;
          labelY = p1.y - 7;
        } else if (link.isTopCauseway) {
          const p1 = { x: fromR.left + fromR.width / 2 - boardRect.left, y: fromR.top - boardRect.top };
          const p2 = { x: toR.left + toR.width / 2 - boardRect.left, y: toR.top - boardRect.top };
          const topY = Math.max(4, 5 + (link.offsetIdx || 1) * 7);

          pathData = [
            `M ${p1.x} ${p1.y}`,
            `L ${p1.x} ${topY + 3}`,
            `Q ${p1.x} ${topY} ${p1.x + 3 * (p2.x > p1.x ? 1 : -1)} ${topY}`,
            `L ${p2.x - 3 * (p2.x > p1.x ? 1 : -1)} ${topY}`,
            `Q ${p2.x} ${topY} ${p2.x} ${topY + 3}`,
            `L ${p2.x} ${p2.y}`
          ].join(' ');

          labelX = (p1.x + p2.x) / 2;
          labelY = topY;
        } else if (link.isBottomCauseway) {
          const p1 = { x: fromR.left + fromR.width / 2 - boardRect.left, y: fromR.bottom - boardRect.top };
          const p2 = { x: toR.left + toR.width / 2 - boardRect.left, y: toR.bottom - boardRect.top };
          const bottomY = Math.min(boardRect.height - 4, boardRect.height - (5 + (link.offsetIdx || 1) * 7));

          pathData = [
            `M ${p1.x} ${p1.y}`,
            `L ${p1.x} ${bottomY - 3}`,
            `Q ${p1.x} ${bottomY} ${p1.x + 3 * (p2.x > p1.x ? 1 : -1)} ${bottomY}`,
            `L ${p2.x - 3 * (p2.x > p1.x ? 1 : -1)} ${bottomY}`,
            `Q ${p2.x} ${bottomY} ${p2.x} ${bottomY - 3}`,
            `L ${p2.x} ${p2.y}`
          ].join(' ');

          labelX = (p1.x + p2.x) / 2;
          labelY = bottomY;
        } else if (link.isRightToBottom) {
          const p1 = { x: fromR.left - boardRect.left, y: fromR.bottom - boardRect.top };
          const p2 = { x: toR.right - boardRect.left, y: toR.top + toR.height / 2 - boardRect.top };
          pathData = makeVerticalBusPath(p1.x, p1.y, p2.x, p2.y, p2.y, 5);
          labelX = (p1.x + p2.x) / 2;
          labelY = p2.y;
        } else if (link.isLeftToBottom) {
          const p1 = { x: fromR.right - boardRect.left, y: fromR.bottom - boardRect.top };
          const p2 = { x: toR.left - boardRect.left, y: toR.top + toR.height / 2 - boardRect.top };
          pathData = makeVerticalBusPath(p1.x, p1.y, p2.x, p2.y, p2.y, 5);
          labelX = (p1.x + p2.x) / 2;
          labelY = p2.y;
        } else if (link.isTopToBottom) {
          const p1 = { x: fromR.left + 20 - boardRect.left, y: fromR.bottom - boardRect.top };
          const p2 = { x: toR.left + 20 - boardRect.left, y: toR.top - boardRect.top };
          const corridorX = Math.min(fromR.left, toR.left) - boardRect.left - (8 + (link.offsetIdx || 1) * 6);
          pathData = makeOuterDetourPath(p1.x, p1.y, p2.x, p2.y, corridorX, 5);
          labelX = corridorX;
          labelY = (p1.y + p2.y) / 2;
        } else if (link.side === 'left') {
          const corridorX = Math.max(5, Math.min(fromR.left, toR.left) - boardRect.left - (6 + (link.offsetIdx % 6) * 6));
          const p1 = { x: fromR.left - boardRect.left, y: fromR.top + fromR.height * 0.45 - boardRect.top };
          const p2 = { x: toR.left - boardRect.left, y: toR.top + toR.height * 0.45 - boardRect.top };
          pathData = makeOuterDetourPath(p1.x, p1.y, p2.x, p2.y, corridorX, 5);
          labelX = corridorX;
          labelY = (p1.y + p2.y) / 2;
        } else {
          const corridorX = Math.min(boardRect.width - 5, Math.max(fromR.right, toR.right) - boardRect.left + (6 + (link.offsetIdx % 6) * 6));
          const p1 = { x: fromR.right - boardRect.left, y: fromR.top + fromR.height * 0.45 - boardRect.top };
          const p2 = { x: toR.right - boardRect.left, y: toR.top + toR.height * 0.45 - boardRect.top };
          pathData = makeOuterDetourPath(p1.x, p1.y, p2.x, p2.y, corridorX, 5);
          labelX = corridorX;
          labelY = (p1.y + p2.y) / 2;
        }

        const approxWidth = link.label ? link.label.length * 5.2 + 8 : 0;
        let finalLabelX = labelX;
        if (link.side === 'left') {
          finalLabelX = labelX + approxWidth / 2 + 2;
        } else if (link.side === 'right') {
          finalLabelX = labelX - approxWidth / 2 - 2;
        }

        calculatedInterLines.push({
          id: `inter-${idx}`,
          pathData,
          color: link.color,
          label: link.label,
          labelX: finalLabelX,
          labelY,
          isVisible
        });
      });
    }

    setLines({ hub: calculatedHubLines, inter: calculatedInterLines });
  };

  useEffect(() => {
    recalculateLines();
    const handleResize = () => recalculateLines();
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, [showHubLines, showInterSystemLines, activeFilter, activeLineGroup, currentRole, offsets]);

  // Check element visibility based on filters & roles
  const getNodeOpacity = (sysKey) => {
    if (sysKey === 'SDP') return 1;

    // Check Role
    const allowed = sdpRoles[currentRole]?.accessibleNodes.includes(sysKey);
    // Check Category Filter
    const sysData = systemsData[sysKey];
    const catMatch = activeFilter === 'all' || sysData?.category === activeFilter;

    // Check Line Group Filter
    const groupNodeMap = {
      all: ['SDP', 'CRM', 'CSC', 'CLP', 'POS', 'ERP', 'HRM', 'BPM', 'OKR', 'LMS', 'AI', 'BI'],
      sdp_hub: ['SDP', 'CRM', 'CSC', 'CLP', 'POS', 'ERP', 'HRM', 'BPM', 'OKR', 'LMS', 'AI', 'BI'],
      crm_retail: ['SDP', 'CRM', 'CSC', 'CLP', 'POS', 'ERP'],
      enterprise: ['SDP', 'ERP', 'HRM', 'BPM', 'OKR', 'LMS'],
      ai_bi: ['SDP', 'AI', 'LMS', 'CSC', 'BI', 'OKR', 'CRM']
    };
    const groupMatch = groupNodeMap[activeLineGroup]?.includes(sysKey);

    if (!allowed || !catMatch || !groupMatch) {
      return 0.3;
    }
    return 1;
  };

  const currentSysModalData = selectedSystem ? systemsData[selectedSystem] : null;

  return (
    <div className="bg-gradient-to-br from-slate-200/80 via-sky-100/60 to-indigo-100/70 text-slate-900 h-screen w-screen overflow-hidden flex items-center justify-center p-2 sm:p-3 antialiased selection:bg-blue-600 selection:text-white font-sans">
      
      {/* SVG Animation keyframes */}
      <style>{`
        @keyframes dashStream {
          to { stroke-dashoffset: -24; }
        }
        .flow-stream {
          stroke-dasharray: 7, 5;
          animation: dashStream 1.5s linear infinite;
        }
        .inter-sys-stream {
          stroke-dasharray: 5, 4;
          animation: dashStream 2s linear infinite;
        }
        .glass-flat {
          background: rgba(255, 255, 255, 0.92);
          backdrop-filter: blur(18px);
          -webkit-backdrop-filter: blur(18px);
          border: 1.5px solid rgba(203, 213, 225, 0.95);
          box-shadow: 0 10px 35px -4px rgba(71, 85, 105, 0.18), inset 0 1px 2px rgba(255, 255, 255, 0.98);
          border-radius: 14px;
        }
        .glass-flat-hover {
          transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glass-flat-hover:hover {
          transform: translateY(-2px);
          box-shadow: 0 14px 30px -4px rgba(30, 41, 59, 0.22), inset 0 1px 2px rgba(255, 255, 255, 1);
        }
        .draggable-card {
          user-select: none;
          touch-action: none;
          width: fit-content;
          max-width: 100%;
          min-width: 155px;
          cursor: grab;
          border-radius: 14px !important;
        }
        .draggable-card:active {
          cursor: grabbing;
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Multi-color Theme Gradients */
        .theme-sdp { background: linear-gradient(135deg, rgba(239, 246, 255, 0.98) 0%, rgba(219, 234, 254, 0.95) 50%, rgba(191, 219, 254, 0.9) 100%); border: 2px solid #3b82f6; box-shadow: 0 6px 20px -2px rgba(37, 99, 235, 0.28); }
        .theme-crm { background: linear-gradient(135deg, rgba(236, 254, 255, 0.98) 0%, rgba(207, 250, 254, 0.94) 100%); border: 2px solid #06b6d4; box-shadow: 0 5px 16px -2px rgba(6, 182, 212, 0.25); }
        .theme-csc { background: linear-gradient(135deg, rgba(238, 242, 255, 0.98) 0%, rgba(224, 231, 255, 0.94) 100%); border: 2px solid #6366f1; box-shadow: 0 5px 16px -2px rgba(99, 102, 241, 0.25); }
        .theme-clp { background: linear-gradient(135deg, rgba(254, 252, 232, 0.98) 0%, rgba(254, 240, 138, 0.92) 100%); border: 2px solid #eab308; box-shadow: 0 5px 16px -2px rgba(234, 179, 8, 0.28); }
        .theme-pos { background: linear-gradient(135deg, rgba(236, 253, 245, 0.98) 0%, rgba(167, 243, 208, 0.92) 100%); border: 2px solid #10b981; box-shadow: 0 5px 16px -2px rgba(16, 185, 129, 0.25); }
        .theme-erp { background: linear-gradient(135deg, rgba(250, 245, 255, 0.98) 0%, rgba(233, 213, 255, 0.94) 100%); border: 2px solid #a855f7; box-shadow: 0 5px 16px -2px rgba(168, 85, 247, 0.25); }
        .theme-hrm { background: linear-gradient(135deg, rgba(253, 242, 248, 0.98) 0%, rgba(251, 207, 232, 0.94) 100%); border: 2px solid #ec4899; box-shadow: 0 5px 16px -2px rgba(236, 72, 153, 0.25); }
        .theme-bpm { background: linear-gradient(135deg, rgba(240, 245, 255, 0.98) 0%, rgba(199, 210, 254, 0.94) 100%); border: 2px solid #6366f1; box-shadow: 0 5px 16px -2px rgba(99, 102, 241, 0.25); }
        .theme-okr { background: linear-gradient(135deg, rgba(255, 247, 237, 0.98) 0%, rgba(254, 215, 170, 0.94) 100%); border: 2px solid #f97316; box-shadow: 0 5px 16px -2px rgba(249, 115, 22, 0.25); }
        .theme-lms { background: linear-gradient(135deg, rgba(240, 253, 250, 0.98) 0%, rgba(153, 246, 228, 0.92) 100%); border: 2px solid #14b8a6; box-shadow: 0 5px 16px -2px rgba(20, 184, 166, 0.25); }
        .theme-ai  { background: linear-gradient(135deg, rgba(245, 243, 255, 0.98) 0%, rgba(221, 214, 254, 0.95) 100%); border: 2px solid #8b5cf6; box-shadow: 0 5px 16px -2px rgba(139, 92, 246, 0.28); }
